# EDICAI deployment secrets and settings.
# Copy to .env and fill in real values. NEVER commit .env to git.

# --- Database (used by both odoo and postgres services) ---
EDICAI_DB_USER=odoo
# Generate one: openssl rand -base64 24
EDICAI_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
EDICAI_DB_NAME=edicai
POSTGRES_DB=postgres

# --- HTTPS reverse proxy (only needed with --profile proxy) ---
# The domain you pointed at this server (A record -> server IP).
DOMAIN=edicai.example.com
# Email for Let's Encrypt expiry notices (optional).
ACME_EMAIL=

# --- Port binding for the odoo web service ---
# Leave 127.0.0.1 when the Caddy proxy profile is enabled (odoo not exposed publicly).
# Set to 0.0.0.0 only if you expose Odoo directly (no TLS then!).
HTTP_BIND=127.0.0.1
# Host-side port. Change if 8069 is already in use on this machine.
HTTP_PORT=8069
HTTP_PORT_LONGPOLLING=8072
