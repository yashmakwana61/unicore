<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Phase 0 — Security Foundation: manager-only inspectable list of
         the durable AI audit trail.  Deleted/conversation content is
         never shown here by design (the audit model stores none).     -->
    <record id="edicai_ai_audit_event_tree" model="ir.ui.view">
        <field name="name">edicai.ai.audit.event.tree</field>
        <field name="model">edicai.ai.audit.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="event_type"/>
                <field name="decision"/>
                <field name="reason_code"/>
                <field name="tool_name"/>
                <field name="user_id"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="edicai_ai_audit_event_form" model="ir.ui.view">
        <field name="name">edicai.ai.audit.event.form</field>
        <field name="model">edicai.ai.audit.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="event_type"/>
                            <field name="decision"/>
                            <field name="reason_code"/>
                            <field name="tool_name"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="conversation_id"/>
                            <field name="company_id"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detail" name="detail">
                            <field name="detail" readonly="1"/>
                            <field name="metadata_json" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_edicai_ai_audit_events" model="ir.actions.act_window">
        <field name="name">AI Audit Log</field>
        <field name="res_model">edicai.ai.audit.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_edicai_ai_audit"
        name="AI Audit Log"
        parent="menu_edicai_ai_config"
        action="action_edicai_ai_audit_events"
        sequence="20"
        groups="edicai_ai.group_edicai_ai_manager"
    />
</odoo>
