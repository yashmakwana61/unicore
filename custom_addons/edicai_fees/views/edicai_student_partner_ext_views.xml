<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Extend Student Form to show Partner Link -->
        <record id="edicai_student_form_partner_ext" model="ir.ui.view">
            <field name="name">edicai.student.form.partner.ext</field>
            <field name="model">edicai.student</field>
            <field name="inherit_id" ref="edicai_student.edicai_student_form_view"/>
            <field name="arch" type="xml">
                <!-- Add partner_id in the contact section -->
                <xpath expr="//field[@name='email']" position="after">
                    <field name="partner_id" readonly="1" groups="edicai_base.group_edicai_admin,edicai_base.group_edicai_finance" />
                </xpath>
            </field>
        </record>

    </data>
</odoo>
