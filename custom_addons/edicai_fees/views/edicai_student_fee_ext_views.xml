<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_edicai_student_fee_ext" model="ir.ui.view">
        <field name="name">edicai.student.fee.ext</field>
        <field name="model">edicai.student</field>
        <field name="inherit_id" ref="edicai_student.edicai_student_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_fee_invoices" class="oe_stat_button" icon="fa-credit-card" groups="edicai_base.group_edicai_finance">
                    <field name="fee_invoice_count" widget="statinfo" string="Fee Invoices"/>
                </button>
                <button type="object" name="action_view_fee_invoices" class="oe_stat_button" icon="fa-exclamation-triangle" invisible="not has_fee_dues" groups="edicai_base.group_edicai_finance">
                    <field name="total_fees_due" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <span class="o_stat_text">Outstanding</span>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_edicai_student_kanban_fee_ext" model="ir.ui.view">
        <field name="name">edicai.student.kanban.fee.ext</field>
        <field name="model">edicai.student</field>
        <field name="inherit_id" ref="edicai_student.edicai_student_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="total_fees_due"/>
                <field name="has_fee_dues"/>
                <field name="currency_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_edicai_student_list_fee_ext" model="ir.ui.view">
        <field name="name">edicai.student.tree.fee.ext</field>
        <field name="model">edicai.student</field>
        <field name="inherit_id" ref="edicai_student.edicai_student_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">has_fee_dues == True</attribute>
            </xpath>
            <xpath expr="//field[@name='cgpa']" position="after">
                <field name="total_fees_due" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                <field name="has_fee_dues" column_invisible="True"/>
            </xpath>
        </field>
    </record>

    <record id="view_edicai_student_search_fee_ext" model="ir.ui.view">
        <field name="name">edicai.student.search.fee.ext</field>
        <field name="model">edicai.student</field>
        <field name="inherit_id" ref="edicai_student.edicai_student_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_international']" position="after">
                <filter name="filter_fee_defaulters" string="Fee Defaulters" domain="[('has_fee_dues', '=', True)]"/>
            </xpath>
        </field>
    </record>

</odoo>
