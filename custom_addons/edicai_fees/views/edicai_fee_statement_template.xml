<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="fee_statement_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="invoice">
                <t t-call="web.external_layout">
                    <t t-set="student" t-value="invoice.student_id"/>

                    <div class="stmt-container">
                        <div class="stmt-title">
                            STUDENT FEE STATEMENT
                        </div>

                        <table class="stmt-header-table">
                            <tr>
                                <td class="label-cell">Invoice No.</td>
                                <td class="value-cell" t-esc="invoice.invoice_number"/>
                                <td class="label-cell">Invoice Date</td>
                                <td class="value-cell" t-esc="invoice.invoice_date"/>
                            </tr>
                            <tr>
                                <td class="label-cell">Status</td>
                                <td class="value-cell">
                                    <t t-esc="dict(invoice._fields['invoice_state']._description_selection(invoice.env)).get(invoice.invoice_state, invoice.invoice_state).upper()"/>
                                </td>
                                <td class="label-cell">Due Date</td>
                                <td class="value-cell" t-esc="invoice.due_date"/>
                            </tr>
                        </table>

                        <table class="stmt-student-table">
                            <tr>
                                <td class="label-cell">Student ID</td>
                                <td class="value-cell" colspan="3" t-esc="student.student_id_number"/>
                            </tr>
                            <tr>
                                <td class="label-cell">Student Name</td>
                                <td class="value-cell" colspan="3" t-esc="student.display_name"/>
                            </tr>
                            <tr>
                                <td class="label-cell">Program</td>
                                <td class="value-cell" colspan="3"
                                    t-esc="(student.program_id.code + ' — ' + student.program_id.name) if student.program_id and student.program_id.code else (student.program_id.name if student.program_id else '')"/>
                            </tr>
                            <tr t-if="invoice.semester_id">
                                <td class="label-cell">Semester</td>
                                <td class="value-cell" colspan="3" t-esc="invoice.semester_id.name"/>
                            </tr>
                            <tr>
                                <td class="label-cell">Academic Year</td>
                                <td class="value-cell" colspan="3" t-esc="invoice.academic_year_id.name"/>
                            </tr>
                        </table>

                        <div class="section-title">FEE DETAILS</div>

                        <table class="stmt-lines-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Description</th>
                                    <th>Type</th>
                                    <th class="amount-cell">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="invoice.line_ids" t-as="line">
                                    <td t-esc="line_index + 1"/>
                                    <td t-esc="line.name"/>
                                    <td t-esc="dict(line._fields['fee_type']._description_selection(line.env)).get(line.fee_type, line.fee_type)"/>
                                    <td class="amount-cell" t-esc="indian_format(line.amount)"/>
                                </tr>
                            </tbody>
                        </table>

                        <table class="stmt-totals-table">
                            <tr>
                                <td class="label-cell">Subtotal</td>
                                <td class="amount-cell" t-esc="indian_format(invoice.subtotal)"/>
                            </tr>
                            <t t-if="invoice.discount_amount">
                                <tr>
                                    <td class="label-cell">Scholarship / Discount <t t-if="invoice.discount_reason">( <t t-esc="invoice.discount_reason"/>)</t></td>
                                    <td class="amount-cell">-<t t-esc="indian_format(invoice.discount_amount)"/></td>
                                </tr>
                            </t>
                            <t t-if="invoice.late_fee_amount">
                                <tr>
                                    <td class="label-cell">Late Fee</td>
                                    <td class="amount-cell" t-esc="indian_format(invoice.late_fee_amount)"/>
                                </tr>
                            </t>
                            <tr class="amount-row total-row">
                                <td class="label-cell">Total Amount</td>
                                <td class="amount-cell" t-esc="indian_format(invoice.total_amount)"/>
                            </tr>
                            <tr class="amount-row paid-row">
                                <td class="label-cell">Amount Paid</td>
                                <td class="amount-cell" t-esc="indian_format(invoice.amount_paid)"/>
                            </tr>
                            <tr class="amount-row balance-row">
                                <td class="label-cell">Balance Due</td>
                                <td class="amount-cell" t-esc="indian_format(invoice.amount_outstanding)"/>
                            </tr>
                        </table>

                        <!-- Payment history (legacy receipts) -->
                        <t t-set="confirmed_pmts"
                           t-value="invoice.payment_ids.filtered(lambda p: p.payment_state == 'confirmed')"/>
                        <t t-if="confirmed_pmts">
                            <div class="section-title">PAYMENT HISTORY</div>
                            <table class="stmt-lines-table">
                                <thead>
                                    <tr>
                                        <th>Receipt No.</th>
                                        <th>Date</th>
                                        <th>Mode</th>
                                        <th class="amount-cell">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="confirmed_pmts" t-as="pmt">
                                        <td t-esc="pmt.receipt_number"/>
                                        <td t-esc="pmt.payment_date"/>
                                        <td t-esc="dict(pmt._fields['payment_method']._description_selection(pmt.env)).get(pmt.payment_method, pmt.payment_method)"/>
                                        <td class="amount-cell" t-esc="indian_format(pmt.amount)"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <div class="signatory-section">
                            <div class="signatory-block">
                                <div class="signatory-line">Authorised Signatory</div>
                                <div class="signatory-line">Accounts Department</div>
                            </div>
                        </div>

                        <div class="disclaimer">
                            This is a computer-generated statement. No signature required.
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="fee_statement_styles">
        <style>
            .stmt-container {
                font-family: Arial, sans-serif;
                font-size: 10pt;
                padding: 10mm;
            }
            .stmt-title {
                text-align: center;
                font-size: 16pt;
                font-weight: bold;
                margin: 6mm 0 5mm 0;
                letter-spacing: 1pt;
                color: #1e3a5f;
                border-bottom: 2pt solid #1e3a5f;
                padding-bottom: 3mm;
            }
            .stmt-header-table,
            .stmt-student-table,
            .stmt-lines-table,
            .stmt-totals-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 4mm;
            }
            .stmt-header-table td,
            .stmt-student-table td {
                padding: 2mm 1mm;
                border-bottom: 0.5pt solid #ddd;
            }
            .label-cell {
                font-weight: bold;
                color: #555;
                width: 32mm;
                vertical-align: top;
            }
            .value-cell { color: #222; }
            .section-title {
                font-size: 12pt;
                font-weight: bold;
                color: #1e3a5f;
                margin: 4mm 0 2mm 0;
                padding: 1mm 0;
                border-bottom: 1pt solid #1e3a5f;
            }
            .stmt-lines-table th {
                background-color: #1e3a5f;
                color: white;
                padding: 2mm 1mm;
                text-align: left;
                font-size: 9pt;
            }
            .stmt-lines-table td {
                padding: 1.5mm 1mm;
                border-bottom: 0.5pt solid #ddd;
            }
            .amount-cell {
                text-align: right;
                width: 40mm;
                font-family: 'Courier New', monospace;
            }
            th.amount-cell { text-align: right; }
            .stmt-totals-table td {
                padding: 1.5mm 1mm;
                border: none;
            }
            .total-row td, .paid-row td, .balance-row td {
                border-top: 0.5pt solid #ccc;
            }
            .total-row .amount-cell { font-weight: bold; }
            .paid-row .amount-cell { color: #1a7a2e; font-weight: bold; }
            .balance-row .amount-cell { color: #c0392b; font-weight: bold; font-size: 11pt; }
            .signatory-section {
                margin: 8mm 0 4mm 0;
                text-align: right;
            }
            .signatory-block { display: inline-block; text-align: center; }
            .signatory-line { margin: 2mm 0; font-size: 10pt; }
            .signatory-line:first-child {
                margin-top: 8mm;
                border-top: 1pt solid #333;
                padding-top: 2mm;
            }
            .disclaimer {
                text-align: center;
                font-size: 8pt;
                color: #999;
                margin-top: 5mm;
                padding-top: 2mm;
                border-top: 0.5pt solid #ddd;
            }
        </style>
    </template>
</odoo>
