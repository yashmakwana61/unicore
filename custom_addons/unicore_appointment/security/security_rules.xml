<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_unicore_appointment_slot_faculty_own" model="ir.rule">
            <field name="name">Appointment Slot: Faculty Own</field>
            <field name="model_id" ref="model_unicore_appointment_slot"/>
            <field name="domain_force">[('faculty_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_faculty'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>
        <record id="rule_unicore_appointment_booking_student_own" model="ir.rule">
            <field name="name">Appointment Booking: Student Own</field>
            <field name="model_id" ref="model_unicore_appointment_booking"/>
            <field name="domain_force">[('student_id.partner_id.user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_student'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>
        <record id="rule_unicore_appointment_booking_faculty_own" model="ir.rule">
            <field name="name">Appointment Booking: Faculty Own Slots</field>
            <field name="model_id" ref="model_unicore_appointment_booking"/>
            <field name="domain_force">[('slot_id.faculty_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_faculty'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
