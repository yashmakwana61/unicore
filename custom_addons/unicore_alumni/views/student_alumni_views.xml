<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_unicore_student_form_alumni_ext"
            model="ir.ui.view">
        <field name="name">unicore.student.form.alumni.ext</field>
        <field name="model">unicore.student</field>
        <field name="inherit_id" ref="unicore_student.unicore_student_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_alumni_mailing_lists"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-envelope"
                        invisible="not alumni_mailing_list_ids">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Mailing Lists</span>
                        <span class="o_stat_value"
                              t-field="alumni_mailing_list_ids"/>
                    </div>
                </button>
                <button name="action_view_alumni_events"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar"
                        invisible="not alumni_event_ids">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Events</span>
                        <span class="o_stat_value"
                              t-field="alumni_registration_count"/>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>