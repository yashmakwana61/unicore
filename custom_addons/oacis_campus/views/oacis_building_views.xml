<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <!-- Window Action -->
  <record id="action_oacis_building" model="ir.actions.act_window">
    <field name="name">Buildings</field>
    <field name="res_model">oacis.building</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>
  <!-- Form View -->
  <record id="oacis_building_form_view" model="ir.ui.view">
    <field name="name">oacis.building.form</field>
    <field name="model">oacis.building</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_open_floors" type="object" class="oe_stat_button" icon="fa-layer-group">
              <field string="Floors" name="floor_count" widget="statinfo"/>
            </button>
          </div>
          <group>
            <group name="left">
              <field name="name"/>
              <field name="code"/>
              <field name="building_type"/>
              <field name="campus_id" options="{'no_create': True}"/>
              <field name="sequence"/>
            </group>
            <group name="right">
              <field name="construction_year"/>
              <field name="total_area_sqft"/>
              <field name="floor_count"/>
              <field name="image" widget="image" class="oe_avatar"/>
            </group>
          </group>
          <notebook>
            <page name="floors" string="Floors">
              <field name="floor_ids">
                <list editable="bottom">
                  <field name="floor_number"/>
                  <field name="name"/>
                  <field name="room_count"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <!-- List View -->
  <record id="oacis_building_list_view" model="ir.ui.view">
    <field name="name">oacis.building.list</field>
    <field name="model">oacis.building</field>
    <field name="arch" type="xml">
      <list>
        <field name="code"/>
        <field name="name"/>
        <field name="building_type"/>
        <field name="campus_id"/>
        <field name="floor_count"/>
        <field name="active"/>
      </list>
    </field>
  </record>
  <!-- Search View -->
  <record id="oacis_building_search_view" model="ir.ui.view">
    <field name="name">oacis.building.search</field>
    <field name="model">oacis.building</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="code"/>
        <field name="campus_id"/>
        <filter name="filter_building_type" string="Building Type" context="{'group_by': 'building_type'}"/>
        <group name="groupby">
          <filter name="groupby_campus" string="Campus" context="{'group_by': 'campus_id'}"/>
          <filter name="groupby_type" string="Building Type" context="{'group_by': 'building_type'}"/>
        </group>
      </search>
    </field>
  </record>
</odoo>
