<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Window Action -->
    <record id="action_oacis_facility" model="ir.actions.act_window">
        <field name="name">Facilities</field>
        <field name="res_model">oacis.facility</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <!-- Form View -->
    <record id="oacis_facility_form_view" model="ir.ui.view">
        <field name="name">oacis.facility.form</field>
        <field name="model">oacis.facility</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group name="left">
                            <field name="name"/>
                            <field name="facility_type"/>
                            <field name="campus_id" options="{'no_create': True}"/>
                        </group>
                        <group name="right">
                            <field name="capacity"/>
                            <field name="operating_hours"/>
                        </group>
                    </group>
                    <group name="location" string="Location">
                        <field name="location_description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="oacis_facility_list_view" model="ir.ui.view">
        <field name="name">oacis.facility.list</field>
        <field name="model">oacis.facility</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="facility_type"/>
                <field name="campus_id"/>
                <field name="capacity"/>
                <field name="operating_hours"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="oacis_facility_search_view" model="ir.ui.view">
        <field name="name">oacis.facility.search</field>
        <field name="model">oacis.facility</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="campus_id"/>
                <filter name="filter_facility_type" string="Facility Type"
                        context="{'group_by': 'facility_type'}"/>
                <group name="groupby">
                    <filter name="groupby_facility_type" string="Facility Type"
                            context="{'group_by': 'facility_type'}"/>
                    <filter name="groupby_campus" string="Campus"
                            context="{'group_by': 'campus_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
