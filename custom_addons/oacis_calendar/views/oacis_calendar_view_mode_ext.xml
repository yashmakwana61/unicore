<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Expose the new kanban/calendar/pivot/graph/activity views through the
         view switcher on the existing actions. -->

    <record id="action_oacis_academic_week" model="ir.actions.act_window">
        <field name="view_mode">list,form,calendar</field>
    </record>

    <record id="action_oacis_academic_year" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar</field>
    </record>

    <record id="action_oacis_holiday" model="ir.actions.act_window">
        <field name="view_mode">list,form,calendar</field>
    </record>

    <record id="action_oacis_semester" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar</field>
    </record>

</odoo>
