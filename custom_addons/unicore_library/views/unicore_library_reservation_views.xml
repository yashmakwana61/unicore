<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_unicore_library_reservation_form"
          model="ir.ui.view">
    <field name="name">unicore.library.reservation.form</field>
    <field name="model">unicore.library.reservation</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_fulfill"
            string="Mark Fulfilled"
            type="object"
            invisible="reservation_state !=
              'ready'"
            class="btn-success"
            groups="unicore_base.group_unicore_staff"/>
          <button name="action_cancel"
            string="Cancel Reservation"
            type="object"
            invisible="reservation_state in
              ('fulfilled','cancelled','expired')"
            groups="unicore_base.group_unicore_staff"/>
          <field name="reservation_state"
            widget="statusbar"
            statusbar_visible="active,ready,
              fulfilled"/>
        </header>
        <sheet>
          <widget name="web_ribbon"
            title="READY"
            invisible="reservation_state != 'ready'"
            bg_color="text-bg-success"/>
          <widget name="web_ribbon"
            title="EXPIRED"
            invisible="not is_expired"
            bg_color="text-bg-secondary"/>
          <group>
            <group string="Reservation Details">
              <field name="reservation_number"
                     readonly="1"/>
              <field name="member_id"/>
              <field name="book_id"/>
              <field name="queue_number"
                     readonly="1"/>
              <field name="reservation_date"
                     readonly="1"/>
              <field name="expiry_date"/>
            </group>
            <group string="Status">
              <field name="reservation_state"/>
              <field name="is_expired" readonly="1"/>
            </group>
          </group>
          <group string="Notes">
            <field name="notes" nolabel="1"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_unicore_library_reservation_list"
          model="ir.ui.view">
    <field name="name">unicore.library.reservation.list</field>
    <field name="model">unicore.library.reservation</field>
    <field name="arch" type="xml">
      <list decoration-success=
              "reservation_state == 'ready'"
            decoration-muted=
              "reservation_state in
              ('fulfilled','cancelled','expired')">
        <field name="reservation_number"/>
        <field name="member_id"/>
        <field name="book_id"/>
        <field name="queue_number"/>
        <field name="reservation_date"/>
        <field name="expiry_date"/>
        <field name="reservation_state"/>
      </list>
    </field>
  </record>

  <record id="action_unicore_library_reservation"
          model="ir.actions.act_window">
    <field name="name">Book Reservations</field>
    <field name="res_model">unicore.library.reservation</field>
    <field name="view_mode">list,form</field>
    <field name="domain">
      [('reservation_state','in',
        ['active','ready'])]
    </field>
  </record>

</odoo>
