        <field name="arch" type="xml">
            <pivot string="Library Book Analysis">
                <field name="publisher_id" type="row"/>
                <field name="issued_copies" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="unicore_library_book_graph_view" model="ir.ui.view">
        <field name="name">unicore.library.book.graph</field>
        <field name="model">unicore.library.book</field>
        <field name="arch" type="xml">
            <graph string="Library Book Analysis" type="bar">
                <field name="publisher_id" type="row"/>
                <field name="issued_copies" type="measure"/>
            </graph>
        </field>
    </record>

    

    <!-- ============================================================
         Library Member Analysis
         ============================================================ -->
    <record id="unicore_library_member_pivot_view" model="ir.ui.view">
        <field name="name">unicore.library.member.pivot</field>
        <field name="model">unicore.library.member</field>
        <field name="arch" type="xml">
            <pivot string="Library Member Analysis">
                <field name="member_type" type="row"/>
                <field name="current_issue_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="unicore_library_member_graph_view" model="ir.ui.view">
        <field name="name">unicore.library.member.graph</field>
        <field name="model">unicore.library.member</field>
        <field name="arch" type="xml">
            <graph string="Library Member Analysis" type="bar">
                <field name="member_type" type="row"/>
                <field name="current_issue_count" type="measure"/>
            </graph>
        </field>
    </record>

    

</odoo>
