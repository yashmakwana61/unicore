<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Library Issue Analysis
         ============================================================ -->
    <record id="unicore_library_issue_pivot_view" model="ir.ui.view">
        <field name="name">unicore.library.issue.pivot</field>
        <field name="model">unicore.library.issue</field>
        <field name="arch" type="xml">
            <pivot string="Library Issue Analysis">
                <field name="issue_state" type="row"/>
                <field name="fine_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="unicore_library_issue_graph_view" model="ir.ui.view">
        <field name="name">unicore.library.issue.graph</field>
        <field name="model">unicore.library.issue</field>
        <field name="arch" type="xml">
            <graph string="Library Issue Analysis" type="bar">
                <field name="issue_state" type="row"/>
                <field name="fine_amount" type="measure"/>
            </graph>
        </field>
    </record>

    

    <!-- ============================================================
         Library Book Analysis
         ============================================================ -->
