<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Configurable admission pipeline stages                        -->
    <!-- ============================================================ -->

    <record id="admission_stage_list_view" model="ir.ui.view">
        <field name="name">unicore.admission.stage.list</field>
        <field name="model">unicore.admission.stage</field>
        <field name="arch" type="xml">
            <list string="Admission Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="fold"/>
                <field name="is_terminal"/>
                <field name="color" widget="color_picker" optional="hide"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="admission_stage_form_view" model="ir.ui.view">
        <field name="name">unicore.admission.stage.form</field>
        <field name="model">unicore.admission.stage</field>
        <field name="arch" type="xml">
            <form string="Admission Stage">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Stage name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="state"/>
                            <field name="is_terminal"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create_edit': True}"/>
                            <field name="fold"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_unicore_admission_stage" model="ir.actions.act_window">
        <field name="name">Admission Stages</field>
        <field name="res_model">unicore.admission.stage</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_company': 1}</field>
        <field name="help" type="html">
            <p>Configure the admission pipeline stages for each institution.
            Reorder, rename, fold, color and mark terminal stages. Each stage
            maps to an internal admission status, so the applicant kanban
            follows your configuration while business logic keeps working on
            the internal status.</p>
        </field>
    </record>

</odoo>
