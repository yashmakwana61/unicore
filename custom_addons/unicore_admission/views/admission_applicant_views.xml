<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="admission_applicant_form_view" model="ir.ui.view">
        <field name="name">unicore.admission.applicant.form</field>
        <field name="model">unicore.admission.applicant</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="inquiry,applied,under_review,shortlisted,merit_listed,offer_sent,fee_pending,confirmed"
                           clickable="False"/>
                    <button name="action_apply" type="object" string="Apply"
                            invisible="state != 'inquiry'" class="btn-primary"/>
                    <button name="action_submit_documents" type="object" string="Submit Documents"
                            invisible="state != 'applied'" class="btn-primary"/>
                    <button name="action_submit_for_review" type="object" string="Submit for Review"
                            invisible="state != 'documents_pending'" class="btn-primary"/>
                    <button name="action_shortlist" type="object" string="Shortlist"
                            invisible="state != 'under_review'" class="btn-primary"/>
                    <button name="action_schedule_entrance" type="object" string="Schedule Entrance"
                            invisible="state != 'shortlisted'" class="btn-primary"/>
                    <button name="action_add_to_merit" type="object" string="Add to Merit"
                            invisible="state not in ('entrance_scheduled', 'shortlisted')"
                            class="btn-success"/>
                    <button name="action_send_offer" type="object" string="Send Offer"
                            invisible="state != 'merit_listed'" class="btn-success"/>
                    <button name="action_confirm_admission" type="object" string="Confirm Admission"
                            invisible="state != 'fee_pending'" class="btn-primary"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state in ('confirmed', 'rejected', 'withdrawn')"
                            class="btn-danger"/>
                    <button name="action_withdraw" type="object" string="Withdraw"
                            invisible="state in ('confirmed', 'rejected', 'withdrawn')"
                            class="btn-secondary"/>
                    <button name="action_move_to_waitlist" type="object" string="Waitlist"
                            invisible="state not in ('merit_listed', 'offer_sent', 'fee_pending')"
                            class="btn-warning"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_offer_letters" type="object"
                                class="oe_stat_button" icon="fa-file-invoice">
                            <field string="Offer Letters" name="offer_letter_count" widget="statinfo"/>
                        </button>
                        <button name="action_open_student" type="object"
                                class="oe_stat_button" icon="fa-user-graduate"
                                invisible="not student_id">
                            <div class="o_stat_info">
                                <span>View Student</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Full name..."/>
                        </h1>
                        <group>
                            <group>
                                <field name="application_number" readonly="1"/>
                                <field name="cycle_id" options="{'no_create_edit': True}"/>
                                <field name="image_1920" widget="image" class="oe_avatar"/>
                            </group>
                            <group>
                                <field name="campus_id" options="{'no_create_edit': True}"/>
                                <field name="program_id" options="{'no_create_edit': True}"/>
                                <field name="specialisation_id" options="{'no_create_edit': True}"/>
                                <field name="cohort_kind" readonly="1"/>
                                <field name="grade_level_id"
                                       options="{'no_create_edit': True}"
                                       invisible="cohort_kind != 'grade_batch'"
                                       required="cohort_kind == 'grade_batch'"/>
                            </group>
                        </group>
                    </div>
                    <notebook>
                        <page name="personal" string="Personal">
                            <group>
                                <group>
                                    <field name="name"/>
                                    <field name="middle_name"/>
                                    <field name="last_name"/>
                                    <field name="gender"/>
                                    <field name="date_of_birth"/>
                                    <field name="nationality_id" options="{'no_create_edit': True}"/>
                                </group>
                                <group>
                                    <field name="email"/>
                                    <field name="mobile"/>
                                    <field name="phone"/>
                                </group>
                            </group>
                        </page>
                        <page name="scores" string="Scores">
                            <group>
                                <group>
                                    <field name="aggregate_percentage"/>
                                    <field name="entrance_score"/>
                                    <field name="interview_score"/>
                                </group>
                                <group>
                                    <field name="composite_score" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page name="documents" string="Documents">
                            <group>
                                <field name="documents_submitted"/>
                                <field name="documents_verified"/>
                            </group>
                        </page>
                        <page name="guardian" string="Guardian">
                            <group>
                                <group>
                                    <field name="guardian_name"/>
                                    <field name="guardian_relation"/>
                                </group>
                                <group>
                                    <field name="guardian_mobile"/>
                                    <field name="guardian_email"/>
                                </group>
                            </group>
                        </page>
                        <page name="offer_letters" string="Offer Letters">
                            <field name="offer_letter_ids" context="{'list_view_ref': 'unicore_admission.offer_letter_list_view'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="admission_applicant_list_view" model="ir.ui.view">
        <field name="name">unicore.admission.applicant.list</field>
        <field name="model">unicore.admission.applicant</field>
        <field name="arch" type="xml">
            <list>
                <field name="application_number"/>
                <field name="name"/>
                <field name="cycle_id"/>
                <field name="program_id"/>
                <field name="composite_score" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state in ('rejected', 'withdrawn')"
                       decoration-warning="state == 'waitlisted'"
                       decoration-info="state in ('inquiry', 'applied', 'documents_pending', 'under_review', 'shortlisted', 'entrance_scheduled')"
                       decoration-primary="state in ('merit_listed', 'offer_sent', 'fee_pending')"/>
            </list>
        </field>
    </record>

    <record id="admission_applicant_kanban_view" model="ir.ui.view">
        <field name="name">unicore.admission.applicant.kanban</field>
        <field name="model">unicore.admission.applicant</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" group_order="inquiry,applied,documents_pending,under_review,shortlisted,entrance_scheduled,merit_listed,offer_sent,fee_pending,confirmed,rejected,withdrawn,waitlisted" unfold_all="1">
                <field name="id"/>
                <field name="state"/>
                <field name="name"/>
                <field name="program_id"/>
                <field name="composite_score"/>
                <field name="email"/>
                <field name="gender"/>
                <field name="application_number"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_card_header">
                                <strong>
                                    <t t-esc="record.name.value"/>
                                </strong>
                            </div>
                            <div class="oe_kanban_card_body">
                                <div class="oe_kanban_field_line">
                                    <span>App #:</span>
                                    <t t-esc="record.application_number.value"/>
                                </div>
                                <div class="oe_kanban_field_line">
                                    <span>Program:</span>
                                    <t t-esc="record.program_id.value"/>
                                </div>
                                <div class="oe_kanban_field_line">
                                    <span>Score:</span>
                                    <t t-if="record.composite_score.value != undefined &amp;&amp; record.composite_score.value != null">
                                        <span class="badge badge-info">
                                            <t t-esc="record.composite_score.value"/>
                                        </span>
                                    </t>
                                </div>
                                <div class="oe_kanban_field_line">
                                    <span>Gender:</span>
                                    <t t-esc="record.gender.value"/>
                                </div>
                                <div class="oe_kanban_field_line">
                                    <small>
                                        <t t-esc="record.email.value"/>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="admission_applicant_search_view" model="ir.ui.view">
        <field name="name">unicore.admission.applicant.search</field>
        <field name="model">unicore.admission.applicant</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="application_number"/>
                <field name="email"/>
                <field name="cycle_id"/>
                <field name="program_id"/>
                <field name="campus_id"/>
                <filter name="inquiry" string="Inquiry"
                        domain="[('state', '=', 'inquiry')]"/>
                <filter name="active_applications" string="Active"
                        domain="[('state', 'not in', ('confirmed', 'rejected', 'withdrawn', 'waitlisted'))]"/>
                <filter name="confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="group_by_cycle" string="Cycle"
                        context="{'group_by': 'cycle_id'}"/>
                <filter name="group_by_program" string="Program"
                        context="{'group_by': 'program_id'}"/>
                <filter name="group_by_state" string="Status"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_unicore_admission_applicant" model="ir.actions.act_window">
        <field name="name">Applicants</field>
        <field name="res_model">unicore.admission.applicant</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="admission_applicant_search_view"/>
        <field name="help" type="html">
            <p>Manage admission applicants throughout the 13-stage admission
            workflow from inquiry to confirmed enrollment. Use the Kanban view
            to drag and drop applicants between stages.</p>
        </field>
    </record>

</odoo>
