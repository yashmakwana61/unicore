<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="entrance_test_form_view" model="ir.ui.view">
    <field name="name">unicore.admission.entrance.test.form</field>
    <field name="model">unicore.admission.entrance.test</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,completed,result_published" clickable="False"/>
          <button name="action_schedule" type="object" string="Schedule" invisible="state != 'draft'" class="btn-primary"/>
          <button name="action_start" type="object" string="Start Test" invisible="state != 'scheduled'" class="btn-success"/>
          <button name="action_complete" type="object" string="Complete" invisible="state != 'in_progress'" class="btn-primary"/>
          <button name="action_publish_results" type="object" string="Publish Results" invisible="state != 'completed'" class="btn-success"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" placeholder="Test Name..."/>
            </h1>
          </div>
          <group>
            <group>
              <field name="code"/>
              <field name="cycle_id" options="{'no_create_edit': True}"/>
              <field name="test_date"/>
            </group>
            <group>
              <field name="start_time"/>
              <field name="end_time"/>
              <field name="venue"/>
            </group>
          </group>
          <group>
            <group>
              <field name="max_marks"/>
              <field name="passing_marks"/>
            </group>
            <group>
              <field name="total_applicants" readonly="1"/>
              <field name="attended_count" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page name="applicants" string="Applicants">
              <field name="applicant_line_ids">
                <list editable="bottom">
                  <field name="applicant_id" options="{'no_create_edit': True}"/>
                  <field name="attended"/>
                  <field name="marks_obtained" required="attended"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="entrance_test_list_view" model="ir.ui.view">
    <field name="name">unicore.admission.entrance.test.list</field>
    <field name="model">unicore.admission.entrance.test</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="code"/>
        <field name="cycle_id"/>
        <field name="test_date"/>
        <field name="venue"/>
        <field name="total_applicants"/>
        <field name="attended_count"/>
        <field name="state" widget="badge" decoration-success="state == 'result_published'" decoration-info="state in ('scheduled', 'in_progress')" decoration-muted="state == 'draft'"/>
      </list>
    </field>
  </record>
  <record id="entrance_test_search_view" model="ir.ui.view">
    <field name="name">unicore.admission.entrance.test.search</field>
    <field name="model">unicore.admission.entrance.test</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="code"/>
        <field name="cycle_id"/>
        <field name="venue"/>
        <filter name="upcoming" string="Upcoming" domain="[('state', 'in', ('draft', 'scheduled'))]"/>
        <filter name="completed" string="Completed" domain="[('state', 'in', ('completed', 'result_published'))]"/>
      </search>
    </field>
  </record>
  <record id="action_unicore_admission_entrance_test" model="ir.actions.act_window">
    <field name="name">Entrance Tests</field>
    <field name="res_model">unicore.admission.entrance.test</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="entrance_test_search_view"/>
    <field name="help" type="html">
      <p>Create and manage entrance tests for admission cycles.
            Schedule tests, record attendance and marks, then publish results
            to auto-update applicant statuses.</p>
    </field>
  </record>
</odoo>
