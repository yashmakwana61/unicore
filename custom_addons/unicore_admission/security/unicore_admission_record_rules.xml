<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!-- ADMISSION CYCLE: company isolation -->
    <record id="rule_admission_cycle_company" model="ir.rule">
        <field name="name">unicore.admission.cycle: company isolation</field>
        <field name="model_id" ref="model_unicore_admission_cycle"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

