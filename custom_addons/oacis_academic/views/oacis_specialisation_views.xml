<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Window Action -->
    <record id="action_oacis_specialisation" model="ir.actions.act_window">
        <field name="name">Specialisations</field>
        <field name="res_model">oacis.specialisation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <!-- Form View -->
    <record id="oacis_specialisation_form_view" model="ir.ui.view">
        <field name="name">oacis.specialisation.form</field>
        <field name="model">oacis.specialisation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group name="left">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="program_id" options="{'no_create': True}"/>
                            <field name="department_id"/>
                            <field name="faculty_id"/>
                            <field name="sequence"/>
                        </group>
                        <group name="right">
                            <field name="min_credits"/>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group name="description" string="Description">
                        <field name="description"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="oacis_specialisation_list_view" model="ir.ui.view">
        <field name="name">oacis.specialisation.list</field>
        <field name="model">oacis.specialisation</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="program_id"/>
                <field name="department_id"/>
                <field name="min_credits"/>
                <field name="is_default"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="oacis_specialisation_search_view" model="ir.ui.view">
        <field name="name">oacis.specialisation.search</field>
        <field name="model">oacis.specialisation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="program_id"/>
                <filter name="filter_active" string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="filter_default" string="Is Default"
                        domain="[('is_default', '=', True)]"/>
                <group name="groupby">
                    <filter name="groupby_program" string="Program"
                            context="{'group_by': 'program_id'}"/>
                    <filter name="groupby_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
