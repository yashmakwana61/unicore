<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data>
    <record id="view_unicore_thesis_tree" model="ir.ui.view">
      <field name="name">unicore.thesis.tree</field>
      <field name="model">unicore.thesis</field>
      <field name="arch" type="xml">
        <list string="Theses">
          <field name="title"/>
          <field name="student_id" widget="many2one_avatar"/>
          <field name="supervisor_id" widget="many2one_avatar"/>
          <field name="status" widget="badge" decoration-info="status in ('proposal', 'research', 'draft', 'submitted')" decoration-primary="status == 'defended'" decoration-success="status == 'approved'" decoration-danger="status == 'rejected'"/>
        </list>
      </field>
    </record>
    <record id="view_unicore_thesis_form" model="ir.ui.view">
      <field name="name">unicore.thesis.form</field>
      <field name="model">unicore.thesis</field>
      <field name="arch" type="xml">
        <form string="Thesis">
          <header>
            <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="status != 'defended'"/>
            <button name="action_reject" string="Reject" type="object" invisible="status in ('approved', 'rejected')"/>
            <field name="status" widget="statusbar" statusbar_visible="proposal,research,draft,submitted,defended,approved"/>
          </header>
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="title" placeholder="Thesis Title..."/>
              </h1>
            </div>
            <group>
              <group>
                <field name="student_id" widget="many2one_avatar"/>
                <field name="company_id" invisible="1"/>
              </group>
              <group>
                <field name="supervisor_id" widget="many2one_avatar"/>
                <field name="document" filename="document_filename"/>
                <field name="document_filename" invisible="1"/>
              </group>
            </group>
            <notebook>
              <page string="Abstract" name="abstract">
                <field name="abstract" widget="html" placeholder="Write the abstract here..."/>
              </page>
              <page string="Reviews" name="reviews">
                <field name="review_ids">
                  <list string="Reviews">
                    <field name="reviewer_id" widget="many2one_avatar"/>
                    <field name="decision"/>
                    <field name="create_date"/>
                  </list>
                </field>
              </page>
            </notebook>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>
    <record id="view_unicore_thesis_review_tree" model="ir.ui.view">
      <field name="name">unicore.thesis.review.tree</field>
      <field name="model">unicore.thesis.review</field>
      <field name="arch" type="xml">
        <list string="Thesis Reviews">
          <field name="thesis_id"/>
          <field name="reviewer_id" widget="many2one_avatar"/>
          <field name="decision" widget="badge" decoration-success="decision == 'approve'" decoration-warning="decision == 'revise'" decoration-danger="decision == 'reject'"/>
          <field name="create_date"/>
        </list>
      </field>
    </record>
    <record id="view_unicore_thesis_review_form" model="ir.ui.view">
      <field name="name">unicore.thesis.review.form</field>
      <field name="model">unicore.thesis.review</field>
      <field name="arch" type="xml">
        <form string="Thesis Review">
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="name"/>
              </h1>
            </div>
            <group>
              <group>
                <field name="thesis_id"/>
                <field name="company_id" invisible="1"/>
              </group>
              <group>
                <field name="reviewer_id" widget="many2one_avatar"/>
                <field name="decision"/>
              </group>
            </group>
            <group string="Comments">
              <field name="comments" nolabel="1" placeholder="Reviewer comments..."/>
            </group>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>
    <record id="action_unicore_thesis" model="ir.actions.act_window">
      <field name="name">Theses</field>
      <field name="res_model">unicore.thesis</field>
      <field name="view_mode">list,form</field>
    </record>
    <record id="action_unicore_thesis_review" model="ir.actions.act_window">
      <field name="name">Thesis Reviews</field>
      <field name="res_model">unicore.thesis.review</field>
      <field name="view_mode">list,form</field>
    </record>
  </data>
</odoo>
