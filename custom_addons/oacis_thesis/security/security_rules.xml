<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_oacis_thesis_student" model="ir.rule">
            <field name="name">Thesis: Student Own</field>
            <field name="model_id" ref="model_oacis_thesis"/>
            <field name="domain_force">[('student_id.partner_id.user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('oacis_base.group_oacis_student'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>
        <record id="rule_oacis_thesis_faculty" model="ir.rule">
            <field name="name">Thesis: Faculty Supervisor</field>
            <field name="model_id" ref="model_oacis_thesis"/>
            <field name="domain_force">[('supervisor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('oacis_base.group_oacis_faculty'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
        <record id="rule_oacis_thesis_review_faculty" model="ir.rule">
            <field name="name">Thesis Review: Faculty Own</field>
            <field name="model_id" ref="model_oacis_thesis_review"/>
            <field name="domain_force">[('reviewer_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('oacis_base.group_oacis_faculty'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>
        <record id="rule_oacis_thesis_review_student" model="ir.rule">
            <field name="name">Thesis Review: Student Read Own Thesis Reviews</field>
            <field name="model_id" ref="model_oacis_thesis_review"/>
            <field name="domain_force">[('thesis_id.student_id.partner_id.user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('oacis_base.group_oacis_student'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
