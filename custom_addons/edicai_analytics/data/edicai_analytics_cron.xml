<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <record id="cron_edicai_analytics_refresh" model="ir.cron">
      <field name="name">Edicai Analytics: Daily View Refresh Check</field>
      <field name="model_id" ref="edicai_analytics.model_edicai_student_enrollment_report"/>
      <field name="state">code</field>
      <field name="code">count = env['edicai.student.enrollment.report'].search_count([]); _logger.info('Edicai Analytics: %d student enrollment records in analytics view.', count)</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active">True</field>
      <field name="user_id" ref="base.user_root"/>
    </record>

  </data>
</odoo>
