<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Scholarship Application -->
        <record id="seq_unicore_scholarship_application" model="ir.sequence">
            <field name="name">Scholarship Application</field>
            <field name="code">unicore.scholarship.application</field>
            <field name="prefix">APP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Scholarship Award -->
        <record id="seq_unicore_scholarship_award" model="ir.sequence">
            <field name="name">Scholarship Award</field>
            <field name="code">unicore.scholarship.award</field>
            <field name="prefix">AWD/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
