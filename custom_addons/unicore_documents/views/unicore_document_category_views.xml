<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_unicore_doc_category_form" model="ir.ui.view">
    <field name="name">unicore.document.category.form</field>
    <field name="model">unicore.document.category</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button type="object"
              name="action_view_documents"
              class="oe_stat_button"
              icon="fa-file">
              <field name="document_count" widget="statinfo" string="Documents"/>
            </button>
          </div>
          <group>
            <group string="Category Details">
              <field name="name"/>
              <field name="complete_name" readonly="1"/>
              <field name="parent_id"/>
              <field name="company_id"/>
              <field name="category_type"/>
              <field name="sequence"/>
              <field name="icon"/>
              <field name="color" widget="color"/>
            </group>
            <group string="Access Control">
              <field name="is_student_visible"/>
              <field name="is_public"/>
            </group>
          </group>
          <group string="Description">
            <field name="description" nolabel="1"/>
          </group>
          <notebook>
            <page string="Subcategories">
              <field name="child_ids">
                <list>
                  <field name="name"/>
                  <field name="category_type"/>
                  <field name="document_count"/>
                  <field name="is_student_visible"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_unicore_doc_category_list" model="ir.ui.view">
    <field name="name">unicore.document.category.list</field>
    <field name="model">unicore.document.category</field>
    <field name="arch" type="xml">
      <list>
        <field name="complete_name"/>
        <field name="category_type"/>
        <field name="document_count"/>
        <field name="is_student_visible"/>
        <field name="is_public"/>
      </list>
    </field>
  </record>

  <record id="action_unicore_doc_category" model="ir.actions.act_window">
    <field name="name">Document Categories</field>
    <field name="res_model">unicore.document.category</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
