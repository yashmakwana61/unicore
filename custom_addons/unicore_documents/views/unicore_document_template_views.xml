<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_unicore_doc_template_form" model="ir.ui.view">
    <field name="name">unicore.document.template.form</field>
    <field name="model">unicore.document.template</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <widget name="web_ribbon" title="System"
            invisible="not is_system_template" bg_color="text-bg-secondary"/>
          <group>
            <group string="Template Details">
              <field name="name"/>
              <field name="company_id"/>
              <field name="template_type"/>
              <field name="subject"/>
              <field name="is_active_template"/>
              <field name="is_system_template"/>
            </group>
            <group string="Signatory">
              <field name="signatory_name"/>
              <field name="signatory_designation"/>
              <field name="header_text"/>
            </group>
          </group>
          <group string="Document Body">
            <field name="body_html" nolabel="1"/>
          </group>
          <group string="Footer">
            <field name="footer_text" nolabel="1"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_unicore_doc_template_list" model="ir.ui.view">
    <field name="name">unicore.document.template.list</field>
    <field name="model">unicore.document.template</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="template_type"/>
        <field name="subject"/>
        <field name="signatory_name"/>
        <field name="is_active_template"/>
        <field name="is_system_template"/>
      </list>
    </field>
  </record>

  <record id="action_unicore_doc_template" model="ir.actions.act_window">
    <field name="name">Document Templates</field>
    <field name="res_model">unicore.document.template</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
