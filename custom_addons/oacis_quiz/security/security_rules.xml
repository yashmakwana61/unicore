<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_oacis_quiz_student" model="ir.rule">
            <field name="name">Quiz: Student Access Active Only</field>
            <field name="model_id" ref="model_oacis_quiz"/>
            <field name="domain_force">[('state', '=', 'active')]</field>
            <field name="groups" eval="[(4, ref('oacis_base.group_oacis_student'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
        <record id="rule_oacis_quiz_attempt_student" model="ir.rule">
            <field name="name">Quiz Attempt: Student Own</field>
            <field name="model_id" ref="model_oacis_quiz_attempt"/>
            <field name="domain_force">[('student_id.partner_id.user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('oacis_base.group_oacis_student'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
