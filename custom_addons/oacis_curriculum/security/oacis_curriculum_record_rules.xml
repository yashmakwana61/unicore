        <record id="rule_oacis_course_offering_campus_staff" model="ir.rule">
            <field name="name">Course Offering: Campus Restriction for Staff</field>
            <field name="model_id" ref="model_oacis_course_offering"/>
            <field name="domain_force">['|', ('campus_id', '=', False), ('campus_id', 'in', user.oacis_campus_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('oacis_base.group_oacis_staff'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_oacis_course_offering_faculty_own" model="ir.rule">
            <field name="name">Course Offering: Faculty Own Offerings</field>
            <field name="model_id" ref="model_oacis_course_offering"/>
            <field name="domain_force">['|', ('faculty_member_id.partner_id.user_ids', 'in', [user.id]), ('co_instructor_ids.partner_id.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('oacis_base.group_oacis_faculty'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

