<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Faculty Member: Company Isolation (all internal users) -->
    <record id="rule_unicore_faculty_member_company" model="ir.rule">
        <field name="name">Faculty Member: Company Isolation</field>
        <field name="model_id" ref="model_unicore_faculty_member"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Faculty Member: Self View (portal users) -->
    <record id="rule_unicore_faculty_member_self" model="ir.rule">
        <field name="name">Faculty Member: Self View</field>
        <field name="model_id" ref="model_unicore_faculty_member"/>
        <field name="domain_force">[('partner_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Faculty Member: Admin Bypass -->
    <record id="rule_unicore_faculty_member_admin" model="ir.rule">
        <field name="name">Faculty Member: Admin Bypass</field>
        <field name="model_id" ref="model_unicore_faculty_member"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('unicore_base.group_unicore_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Staff Member: Company Isolation (all internal users) -->
    <record id="rule_unicore_staff_member_company" model="ir.rule">
        <field name="name">Staff Member: Company Isolation</field>
        <field name="model_id" ref="model_unicore_staff_member"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Staff Member: Admin Bypass -->
    <record id="rule_unicore_staff_member_admin" model="ir.rule">
        <field name="name">Staff Member: Admin Bypass</field>
        <field name="model_id" ref="model_unicore_staff_member"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('unicore_base.group_unicore_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
