<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== FORM VIEW ==================== -->
    <record id="unicore_faculty_qualification_form_view" model="ir.ui.view">
        <field name="name">unicore.faculty.qualification.form</field>
        <field name="model">unicore.faculty.qualification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group name="left">
                            <field name="faculty_member_id" options="{'no_create_edit': True}"/>
                            <field name="qualification_level"/>
                            <field name="degree_title"/>
                            <field name="field_of_study"/>
                            <field name="institution_name"/>
                            <field name="country_id" options="{'no_create_edit': True}"/>
                        </group>
                        <group name="right">
                            <field name="year_of_completion"/>
                            <field name="grade_or_cgpa"/>
                            <field name="is_highest"/>
                            <field name="is_verified"/>
                        </group>
                    </group>
                    <group string="Certificate">
                        <field name="certificate_file" widget="binary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== LIST VIEW ==================== -->
    <record id="unicore_faculty_qualification_list_view" model="ir.ui.view">
        <field name="name">unicore.faculty.qualification.list</field>
        <field name="model">unicore.faculty.qualification</field>
        <field name="arch" type="xml">
            <list limit="40">
                <field name="faculty_member_id"/>
                <field name="qualification_level"/>
                <field name="degree_title"/>
                <field name="institution_name"/>
                <field name="year_of_completion"/>
                <field name="is_highest"/>
                <field name="is_verified"/>
            </list>
        </field>
    </record>

    <!-- ==================== WINDOW ACTION ==================== -->
    <record id="action_unicore_faculty_qualification" model="ir.actions.act_window">
        <field name="name">Qualifications</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">unicore.faculty.qualification</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
