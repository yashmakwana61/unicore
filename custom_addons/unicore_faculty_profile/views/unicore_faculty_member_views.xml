<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== FORM VIEW ==================== -->
    <record id="unicore_faculty_member_form_view" model="ir.ui.view">
        <field name="name">unicore.faculty.member.form</field>
        <field name="model">unicore.faculty.member</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="member_state" widget="statusbar"
                           statusbar_visible="draft,active,on_leave,sabbatical,suspended,terminated,retired"
                           clickable="False"/>
                    <button name="action_activate" type="object" string="Activate"
                            invisible="member_state != 'draft'" class="btn-primary"/>
                    <button name="action_place_on_leave" type="object" string="Place on Leave"
                            invisible="member_state != 'active'" class="btn-warning"/>
                    <button name="action_sabbatical" type="object" string="Sabbatical"
                            invisible="member_state != 'active'" class="btn-info"/>
                    <button name="action_return_to_active" type="object" string="Return to Active"
                            invisible="member_state not in ('on_leave','sabbatical')" class="btn-success"/>
                    <button name="action_suspend" type="object" string="Suspend"
                            invisible="member_state != 'active'"
                            groups="unicore_base.group_unicore_admin"/>
                    <button name="action_terminate" type="object" string="Terminate"
                            invisible="member_state in ('terminated','retired')"
                            groups="unicore_base.group_unicore_admin"/>
                    <button name="action_retire" type="object" string="Retire"
                            invisible="member_state != 'active'"
                            groups="unicore_base.group_unicore_admin"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            groups="unicore_base.group_unicore_admin"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_publications" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <field string="Publications" name="publication_count" widget="statinfo"/>
                        </button>
                        <button name="action_open_workload" type="object"
                                class="oe_stat_button" icon="fa-clock">
                            <field string="Workload" name="current_weekly_hours" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button"
                                invisible="not is_overloaded"
                                disabled="True"
                                icon="fa-exclamation-triangle"
                                help="Faculty member is overloaded!">
                            <span class="o_stat_value text-danger">Overloaded</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Faculty Member" class="oe_edit_only"/>
                        <h1>
                            <field name="display_name" placeholder="Full name..." readonly="0"/>
                        </h1>
                    </div>
                    <group>
                        <group name="photo">
                            <field name="image_1920" widget="image" class="oe_avatar"
                                   style="max-width:160px; max-height:160px;"/>
                        </group>
                    </group>
                    <group string="Personal Information">
                        <group name="personal_left">
                            <field name="name"/>
                            <field name="middle_name"/>
                            <field name="last_name"/>
                            <field name="display_name" readonly="1"/>
                            <field name="employee_id_number" readonly="1"/>
                            <field name="gender"/>
                            <field name="date_of_birth"/>
                            <field name="age" readonly="1"/>
                            <field name="nationality_id" options="{'no_create_edit': True}"/>
                            <field name="national_id"/>
                            <field name="blood_group"/>
                        </group>
                        <group name="personal_right">
                            <field name="email"/>
                            <field name="institutional_email"/>
                            <field name="mobile"/>
                            <field name="phone"/>
                            <field name="address_street"/>
                            <field name="address_city"/>
                            <field name="address_state_id" options="{'no_create_edit': True}"/>
                            <field name="address_zip"/>
                            <field name="address_country_id" options="{'no_create_edit': True}"/>
                        </group>
                    </group>
                    <group string="Academic Designation">
                        <group name="academic_left">
                            <field name="company_id" options="{'no_create_edit': True}"/>
                            <field name="academic_faculty_id" options="{'no_create_edit': True}"/>
                            <field name="department_id" options="{'no_create_edit': True}"/>
                            <field name="designation"/>
                            <field name="employment_type"/>
                            <field name="is_hod"/>
                            <field name="is_dean"/>
                        </group>
                        <group name="academic_right">
                            <field name="primary_campus_id" options="{'no_create_edit': True}"/>
                            <field name="campus_ids" widget="many2many_tags"/>
                            <field name="joining_date"/>
                            <field name="contract_end_date"/>
                            <field name="years_of_experience" readonly="1"/>
                            <field name="max_weekly_hours"/>
                            <field name="current_weekly_hours" readonly="1"/>
                            <field name="is_overloaded" readonly="1"/>
                            <field name="specialisation_areas"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="qualifications" string="Qualifications">
                            <field name="qualification_ids" readonly="0">
                                <list editable="bottom" limit="20">
                                    <field name="qualification_level"/>
                                    <field name="degree_title"/>
                                    <field name="field_of_study"/>
                                    <field name="institution_name"/>
                                    <field name="year_of_completion"/>
                                    <field name="is_highest"/>
                                    <field name="is_verified"/>
                                </list>
                            </field>
                        </page>
                        <page name="publications" string="Publications">
                            <field name="publication_ids" readonly="0">
                                <list editable="bottom" limit="20">
                                    <field name="title"/>
                                    <field name="publication_type"/>
                                    <field name="journal_or_venue"/>
                                    <field name="publication_year"/>
                                    <field name="is_indexed"/>
                                    <field name="doi_or_isbn"/>
                                </list>
                            </field>
                        </page>
                        <page name="workload" string="Teaching Workload">
                            <field name="workload_ids" readonly="0">
                                <list editable="bottom" limit="20">
                                    <field name="academic_year_id" options="{'no_create_edit': True}"/>
                                    <field name="semester_id" options="{'no_create_edit': True}"/>
                                    <field name="course_name"/>
                                    <field name="course_code"/>
                                    <field name="workload_type"/>
                                    <field name="weekly_hours"/>
                                    <field name="student_count"/>
                                </list>
                            </field>
                        </page>
                        <page name="system_access" string="System Access">
                            <group>
                                <group>
                                    <field name="partner_id" readonly="1"/>
                                    <field name="user_id" options="{'no_create_edit': True}"/>
                                </group>
                                <group>
                                    <field name="member_state" readonly="1"/>
                                    <field name="termination_date" readonly="1"/>
                                    <field name="termination_reason" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== LIST VIEW ==================== -->
    <record id="unicore_faculty_member_list_view" model="ir.ui.view">
        <field name="name">unicore.faculty.member.list</field>
        <field name="model">unicore.faculty.member</field>
        <field name="arch" type="xml">
            <list limit="40">
                <field name="employee_id_number"/>
                <field name="display_name"/>
                <field name="gender"/>
                <field name="department_id"/>
                <field name="designation"/>
                <field name="employment_type"/>
                <field name="primary_campus_id"/>
                <field name="current_weekly_hours"/>
                <field name="is_overloaded" decoration-danger="is_overloaded == True"
                       decoration-warning="member_state == 'on_leave'"
                       decoration-muted="member_state in ('terminated','retired')"/>
                <field name="member_state" widget="badge"
                       decoration-primary="member_state == 'active'"
                       decoration-warning="member_state in ('on_leave','sabbatical')"
                       decoration-danger="member_state == 'suspended'"
                       decoration-muted="member_state in ('terminated','retired')"
                       decoration-info="member_state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- ==================== SEARCH VIEW ==================== -->
    <record id="unicore_faculty_member_search_view" model="ir.ui.view">
        <field name="name">unicore.faculty.member.search</field>
        <field name="model">unicore.faculty.member</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name"/>
                <field name="employee_id_number"/>
                <field name="email"/>
                <field name="department_id" options="{'no_create_edit': True}"/>
                <field name="academic_faculty_id" options="{'no_create_edit': True}"/>
                <field name="designation"/>
                <filter name="filter_active" string="Active" domain="[('member_state', '=', 'active')]"/>
                <filter name="filter_on_leave" string="On Leave" domain="[('member_state', '=', 'on_leave')]"/>
                <filter name="filter_full_time" string="Full Time" domain="[('employment_type', '=', 'full_time')]"/>
                <filter name="filter_visiting" string="Visiting Faculty" domain="[('designation', '=', 'visiting')]"/>
                <filter name="filter_hod" string="HOD Members" domain="[('is_hod', '=', True)]"/>
                <group name="groupby">
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_faculty" string="Faculty / School" context="{'group_by': 'academic_faculty_id'}"/>
                    <filter name="group_designation" string="Designation" context="{'group_by': 'designation'}"/>
                    <filter name="group_employment" string="Employment Type" context="{'group_by': 'employment_type'}"/>
                    <filter name="group_campus" string="Campus" context="{'group_by': 'primary_campus_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'member_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== KANBAN VIEW ==================== -->
    <record id="unicore_faculty_member_kanban_view" model="ir.ui.view">
        <field name="name">unicore.faculty.member.kanban</field>
        <field name="model">unicore.faculty.member</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" highlight_color="color">
                <field name="employee_id_number"/>
                <field name="display_name"/>
                <field name="designation"/>
                <field name="department_id"/>
                <field name="current_weekly_hours"/>
                <field name="member_state"/>
                <field name="image_1920"/>
                <field name="is_overloaded"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-if="record.image_1920.raw_value"
                                     t-att-src="'/web/image?model=unicore.faculty.member&amp;field=image_1920&amp;id=' + record.id.raw_value"
                                     alt="Photo" style="width:100px; height:100px; border-radius:50%; object-fit:cover;"/>
                                <t t-if="!record.image_1920.raw_value">
                                    <span t-esc="record.display_name.value[0]" style="font-size:3rem; background:#eee; border-radius:50%; width:100px; height:100px; display:flex; align-items:center; justify-content:center;"/>
                                </t>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="display_name"/>
                                </strong>
                                <div class="text-muted o_kanban_record_subtitle">
                                    <field name="employee_id_number"/>
                                </div>
                                <div>
                                    <field name="designation"/>
                                </div>
                                <div>
                                    <field name="department_id"/>
                                </div>
                                <div>
                                    <i class="fa fa-clock"/> Hours: <field name="current_weekly_hours"/>
                                    <i t-if="record.is_overloaded.raw_value" class="fa fa-exclamation-triangle text-danger" title="Overloaded"/>
                                </div>
                                <div>
                                    <field name="member_state" widget="badge"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==================== WINDOW ACTIONS ==================== -->
    <record id="action_unicore_faculty_member" model="ir.actions.act_window">
        <field name="name">Faculty Members</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">unicore.faculty.member</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="unicore_faculty_member_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Start managing faculty members
            </p>
            <p>
                Create faculty member records to track academic staff including
                qualifications, publications, and teaching workload.
            </p>
        </field>
    </record>

    <record id="action_unicore_faculty_member_active" model="ir.actions.act_window">
        <field name="name">Active Faculty</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">unicore.faculty.member</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('member_state', '=', 'active')]</field>
        <field name="search_view_id" ref="unicore_faculty_member_search_view"/>
    </record>

</odoo>
