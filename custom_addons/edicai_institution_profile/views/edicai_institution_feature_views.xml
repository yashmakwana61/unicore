<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Window Action -->
    <record id="action_edicai_institution_feature" model="ir.actions.act_window">
        <field name="name">Institution Features</field>
        <field name="res_model">edicai.institution.feature</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>

    <!-- List View -->
    <record id="edicai_institution_feature_list_view" model="ir.ui.view">
        <field name="name">edicai.institution.feature.list</field>
        <field name="model">edicai.institution.feature</field>
        <field name="arch" type="xml">
            <list string="Institution Features">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="edicai_institution_feature_form_view" model="ir.ui.view">
        <field name="name">edicai.institution.feature.form</field>
        <field name="model">edicai.institution.feature</field>
        <field name="arch" type="xml">
            <form string="Institution Feature">
                <sheet>
                    <group>
                        <group name="left">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group name="right">
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
