<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- EXTEND COURSE OFFERING FORM (Grade Book smart button)        -->
        <!-- ============================================================ -->

        <record id="view_unicore_course_offering_form_ext_gradebook"
                model="ir.ui.view">
            <field name="name">unicore.course.offering.form.ext.gradebook</field>
            <field name="model">unicore.course.offering</field>
            <field name="inherit_id"
                   ref="unicore_curriculum.view_unicore_course_offering_form"/>
            <field name="arch" type="xml">

                <!-- Add grade book stat button to the button box -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_open_gradebook" type="object"
                            class="oe_stat_button" icon="fa-book"
                            groups="unicore_base.group_unicore_faculty">
                        <field name="gradebook_config_count"
                               widget="statinfo" string="Grade Book"/>
                    </button>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
