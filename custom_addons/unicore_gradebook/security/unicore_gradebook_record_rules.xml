<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- RECORD RULES: unicore.gradebook.config                       -->
        <!-- ============================================================ -->

        <record id="rule_unicore_gradebook_config_company" model="ir.rule">
            <field name="name">Grade Book: Company Isolation</field>
            <field name="model_id" ref="model_unicore_gradebook_config"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_unicore_gradebook_config_student_self" model="ir.rule">
            <field name="name">Grade Book: Student Enrolled Offering Only</field>
            <field name="model_id" ref="model_unicore_gradebook_config"/>
            <field name="domain_force">[('course_offering_id.enrollment_ids', 'any', [('student_id.partner_id.user_ids', 'in', [user.id])])]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_student'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_unicore_gradebook_config_faculty_own" model="ir.rule">
            <field name="name">Grade Book: Faculty Own Offering</field>
            <field name="model_id" ref="model_unicore_gradebook_config"/>
            <field name="domain_force">[('course_offering_id.faculty_member_id.partner_id.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_faculty'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_unicore_gradebook_config_admin" model="ir.rule">
            <field name="name">Grade Book: Admin Bypass</field>
            <field name="model_id" ref="model_unicore_gradebook_config"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

