<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data noupdate="1">
    <record id="rule_oacis_finance_snapshot_company" model="ir.rule">
      <field name="name">Finance Snapshot: Company Isolation</field>
      <field name="model_id" ref="oacis_finance_report.model_oacis_finance_snapshot"/>
      <field name="domain_force">['|',('company_id','=',False),
             ('company_id','in',company_ids)]</field>
      <field name="groups" eval="[(4,ref('base.group_user'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_oacis_finance_snapshot_admin" model="ir.rule">
      <field name="name">Finance Snapshot: Admin Bypass</field>
      <field name="model_id" ref="oacis_finance_report.model_oacis_finance_snapshot"/>
      <field name="domain_force">[(1,'=',1)]</field>
      <field name="groups" eval="[(4,ref('oacis_base.group_oacis_admin'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_oacis_finance_kpi_company" model="ir.rule">
      <field name="name">Finance KPI: Company Isolation</field>
      <field name="model_id" ref="oacis_finance_report.model_oacis_finance_kpi"/>
      <field name="domain_force">['|',('company_id','=',False),
             ('company_id','in',company_ids)]</field>
      <field name="groups" eval="[(4,ref('base.group_user'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_oacis_finance_kpi_admin" model="ir.rule">
      <field name="name">Finance KPI: Admin Bypass</field>
      <field name="model_id" ref="oacis_finance_report.model_oacis_finance_kpi"/>
      <field name="domain_force">[(1,'=',1)]</field>
      <field name="groups" eval="[(4,ref('oacis_base.group_oacis_admin'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>
  </data>
</odoo>
