<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <!-- Pivot View for Payments -->
  <record id="view_oacis_fee_payment_pivot" model="ir.ui.view">
    <field name="name">oacis.fee.payment.pivot</field>
    <field name="model">oacis.fee.payment</field>
    <field name="arch" type="xml">
      <pivot string="Payment Analytics">
        <field name="payment_method" type="row"/>
        <field name="payment_date" interval="month" type="col"/>
        <field name="amount" type="measure"/>
      </pivot>
    </field>
  </record>
  <!-- Graph View for Payments -->
  <record id="view_oacis_fee_payment_graph" model="ir.ui.view">
    <field name="name">oacis.fee.payment.graph</field>
    <field name="model">oacis.fee.payment</field>
    <field name="arch" type="xml">
      <graph string="Payment Collection Trend" type="line">
        <field name="payment_date" interval="month"/>
        <field name="amount" type="measure"/>
      </graph>
    </field>
  </record>
  <!-- Payment Analysis Action -->
  <record id="action_oacis_fee_payment_analysis" model="ir.actions.act_window">
    <field name="name">Payment Analytics</field>
    <field name="res_model">oacis.fee.payment</field>
    <field name="view_mode">graph,pivot,list</field>
    <field name="domain">[('payment_state','=','confirmed')]</field>
    <field name="context">{'search_default_group_by_method': 1}</field>
  </record>
</odoo>
