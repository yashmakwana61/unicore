<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <!-- List View for Snapshots -->
  <record id="view_oacis_finance_snapshot_list" model="ir.ui.view">
    <field name="name">oacis.finance.snapshot.list</field>
    <field name="model">oacis.finance.snapshot</field>
    <field name="arch" type="xml">
      <list>
        <field name="snapshot_date"/>
        <field name="company_id"/>
        <field name="semester_id"/>
        <field name="total_invoiced"/>
        <field name="total_collected"/>
        <field name="total_outstanding"/>
        <field name="total_overdue"/>
        <field name="collection_rate"/>
        <field name="invoice_count_total"/>
        <field name="invoice_count_paid"/>
        <field name="scholarship_beneficiary_count"/>
        <field name="net_revenue"/>
      </list>
    </field>
  </record>
  <!-- Graph View for Snapshots -->
  <record id="view_oacis_finance_snapshot_graph" model="ir.ui.view">
    <field name="name">oacis.finance.snapshot.graph</field>
    <field name="model">oacis.finance.snapshot</field>
    <field name="arch" type="xml">
      <graph string="Financial Trend" type="line">
        <field name="snapshot_date"/>
        <field name="total_collected" type="measure"/>
        <field name="total_outstanding" type="measure"/>
        <field name="net_revenue" type="measure"/>
      </graph>
    </field>
  </record>
  <!-- Pivot View for Snapshots -->
  <record id="view_oacis_finance_snapshot_pivot" model="ir.ui.view">
    <field name="name">oacis.finance.snapshot.pivot</field>
    <field name="model">oacis.finance.snapshot</field>
    <field name="arch" type="xml">
      <pivot string="Financial Snapshot Analysis">
        <field name="snapshot_date" interval="month" type="row"/>
        <field name="company_id" type="col"/>
        <field name="total_invoiced" type="measure"/>
        <field name="total_collected" type="measure"/>
        <field name="collection_rate" type="measure"/>
      </pivot>
    </field>
  </record>
  <!-- Search View -->
  <record id="view_oacis_finance_snapshot_search" model="ir.ui.view">
    <field name="name">oacis.finance.snapshot.search</field>
    <field name="model">oacis.finance.snapshot</field>
    <field name="arch" type="xml">
      <search>
        <field name="snapshot_date"/>
        <field name="semester_id"/>
        <field name="company_id"/>
        <separator/>
        <filter name="group_by_semester" string="Semester" context="{'group_by':'semester_id'}"/>
        <filter name="group_by_month" string="Month" context="{'group_by':               'snapshot_date:month'}"/>
      </search>
    </field>
  </record>
  <!-- Window Action -->
  <record id="action_oacis_finance_snapshot" model="ir.actions.act_window">
    <field name="name">Financial Snapshots</field>
    <field name="res_model">oacis.finance.snapshot</field>
    <field name="view_mode">list,graph,pivot</field>
  </record>
</odoo>
