<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Expose the new kanban/calendar/pivot/graph/activity views through the
         view switcher on the existing actions. -->

    <record id="action_unicore_fee_invoice_analysis" model="ir.actions.act_window">
        <field name="view_mode">pivot,graph,list,kanban,calendar,activity</field>
    </record>

    <record id="action_unicore_fee_outstanding_report" model="ir.actions.act_window">
        <field name="view_mode">list,pivot,graph,kanban,calendar,activity</field>
    </record>

    <record id="action_unicore_fee_summary" model="ir.actions.act_window">
        <field name="view_mode">pivot,graph,list,kanban,calendar,activity</field>
    </record>

    <record id="action_unicore_overdue_dashboard" model="ir.actions.act_window">
        <field name="view_mode">list,pivot,kanban,calendar,graph,activity</field>
    </record>

    <record id="action_unicore_scholarship_spend" model="ir.actions.act_window">
        <field name="view_mode">pivot,graph,list,kanban,calendar</field>
    </record>

</odoo>
