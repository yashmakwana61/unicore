            sequence="20"/>

  <menuitem id="menu_oacis_scholarship_spend"
            name="Scholarship Spend"
            parent="menu_oacis_finance_reports"
            action="action_oacis_scholarship_spend"
            sequence="30"/>

  <!-- Configuration -->
  <menuitem id="menu_oacis_finance_config"
            name="Configuration"
            parent="menu_oacis_finance_report_root"
            sequence="100"/>

  <menuitem id="menu_oacis_finance_kpi"
            name="Financial KPIs"
            parent="menu_oacis_finance_config"
            action="action_oacis_finance_kpi"
            sequence="10"/>

</odoo>
