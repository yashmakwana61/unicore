<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="view_oacis_face_checkin_wizard_form" model="ir.ui.view">
        <field name="name">oacis.face.checkin.wizard.form</field>
        <field name="model">oacis.face.checkin.wizard</field>
        <field name="arch" type="xml">
            <form string="Face Check-in">
                <header>
                    <button name="action_recognize" string="Scan Face" type="object" class="btn-primary"
                        invisible="state in ('processing', 'success')"/>
                    <button name="action_confirm_check_in" string="Confirm Check-in" type="object" class="btn-success"
                        invisible="state != 'success'"/>
                    <button name="action_reset" string="Reset" type="object" class="btn-secondary"
                        invisible="state == 'ready'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_reset" type="object" class="oe_stat_button"
                            icon="fa-refresh" invisible="state == 'ready'">
                            <field name="state" widget="statinfo" string="Status"/>
                        </button>
                    </div>

                    <group string="Session Information">
                        <field name="session_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                        <field name="course_offering_id" readonly="1"/>
                        <field name="session_date" readonly="1"/>
                        <field name="time_slot_id" readonly="1"/>
                        <field name="room_id" readonly="1"/>
                    </group>

                    <group string="Face Recognition" invisible="state == 'ready'">
                        <field name="matched_student_id" readonly="1" options="{'no_create': True, 'no_open': True}"
                            invisible="not matched_student_id"/>
                        <field name="confidence" readonly="1" widget="progressbar"
                            invisible="confidence == 0"/>
                        <field name="face_registration_id" readonly="1" options="{'no_create': True, 'no_open': True}"
                            invisible="not face_registration_id"/>
                    </group>

                    <div class="mt-3" invisible="state in ('success', 'error')">
                        <label for="face_image" string="Camera Capture"/>
                        <div class="d-flex flex-column align-items-center">
                            <video id="face_video" autoplay="true" playsinline="true" style="width: 100%; max-width: 400px; border: 2px solid #ddd; border-radius: 8px; background: #000;"></video>
                            <canvas id="face_canvas" style="display: none;"></canvas>
                            <div class="mt-2">
                                <button type="button" class="btn btn-primary" id="capture_btn"
                                    onclick="captureFace()">
                                    <i class="fa fa-camera"/> Capture
                                </button>
                                <button type="button" class="btn btn-secondary ms-2" id="retake_btn" style="display: none;"
                                    onclick="retakeFace()">
                                    <i class="fa fa-redo"/> Retake
                                </button>
                            </div>
                            <img id="captured_image" src="" alt="Captured face" style="display: none; max-width: 400px; margin-top: 10px; border: 2px solid #ddd; border-radius: 8px;"/>
                        </div>
                    </div>

                    <div class="mt-3 alert alert-success" invisible="state != 'success'"
                        role="alert">
                        <h5><i class="fa fa-check-circle"/> Face Recognized Successfully!</h5>
                        <p><strong>Student:</strong> <field name="matched_student_id" readonly="1" nolabel="1" options="{'no_create': True, 'no_open': True}"/></p>
                        <p><strong>Confidence:</strong> <field name="confidence" readonly="1" nolabel="1" widget="percentage"/></p>
                        <p>Click <strong>Confirm Check-in</strong> to mark attendance.</p>
                    </div>

                    <div class="mt-3 alert alert-danger" invisible="state != 'error'"
                        role="alert">
                        <h5><i class="fa fa-times-circle"/> Recognition Failed</h5>
                        <p><field name="recognition_result" readonly="1" nolabel="1"/></p>
                        <p>Please try again with better lighting or face position.</p>
                    </div>

                    <field name="face_image" invisible="1"/>
                    <field name="recognition_result" invisible="1"/>
                    <field name="state" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_oacis_face_checkin_wizard" model="ir.actions.act_window">
        <field name="name">Face Check-in</field>
        <field name="res_model">oacis.face.checkin.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_session_id': active_id}</field>
    </record>

    <!-- Template for camera capture -->
    <template id="oacis_face_camera_template">
        <div class="oacis-face-camera">
            <script type="text/javascript">
                function initFaceCamera() {
                    const video = document.getElementById('face_video');
                    const canvas = document.getElementById('face_canvas');
                    const captureBtn = document.getElementById('capture_btn');
                    const retakeBtn = document.getElementById('retake_btn');
                    const capturedImg = document.getElementById('captured_image');
                    const faceImageField = document.querySelector('input[name="face_image"]') ||
                                         document.querySelector('[name="face_image"]');

                    let stream = null;

                    async function startCamera() {
                        try {
                            stream = await navigator.mediaDevices.getUserMedia({
                                video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } }
                            });
                            video.srcObject = stream;
                            await video.play();
                        } catch (err) {
                            console.error('Camera access denied:', err);
                            alert('Camera access denied. Please allow camera permission.');
                        }
                    }

                    function captureFace() {
                        canvas.width = video.videoWidth;
                        canvas.height = video.videoHeight;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

                        // Convert to base64
                        const dataUrl = canvas.toDataURL('image/jpeg', 0.8);
                        const base64Data = dataUrl.split(',')[1];

                        // Set the hidden field
                        if (faceImageField) {
                            faceImageField.value = base64Data;
                            // Trigger Odoo field change
                            faceImageField.dispatchEvent(new Event('change', { bubbles: true }));
                        }

                        // Show captured image
                        capturedImg.src = dataUrl;
                        capturedImg.style.display = 'block';
                        video.style.display = 'none';
                        captureBtn.style.display = 'none';
                        retakeBtn.style.display = 'inline-block';
                    }

                    function retakeFace() {
                        capturedImg.style.display = 'none';
                        video.style.display = 'block';
                        captureBtn.style.display = 'inline-block';
                        retakeBtn.style.display = 'none';
                    }

                    // Expose globally for onclick handlers
                    window.captureFace = captureFace;
                    window.retakeFace = retakeFace;

                    // Start camera when modal opens
                    startCamera();
                }

                // Initialize when document is ready
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initFaceCamera);
                } else {
                    initFaceCamera();
                }
            </script>
        </div>
    </template>

</odoo>