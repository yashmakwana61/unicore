<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Face Registration Form View -->
    <record id="view_oacis_face_registration_form" model="ir.ui.view">
        <field name="name">oacis.face.registration.form</field>
        <field name="model">oacis.face.registration</field>
        <field name="arch" type="xml">
            <form string="Face Registration">
                <header>
                    <button name="action_deactivate" string="Deactivate" type="object" class="btn-secondary"
                        invisible="not is_active" groups="oacis_base.group_oacis_admin"/>
                    <button name="action_reactivate" string="Reactivate" type="object" class="btn-primary"
                        invisible="is_active" groups="oacis_base.group_oacis_admin"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_deactivate" type="object" class="oe_stat_button"
                            icon="fa-toggle-on" invisible="not is_active"
                            groups="oacis_base.group_oacis_admin">
                            <field name="is_active" widget="statinfo" string="Status"/>
                        </button>
                        <button type="object" class="oe_stat_button" icon="fa-camera"
                            invisible="usage_count == 0"
                            groups="oacis_base.group_oacis_admin">
                            <field name="usage_count" widget="statinfo" string="Uses"/>
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="student_id" options="{'no_create': True, 'no_open': True}" required="1"/>
                            <field name="company_id" options="{'no_create': True}" required="1"/>
                            <field name="registration_date" required="1"/>
                            <field name="is_active" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_used" readonly="1"/>
                            <field name="confidence_threshold" widget="progressbar"/>
                            <field name="usage_count" readonly="1"/>
                        </group>
                    </group>

                    <group string="Face Image">
                        <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image_medium'}"/>
                    </group>

                    <group string="Technical Details" groups="oacis_base.group_oacis_admin">
                        <field name="face_encoding" widget="text" readonly="1"
                            help="128-dimensional face encoding vector (JSON)"/>
                    </group>

                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Face Registration List View -->
    <record id="view_oacis_face_registration_list" model="ir.ui.view">
        <field name="name">oacis.face.registration.list</field>
        <field name="model">oacis.face.registration</field>
        <field name="arch" type="xml">
            <list string="Face Registrations" decoration-success="is_active == True" decoration-muted="is_active == False">
                <field name="student_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="registration_date"/>
                <field name="is_active"/>
                <field name="last_used"/>
                <field name="usage_count"/>
                <field name="confidence_threshold"/>
            </list>
        </field>
    </record>

    <!-- Face Registration Search View -->
    <record id="view_oacis_face_registration_search" model="ir.ui.view">
        <field name="name">oacis.face.registration.search</field>
        <field name="model">oacis.face.registration</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id" string="Student" filter_domain="[('student_id', 'ilike', self)]"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="active" string="Active" domain="[('is_active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('is_active', '=', False)]"/>
                <separator/>
                <filter name="by_student" string="Student" domain="[]" context="{'group_by': 'student_id'}"/>
                <filter name="by_company" string="Company" domain="[]" context="{'group_by': 'company_id'}"/>
                <filter name="by_active" string="Status" domain="[]" context="{'group_by': 'is_active'}"/>
            </search>
        </field>
    </record>

    <!-- Face Registration Kanban View -->
    <record id="view_oacis_face_registration_kanban" model="ir.ui.view">
        <field name="name">oacis.face.registration.kanban</field>
        <field name="model">oacis.face.registration</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_cards" sample="1">
                <field name="student_id"/>
                <field name="image"/>
                <field name="is_active"/>
                <field name="last_used"/>
                <field name="usage_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click_edit o_kanban_record_has_image_fill o_academic_kanban_card"
                            t-attf-class="#{record.is_active.raw_value ? '' : 'opacity-50'}">
                            <div class="o_kanban_image text-center p-2" style="height: 150px;">
                                <field name="image" widget="image" class="img-fluid rounded-circle"
                                    style="max-width: 120px; max-height: 120px; object-fit: cover;"/>
                            </div>
                            <div class="oe_kanban_details p-2">
                                <strong class="text-truncate d-block">
                                    <field name="student_id"/>
                                </strong>
                                <div class="text-muted small">
                                    <field name="registration_date"/>
                                </div>
                                <div class="small">
                                    <span t-if="record.is_active.raw_value"
                                        class="badge bg-success">Active</span>
                                    <span t-else="" class="badge bg-secondary">Inactive</span>
                                </div>
                                <div class="small text-muted mt-1">
                                    Uses: <field name="usage_count"/> |
                                    Last: <field name="last_used"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action for Face Registrations -->
    <record id="action_oacis_face_registration" model="ir.actions.act_window">
        <field name="name">Face Registrations</field>
        <field name="res_model">oacis.face.registration</field>
        <field name="view_mode">kanban,list,form,search</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register student faces for biometric attendance
            </p>
        </field>
    </record>

    <!-- Menu for Face Registrations -->
    <menuitem
        id="menu_oacis_face_registration"
        name="Face Registrations"
        parent="menu_oacis_attendance"
        action="action_oacis_face_registration"
        sequence="20"
        groups="oacis_base.group_oacis_admin,oacis_base.group_oacis_manager,oacis_base.group_oacis_registrar"/>

</odoo>