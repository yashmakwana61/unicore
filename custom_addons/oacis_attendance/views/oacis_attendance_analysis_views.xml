<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Attendance Session Analysis
         ============================================================ -->
    

    <record id="unicore_attendance_session_pivot_view" model="ir.ui.view">
        <field name="name">unicore.attendance.session.pivot</field>
        <field name="model">unicore.attendance.session</field>
        <field name="arch" type="xml">
            <pivot string="Attendance Session Analysis">
                <field name="session_state" type="row"/>
                <field name="total_students" type="measure"/>
                <field name="present_count" type="measure"/>
                <field name="attendance_percentage" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="unicore_attendance_session_graph_view" model="ir.ui.view">
        <field name="name">unicore.attendance.session.graph</field>
        <field name="model">unicore.attendance.session</field>
        <field name="arch" type="xml">
            <graph string="Attendance Session Analysis" type="bar">
                <field name="course_offering_id" type="row"/>
                <field name="attendance_percentage" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============================================================
         Attendance Record Analysis
         ============================================================ -->
    

    <record id="unicore_attendance_record_pivot_view" model="ir.ui.view">
        <field name="name">unicore.attendance.record.pivot</field>
        <field name="model">unicore.attendance.record</field>
        <field name="arch" type="xml">
            <pivot string="Attendance Record Analysis">
                <field name="status" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="unicore_attendance_record_graph_view" model="ir.ui.view">
        <field name="name">unicore.attendance.record.graph</field>
        <field name="model">unicore.attendance.record</field>
        <field name="arch" type="xml">
            <graph string="Attendance Record Analysis" type="bar">
                <field name="status" type="row"/>
            </graph>
        </field>
    </record>

</odoo>
