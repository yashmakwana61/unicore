<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Expose the new kanban/calendar/pivot/graph/activity views through the
         view switcher on the existing actions. -->

    <record id="action_unicore_attendance_my" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph,activity</field>
    </record>

    <record id="action_unicore_attendance_record" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph,activity</field>
    </record>

    <record id="action_unicore_attendance_session" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
    </record>

    <record id="action_unicore_attendance_session_open" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
    </record>

    <record id="action_unicore_attendance_session_today" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
    </record>

    <record id="action_unicore_attendance_shortage" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph,activity</field>
    </record>

</odoo>
