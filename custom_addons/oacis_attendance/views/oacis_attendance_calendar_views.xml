<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================================= -->
        <!-- Attendance Record Calendar                                 -->
        <!-- session_date is a related Date field (no end date).        -->
        <!-- ========================================================= -->
        

        <record id="unicore_attendance_record_calendar_view" model="ir.ui.view">
            <field name="name">unicore.attendance.record.calendar</field>
            <field name="model">unicore.attendance.record</field>
            <field name="arch" type="xml">
                <calendar date_start="session_date" color="color" string="Attendance Record Calendar">
                    <field name="student_id"/>
                    <field name="session_id"/>
                    <field name="course_offering_id"/>
                    <field name="status"/>
                </calendar>
            </field>
        </record>

    </data>
</odoo>
