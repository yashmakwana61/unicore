<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="view_oacis_attendance_session_form" model="ir.ui.view">
        <field name="name">oacis.attendance.session.form</field>
        <field name="model">oacis.attendance.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="session_state" widget="statusbar"/>
                    <widget name="web_ribbon" title="Shortage Alert" invisible="not shortage_alert" bg_color="text-bg-danger"/>
                    <widget name="web_ribbon" title="Warning" invisible="not warning_alert" bg_color="text-bg-warning"/>
                </header>
                <sheet>
                    <group string="Record Details">
                        <group>
                            <field name="session_id"/>
                            <field name="student_id"/>
                            <field name="enrollment_id"/>
                            <field name="course_offering_id" readonly="1"/>
                            <field name="course_id" readonly="1"/>
                            <field name="semester_id" readonly="1"/>
                            <field name="session_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="late_minutes" invisible="status != 'late'"/>
                            <field name="excuse_reason" invisible="status != 'excused'"/>
                            <field name="remarks"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Face Check-in" invisible="not face_check_in">
                        <group>
                            <field name="face_check_in" readonly="1"/>
                            <field name="face_registration_id" readonly="1"/>
                            <field name="face_confidence" readonly="1" widget="progressbar"/>
                            <field name="face_check_in_time" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Cumulative Attendance"/>
                    <group>
                        <group>
                            <field name="total_sessions_held" readonly="1"/>
                            <field name="sessions_present" readonly="1"/>
                            <field name="sessions_absent" readonly="1"/>
                            <field name="sessions_late" readonly="1"/>
                            <field name="sessions_excused" readonly="1"/>
                        </group>
                        <group>
                            <field name="cumulative_attendance_percentage" readonly="1" widget="percentage"/>
                            <field name="shortage_alert" readonly="1"/>
                            <field name="warning_alert" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_oacis_attendance_session_list" model="ir.ui.view">
        <field name="name">oacis.attendance.session.list</field>
        <field name="model">oacis.attendance.session</field>
        <field name="arch" type="xml">
            <list decoration-danger="shortage_alert == True" decoration-warning="warning_alert == True" decoration-success="status == 'present'" decoration-muted="status == 'excused'">
                <field name="session_date"/>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="status"/>
                <field name="face_check_in"/>
                <field name="face_confidence"/>
                <field name="cumulative_attendance_percentage"/>
                <field name="shortage_alert"/>
                <field name="warning_alert"/>
            </list>
        </field>
    </record>

    <record id="view_oacis_attendance_session_search" model="ir.ui.view">
        <field name="name">oacis.attendance.session.search</field>
        <field name="model">oacis.attendance.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="semester_id"/>
                <field name="session_id"/>
                <field name="course_offering_id"/>
                <filter string="Present" name="filter_present" domain="[('status','=','present')]"/>
                <filter string="Absent" name="filter_absent" domain="[('status','=','absent')]"/>
                <filter string="Late" name="filter_late" domain="[('status','=','late')]"/>
                <filter string="Excused" name="filter_excused" domain="[('status','=','excused')]"/>
                <filter string="Face Check-in" name="filter_face_checkin" domain="[('face_check_in','=',True)]"/>
                <separator/>
                <filter string="Student" name="group_student" context="{'group_by':'student_id'}"/>
                <filter string="Course" name="group_course" context="{'group_by':'course_id'}"/>
                <filter string="Semester" name="group_semester" context="{'group_by':'semester_id'}"/>
                <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                <filter string="Shortage Alert" name="group_shortage" context="{'group_by':'shortage_alert'}"/>
                <filter string="Face Check-in" name="group_face_checkin" context="{'group_by':'face_check_in'}"/>
            </search>
        </field>
    </record>

    <record id="view_oacis_attendance_session_kanban" model="ir.ui.view">
        <field name="name">oacis.attendance.session.kanban</field>
        <field name="model">oacis.attendance.session</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_cards" sample="1">
                <field name="session_date"/>
                <field name="student_id"/>
                <field name="status"/>
                <field name="face_check_in"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click_edit o_kanban_record_has_image_fill o_academic_kanban_card"
                            t-attf-class="#{record.status.raw_value ? '' : 'opacity-50'}">
                            <div class="o_kanban_image text-center p-2" style="height: 150px;">
                                <field name="image" widget="image" class="img-fluid rounded-circle"
                                    style="max-width: 120px; max-height: 120px; object-fit: cover;"/>
                            </div>
                            <div class="oe_kanban_details p-2">
                                <strong class="text-truncate d-block">
                                    <field name="student_id"/>
                                </strong>
                                <div class="text-muted small">
                                    <field name="session_date"/>
                                </div>
                                <div class="small">
                                    <span t-if="record.status.raw_value == 'present'"
                                        class="badge bg-success">Present</span>
                                    <span t-elif="record.status.raw_value == 'absent'"
                                        class="badge bg-danger">Absent</span>
                                    <span t-elif="record.status.raw_value == 'late'"
                                        class="badge bg-warning">Late</span>
                                    <span t-else="" class="badge bg-secondary">Excused</span>
                                </div>
                                <div class="small text-muted mt-1">
                                    Last: <field name="session_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_oacis_attendance_session" model="ir.actions.act_window">
        <field name="name">Attendance Sessions</field>
        <field name="res_model">oacis.attendance.session</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
    </record>

    <record id="action_oacis_attendance_session_today" model="ir.actions.act_window">
        <field name="name">Attendance Sessions Today</field>
        <field name="res_model">oacis.attendance.session</field>
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
    </record>

    <record id="action_oacis_attendance_session_open" model="ir.actions.act_window">
        <field name="name">Attendance Sessions Open</field>
        <field name="res_model">oacis.attendance.session</field>
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
    </record>

</odoo>