<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_slide_channel_form_inherit_oacis_lms_gradebook" model="ir.ui.view">
            <field name="name">slide.channel.form.inherit.oacis.lms.gradebook</field>
            <field name="model">slide.channel</field>
            <field name="inherit_id" ref="oacis_lms.view_slide_channel_form_inherit_oacis_lms"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='oacis_academic']/div" position="inside">
                    <button name="action_view_gradebook" 
                            type="object" 
                            string="View Academic Gradebook" 
                            class="btn-secondary ml-2"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
