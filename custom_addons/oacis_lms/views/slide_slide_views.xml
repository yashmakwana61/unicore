<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_slide_slide_form_inherit_oacis_lms" model="ir.ui.view">
            <field name="name">slide.slide.form.inherit.oacis.lms</field>
            <field name="model">slide.slide</field>
            <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
            <field name="arch" type="xml">
                <!-- Add Oacis specific fields after the general slide fields -->
                <xpath expr="//notebook" position="inside">
                    <page string="Oacis Assessments" name="oacis_assessments">
                        <group>
                            <group string="Oacis Assignment">
                                <field name="is_oacis_assignment"/>
                                <field name="oacis_assignment_id" 
                                       invisible="not is_oacis_assignment"
                                       required="is_oacis_assignment"/>
                            </group>
                            <group string="Oacis Quiz">
                                <field name="is_oacis_quiz"/>
                                <field name="oacis_quiz_id" 
                                       invisible="not is_oacis_quiz"
                                       required="is_oacis_quiz"/>
                            </group>
                            <group string="Live Class Integration">
                                <field name="is_live_class"/>
                                <field name="meeting_url" 
                                       invisible="not is_live_class"
                                       required="is_live_class"/>
                                <field name="meeting_datetime" 
                                       invisible="not is_live_class"
                                       required="is_live_class"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
