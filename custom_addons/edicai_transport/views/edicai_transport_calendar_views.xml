<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Transport Trip Calendar View
         ============================================================ -->
    

    <record id="edicai_transport_trip_calendar_view" model="ir.ui.view">
        <field name="name">edicai.transport.trip.calendar</field>
        <field name="model">edicai.transport.trip</field>
        <field name="type">calendar</field>
        <field name="arch" type="xml">
            <calendar date_start="trip_date" color="color" string="Transport Trip Calendar">
                <field name="route_id"/>
                <field name="vehicle_id"/>
                <field name="trip_type"/>
                <field name="trip_state"/>
            </calendar>
        </field>
    </record>

    <!-- ============================================================
         Transport Pass Calendar View
         ============================================================ -->
    

    <record id="edicai_transport_pass_calendar_view" model="ir.ui.view">
        <field name="name">edicai.transport.pass.calendar</field>
        <field name="model">edicai.transport.pass</field>
        <field name="type">calendar</field>
        <field name="arch" type="xml">
            <calendar date_start="valid_from" date_stop="valid_until" color="color" string="Transport Pass Calendar">
                <field name="student_id" widget="many2one_avatar"/>
                <field name="route_id"/>
                <field name="pass_state"/>
            </calendar>
        </field>
    </record>

</odoo>
