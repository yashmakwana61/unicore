<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edicai_bulk_exam_schedule_wizard_form" model="ir.ui.view">
        <field name="name">edicai.bulk.exam.schedule.wizard.form</field>
        <field name="model">edicai.bulk.exam.schedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Schedule Exams for a Program or Grade">
                <group>
                    <group>
                        <field name="company_id"/>
                        <field name="semester_id"/>
                        <field name="campus_id"/>
                        <field name="program_id"/>
                        <field name="exam_type_selection"/>
                    </group>
                    <group string="Default Values (editable per subject)">
                        <field name="exam_date"/>
                        <field name="exam_start_time" widget="float_time"/>
                        <field name="exam_end_time" widget="float_time"/>
                        <field name="exam_max_marks"/>
                        <p class="text-muted">
                            Defaults are copied to every subject. Review the
                            schedule lines below and adjust dates, times,
                            venues and invigilators before creating.
                        </p>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    Learners are not added to schedules individually. Hall
                    tickets are generated from registered learners in each
                    course offering after the schedules are published.
                </div>
                <button name="action_load_offerings" type="object"
                        string="Load Subjects" class="btn-secondary"/>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="1">
                        <field name="course_offering_id"/>
                        <field name="exam_date"/>
                        <field name="exam_start_time" widget="float_time"/>
                        <field name="exam_end_time" widget="float_time"/>
                        <field name="exam_max_marks"/>
                        <field name="venue_ids" widget="many2many_tags"/>
                        <field name="invigilator_ids" widget="many2many_tags"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_schedules" type="object"
                            string="Create Exam Schedules"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_edicai_bulk_exam_schedule_wizard"
            model="ir.actions.act_window">
        <field name="name">Schedule Exams for Program / Grade</field>
        <field name="res_model">edicai.bulk.exam.schedule.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
