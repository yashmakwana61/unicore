<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Expose the new kanban/calendar/pivot/graph/activity views through the
         view switcher on the existing actions. -->

    <record id="action_unicore_fee_invoice" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph,activity</field>
    </record>

    <record id="action_unicore_fee_invoice_all" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph,activity</field>
    </record>

    <record id="action_unicore_fee_invoice_my" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph,activity</field>
    </record>

    <record id="action_unicore_fee_overdue" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph,activity</field>
    </record>

    <record id="action_unicore_fee_structure" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban</field>
    </record>

</odoo>
