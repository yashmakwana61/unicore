<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_unicore_fee_invoice_form" model="ir.ui.view">
    <field name="name">unicore.fee.invoice.form</field>
    <field name="model">unicore.fee.invoice</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_send" string="Send to Student" type="object" invisible="invoice_state != 'draft'" class="btn-primary"/>
          <button name="action_record_payment" string="Record Payment" type="object" class="btn-success" invisible="invoice_state == 'paid' or not account_move_id or gl_status != 'posted'" groups="unicore_base.group_unicore_admin,unicore_base.group_unicore_finance"/>
          <button name="action_cancel" string="Cancel" type="object" invisible="invoice_state in ('paid','cancelled')" groups="unicore_base.group_unicore_admin"/>
          <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="invoice_state in ('draft','paid','cancelled')" groups="unicore_base.group_unicore_admin"/>
          <field name="invoice_state" widget="statusbar" statusbar_visible="draft,sent,partial,paid"/>
        </header>
        <sheet>
          <widget name="web_ribbon" title="PAID" invisible="invoice_state != 'paid'" bg_color="text-bg-success"/>
          <widget name="web_ribbon" title="OVERDUE" invisible="not is_overdue" bg_color="text-bg-danger"/>
          <widget name="web_ribbon" title="CANCELLED" invisible="invoice_state != 'cancelled'" bg_color="text-bg-secondary"/>
          <div class="oe_button_box" name="button_box">
                    </div>
          <group>
            <group name="invoice_details" string="Invoice Details">
              <field name="invoice_number" readonly="1"/>
              <field name="student_id"/>
              <field name="company_id"/>
              <field name="academic_year_id"/>
              <field name="semester_id"/>
              <field name="fee_structure_id"/>
            </group>
            <group name="dates_amounts" string="Dates &amp; Amounts">
              <field name="invoice_date"/>
              <field name="due_date"/>
              <field name="currency_id"/>
              <field name="subtotal" readonly="1"/>
              <field name="discount_amount"/>
              <field name="discount_reason" invisible="discount_amount == 0"/>
              <field name="late_fee_amount"/>
              <field name="total_amount" readonly="1"/>
              <field name="amount_paid" readonly="1"/>
              <field name="amount_outstanding" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page name="fee_breakdown" string="Fee Breakdown">
              <field name="line_ids">
                <list editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="fee_type"/>
                  <field name="name"/>
                  <field name="amount"/>
                  <field name="is_mandatory"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="view_unicore_fee_invoice_list" model="ir.ui.view">
    <field name="name">unicore.fee.invoice.list</field>
    <field name="model">unicore.fee.invoice</field>
    <field name="arch" type="xml">
      <list decoration-success="invoice_state == 'paid'" decoration-danger="invoice_state == 'overdue'" decoration-warning="invoice_state == 'partial'" decoration-muted="invoice_state == 'cancelled'">
        <field name="invoice_number"/>
        <field name="student_id"/>
        <field name="semester_id"/>
        <field name="invoice_date"/>
        <field name="due_date"/>
        <field name="total_amount"/>
        <field name="amount_paid"/>
        <field name="amount_outstanding"/>
        <field name="invoice_state"/>
      </list>
    </field>
  </record>
  <record id="view_unicore_fee_invoice_search" model="ir.ui.view">
    <field name="name">unicore.fee.invoice.search</field>
    <field name="model">unicore.fee.invoice</field>
    <field name="arch" type="xml">
      <search>
        <field name="invoice_number"/>
        <field name="student_id"/>
        <field name="semester_id"/>
        <separator/>
        <filter name="paid" string="Paid" domain="[('invoice_state','=','paid')]"/>
        <filter name="outstanding" string="Outstanding" domain="[('invoice_state','in',['sent','partial','overdue'])]"/>
        <filter name="overdue" string="Overdue" domain="[('invoice_state','=','overdue')]"/>
        <separator/>
        <filter name="group_by_semester" string="Semester" context="{'group_by':'semester_id'}"/>
        <filter name="group_by_state" string="Status" context="{'group_by':'invoice_state'}"/>
      </search>
    </field>
  </record>
  <record id="action_unicore_fee_invoice" model="ir.actions.act_window">
    <field name="name">Fee Invoices</field>
    <field name="res_model">unicore.fee.invoice</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_outstanding': 1}</field>
  </record>
  <record id="action_unicore_fee_invoice_all" model="ir.actions.act_window">
    <field name="name">All Fee Invoices</field>
    <field name="res_model">unicore.fee.invoice</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_unicore_fee_invoice_my" model="ir.actions.act_window">
    <field name="name">My Fee Invoice</field>
    <field name="res_model">unicore.fee.invoice</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('student_id.partner_id.user_ids','in',[uid])]</field>
  </record>
  <record id="action_unicore_fee_overdue" model="ir.actions.act_window">
    <field name="name">Overdue Fees</field>
    <field name="res_model">unicore.fee.invoice</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('invoice_state','in',['overdue','sent','partial']),('amount_outstanding','&gt;',0)]</field>
  </record>
</odoo>
