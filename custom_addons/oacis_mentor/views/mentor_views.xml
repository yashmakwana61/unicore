<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data>
    <!-- ==================== MENTOR ALLOCATION VIEWS ==================== -->
    <record id="view_oacis_mentor_allocation_tree" model="ir.ui.view">
      <field name="name">oacis.mentor.allocation.tree</field>
      <field name="model">oacis.mentor.allocation</field>
      <field name="arch" type="xml">
        <list string="Mentor Allocations" default_order="academic_year_id desc, mentor_id asc">
          <field name="name" class="fw-bold"/>
          <field name="mentor_id" widget="many2one_avatar"/>
          <field name="academic_year_id"/>
          <field name="student_ids" widget="many2many_tags"/>
          <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-muted="state == 'done'"/>
        </list>
      </field>
    </record>

    <record id="view_oacis_mentor_allocation_form" model="ir.ui.view">
      <field name="name">oacis.mentor.allocation.form</field>
      <field name="model">oacis.mentor.allocation</field>
      <field name="arch" type="xml">
        <form string="Mentor Allocation">
          <header>
            <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="state != 'draft'"/>
            <button name="action_done" string="Mark Done" type="object" class="btn-secondary" invisible="state != 'active'"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,active,done"/>
          </header>
          <sheet>
            <widget name="web_ribbon" title="Active Mentorship" bg_color="text-bg-success" invisible="state != 'active'"/>
            <widget name="web_ribbon" title="Completed" bg_color="text-bg-secondary" invisible="state != 'done'"/>
            <div class="oe_title">
              <label for="name" string="Mentorship Title" class="oe_edit_only"/>
              <h1>
                <field name="name" readonly="1"/>
              </h1>
            </div>
            <group>
              <group name="left" string="Mentor Details">
                <field name="mentor_id" widget="many2one_avatar" options="{'no_create_edit': True}"/>
                <field name="academic_year_id" options="{'no_create_edit': True}"/>
                <field name="company_id" invisible="1"/>
              </group>
            </group>
            <notebook>
              <page string="Assigned Mentees (Students)" name="students_tab">
                <field name="student_ids">
                  <list string="Assigned Students">
                    <field name="student_id_number"/>
                    <field name="display_name" class="fw-bold"/>
                    <field name="program_id"/>
                    <field name="current_semester_id"/>
                    <field name="email" widget="email"/>
                    <field name="mobile" widget="phone"/>
                  </list>
                </field>
              </page>
            </notebook>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>

    <record id="view_oacis_mentor_allocation_kanban" model="ir.ui.view">
      <field name="name">oacis.mentor.allocation.kanban</field>
      <field name="model">oacis.mentor.allocation</field>
      <field name="arch" type="xml">
        <kanban class="o_kanban_mobile" default_group_by="state">
          <field name="id"/>
          <field name="name"/>
          <field name="mentor_id" widget="many2one_avatar"/>
          <field name="academic_year_id"/>
          <field name="student_ids"/>
          <field name="state" widget="badge"/>
          <templates>
            <t t-name="card" class="flex-column">
              <div class="d-flex justify-content-between align-items-start">
                <field name="name" class="fw-bold fs-6"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-muted="state == 'done'"/>
              </div>
              <div class="mt-2 d-flex align-items-center gap-2">
                <field name="mentor_id" widget="many2one_avatar"/>
                <span class="text-truncate"><field name="mentor_id" widget="many2one_avatar"/></span>
              </div>
              <div class="mt-2 d-flex justify-content-between align-items-center small text-muted">
                <span><i class="fa fa-calendar me-1" title="Calendar"/><field name="academic_year_id"/></span>
                <span class="badge text-bg-light border"><i class="fa fa-users me-1" title="Users"/><field name="student_ids"/></span>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <record id="view_oacis_mentor_allocation_search" model="ir.ui.view">
      <field name="name">oacis.mentor.allocation.search</field>
      <field name="model">oacis.mentor.allocation</field>
      <field name="arch" type="xml">
        <search string="Search Mentor Allocations">
          <field name="name" string="Allocation / Mentor" filter_domain="['|', ('name', 'ilike', self), ('mentor_id.name', 'ilike', self)]"/>
          <field name="mentor_id" widget="many2one_avatar"/>
          <field name="academic_year_id"/>

          <searchpanel>
            <field name="academic_year_id" icon="fa-calendar" enable_counters="1"/>
            <field name="state" icon="fa-filter" select="multi" enable_counters="1"/>
          </searchpanel>

          <filter name="filter_active" string="Active Mentorships" domain="[('state', '=', 'active')]"/>
          <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
          <separator/>

          <group name="groupby">
            <filter name="group_mentor" string="Mentor" context="{'group_by': 'mentor_id'}"/>
            <filter name="group_year" string="Academic Year" context="{'group_by': 'academic_year_id'}"/>
            <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- ==================== MENTOR MEETING LOG VIEWS ==================== -->
    <record id="view_oacis_mentor_meeting_log_tree" model="ir.ui.view">
      <field name="name">oacis.mentor.meeting.log.tree</field>
      <field name="model">oacis.mentor.meeting.log</field>
      <field name="arch" type="xml">
        <list string="Meeting Logs" default_order="meeting_date desc">
          <field name="meeting_date"/>
          <field name="allocation_id"/>
          <field name="student_id" widget="many2one_avatar"/>
          <field name="follow_up_required" widget="boolean_toggle"/>
          <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'completed'"/>
        </list>
      </field>
    </record>

    <record id="view_oacis_mentor_meeting_log_form" model="ir.ui.view">
      <field name="name">oacis.mentor.meeting.log.form</field>
      <field name="model">oacis.mentor.meeting.log</field>
      <field name="arch" type="xml">
        <form string="Meeting Log">
          <header>
            <button name="action_complete" string="Mark Completed" type="object" class="btn-primary" invisible="state != 'draft'"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,completed"/>
          </header>
          <sheet>
            <widget name="web_ribbon" title="Completed" bg_color="text-bg-success" invisible="state != 'completed'"/>
            <group>
              <group name="left" string="Session Details">
                <field name="allocation_id" options="{'no_create_edit': True}"/>
                <field name="student_ids" invisible="1"/>
                <field name="student_id" widget="many2one_avatar" options="{'no_create_edit': True}"/>
                <field name="company_id" invisible="1"/>
              </group>
              <group name="right" string="Schedule &amp; Action">
                <field name="meeting_date"/>
                <field name="follow_up_required" widget="boolean_toggle"/>
              </group>
            </group>
            <group string="Meeting Notes &amp; Observations">
              <field name="notes" placeholder="Summarize discussions, academic performance reviews, personal issues, and advice given..." nolabel="1" widget="html"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="view_oacis_mentor_meeting_log_calendar" model="ir.ui.view">
      <field name="name">oacis.mentor.meeting.log.calendar</field>
      <field name="model">oacis.mentor.meeting.log</field>
      <field name="arch" type="xml">
        <calendar string="Mentor Meetings" date_start="meeting_date" color="student_id" mode="month">
          <field name="student_id" widget="many2one_avatar"/>
          <field name="allocation_id"/>
        </calendar>
      </field>
    </record>

    <record id="view_oacis_mentor_meeting_log_search" model="ir.ui.view">
      <field name="name">oacis.mentor.meeting.log.search</field>
      <field name="model">oacis.mentor.meeting.log</field>
      <field name="arch" type="xml">
        <search string="Search Meeting Logs">
          <field name="allocation_id"/>
          <field name="student_id" widget="many2one_avatar"/>
          <filter name="filter_follow_up" string="Follow-up Required" domain="[('follow_up_required', '=', True)]"/>
          <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
          <separator/>
          <group name="groupby">
            <filter name="group_allocation" string="Mentorship" context="{'group_by': 'allocation_id'}"/>
            <filter name="group_student" string="Student" context="{'group_by': 'student_id'}"/>
            <filter name="group_date" string="Meeting Date" context="{'group_by': 'meeting_date:month'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- ==================== ACTIONS ==================== -->
    <record id="action_oacis_mentor_allocation" model="ir.actions.act_window">
      <field name="name">Mentor Allocations</field>
      <field name="res_model">oacis.mentor.allocation</field>
      <field name="view_mode">kanban,list,form</field>
      <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <record id="action_oacis_mentor_meeting_log" model="ir.actions.act_window">
      <field name="name">Mentor Meeting Logs</field>
      <field name="res_model">oacis.mentor.meeting.log</field>
      <field name="view_mode">list,form,calendar</field>
    </record>
  </data>
</odoo>
