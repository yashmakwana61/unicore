<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Library Issue Calendar
         ============================================================ -->
    <record id="edicai_library_issue_calendar_view" model="ir.ui.view">
        <field name="name">edicai.library.issue.calendar</field>
        <field name="model">edicai.library.issue</field>
        <field name="type">calendar</field>
        <field name="arch" type="xml">
            <calendar date_start="issue_date" date_stop="due_date" color="color" string="Library Issue Calendar">
                <field name="issue_state"/>
                <field name="member_id"/>
                <field name="book_id"/>
                <field name="book_copy_id"/>
            </calendar>
        </field>
    </record>

    

    <!-- ============================================================
         Library Reservation Calendar
         ============================================================ -->
    <record id="edicai_library_reservation_calendar_view" model="ir.ui.view">
        <field name="name">edicai.library.reservation.calendar</field>
        <field name="model">edicai.library.reservation</field>
        <field name="type">calendar</field>
        <field name="arch" type="xml">
            <calendar date_start="reservation_date" date_stop="expiry_date" color="color" string="Library Reservation Calendar">
                <field name="reservation_state"/>
                <field name="member_id"/>
                <field name="book_id"/>
            </calendar>
        </field>
    </record>

    

    <!-- ============================================================
         Library Member Calendar
         ============================================================ -->
    <record id="edicai_library_member_calendar_view" model="ir.ui.view">
        <field name="name">edicai.library.member.calendar</field>
        <field name="model">edicai.library.member</field>
        <field name="type">calendar</field>
        <field name="arch" type="xml">
            <calendar date_start="registration_date" date_stop="valid_until" color="color" string="Library Member Calendar">
                <field name="member_state"/>
                <field name="member_type"/>
                <field name="student_id" widget="many2one_avatar"/>
                <field name="faculty_member_id"/>
            </calendar>
        </field>
    </record>

    

</odoo>
