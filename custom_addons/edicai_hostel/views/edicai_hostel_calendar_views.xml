<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Hostel Allocation Calendar View
         ============================================================ -->
    

    <record id="edicai_hostel_allocation_calendar_view" model="ir.ui.view">
        <field name="name">edicai.hostel.allocation.calendar</field>
        <field name="model">edicai.hostel.allocation</field>
        <field name="type">calendar</field>
        <field name="arch" type="xml">
            <calendar date_start="allocation_date" color="color" string="Hostel Allocation Calendar">
                <field name="student_id" widget="many2one_avatar"/>
                <field name="room_id"/>
                <field name="block_id"/>
                <field name="allocation_state"/>
            </calendar>
        </field>
    </record>

    <!-- ============================================================
         Hostel Maintenance Calendar View
         ============================================================ -->
    

    <record id="edicai_hostel_maintenance_calendar_view" model="ir.ui.view">
        <field name="name">edicai.hostel.maintenance.calendar</field>
        <field name="model">edicai.hostel.maintenance</field>
        <field name="type">calendar</field>
        <field name="arch" type="xml">
            <calendar date_start="request_date" date_stop="resolved_date" color="color" string="Hostel Maintenance Calendar">
                <field name="room_id"/>
                <field name="issue_type"/>
                <field name="priority"/>
                <field name="maintenance_state"/>
            </calendar>
        </field>
    </record>

</odoo>
