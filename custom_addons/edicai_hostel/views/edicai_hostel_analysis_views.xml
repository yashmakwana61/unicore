<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Hostel Allocation Analysis
         ============================================================ -->
    <record id="edicai_hostel_allocation_pivot_view" model="ir.ui.view">
        <field name="name">edicai.hostel.allocation.pivot</field>
        <field name="model">edicai.hostel.allocation</field>
        <field name="arch" type="xml">
            <pivot string="Hostel Allocation Analysis">
                <field name="allocation_state" type="row"/>
                <field name="total_hostel_fee" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="edicai_hostel_allocation_graph_view" model="ir.ui.view">
        <field name="name">edicai.hostel.allocation.graph</field>
        <field name="model">edicai.hostel.allocation</field>
        <field name="arch" type="xml">
            <graph string="Hostel Allocation Analysis" type="bar">
                <field name="block_id" type="row"/>
                <field name="total_hostel_fee" type="measure"/>
            </graph>
        </field>
    </record>

    

