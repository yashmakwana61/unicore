<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
  =====================================================
  SHARED NOTICE LIST CONTENT
  Renders `notices` recordset + `pager`.
  Called by the per-persona templates below.
  =====================================================
  -->
  <template id="oacis_notice_list_content"
            name="Oacis Notice List Content">
    <div class="container">

      <t t-if="notices">
        <div class="row g-3">
          <t t-foreach="notices" t-as="notice">
            <div class="col-12">
              <div class="card oacis-notice-card"
                   t-att-class="'border-primary' if notice.pinned else ''">
                <div class="card-header d-flex justify-content-between align-items-center bg-light">
                  <h5 class="mb-0">
                    <span t-if="notice.pinned" class="badge bg-primary me-2">
                      <i class="fa fa-thumb-tack"></i> Pinned
                    </span>
                    <t t-esc="notice.title"/>
                  </h5>
                  <span class="badge"
                        t-att-class="{
                          'bg-secondary': notice.notice_type == 'general',
                          'bg-info': notice.notice_type == 'academic',
                          'bg-warning text-dark': notice.notice_type == 'exam',
                          'bg-success': notice.notice_type == 'fee',
                          'bg-dark': notice.notice_type == 'event',
                        }">
                    <t t-esc="dict(notice._fields['notice_type'].selection).get(notice.notice_type)"/>
                  </span>
                </div>
                <div class="card-body">
                  <div t-out="notice.body" class="oacis-notice-body mb-2"/>
                  <p class="text-muted small mb-0">
                    <i class="fa fa-calendar"></i>
                    Published: <t t-esc="notice.publish_date"/>
                    <span t-if="notice.expiry_date">
                      | Valid until: <t t-esc="notice.expiry_date"/>
                    </span>
                    <span t-if="notice.publisher_id">
                      | By: <t t-esc="notice.publisher_id.name"/>
                    </span>
                  </p>
                </div>
              </div>
            </div>
          </t>
        </div>
        <div t-if="pager" class="o_portal_pager text-center mt-4">
          <t t-call="portal.pager"/>
        </div>
      </t>

      <t t-else="">
        <div class="alert alert-info text-center">
          <i class="fa fa-bullhorn"></i>
          No notices published at this time.
        </div>
      </t>

    </div>
  </template>

  <!--
  =====================================================
  STUDENT NOTICES
  =====================================================
  -->
  <template id="portal_student_notices"
            name="Student Portal Notices">
    <t t-call="oacis_portal_student.portal_student_layout">
      <h4 class="mb-3">Notice Board</h4>
      <t t-call="oacis_notice_board.oacis_notice_list_content"/>
    </t>
  </template>

  <!--
  =====================================================
  FACULTY NOTICES
  =====================================================
  -->
  <template id="portal_faculty_notices"
            name="Faculty Portal Notices">
    <t t-call="oacis_portal_faculty.portal_faculty_layout">
      <h4 class="mb-3">Notice Board</h4>
      <t t-call="oacis_notice_board.oacis_notice_list_content"/>
    </t>
  </template>

  <!--
  =====================================================
  GUARDIAN NOTICES
  =====================================================
  -->
  <template id="portal_guardian_notices"
            name="Guardian Portal Notices">
    <t t-call="oacis_portal_guardian.portal_guardian_layout">
      <h4 class="mb-3">Notice Board</h4>
      <t t-call="oacis_notice_board.oacis_notice_list_content"/>
    </t>
  </template>

</odoo>
