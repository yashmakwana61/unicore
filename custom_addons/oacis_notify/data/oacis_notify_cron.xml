<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

    <!-- Anonymize PII in old notification logs (GDPR/DPDP retention) -->
    <record id="cron_oacis_notify_anonymize_logs" model="ir.cron">
        <field name="name">Oacis: Anonymize Old Notification Logs</field>
        <field name="model_id" ref="model_oacis_notification_log"/>
        <field name="state">code</field>
        <field name="code">model.cron_anonymize_old_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    </data>
</odoo>
