<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_unicore_student_form_inherit_guardian" model="ir.ui.view">
    <field name="name">unicore.student.form.inherit.guardian</field>
    <field name="model">unicore.student</field>
    <field name="inherit_id" ref="unicore_student.unicore_student_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button id="stat_button_guardians" name="action_open_guardians" type="object" class="oe_stat_button" icon="fa-users">
          <field name="guardian_count" widget="statinfo" string="Guardians"/>
        </button>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page name="guardians" string="Guardians">
          <field name="guardian_rel_ids">
            <list editable="bottom">
              <field name="guardian_id"/>
              <field name="relationship_type"/>
              <field name="is_primary_guardian"/>
              <field name="is_financial_guarantor"/>
              <field name="can_view_academic_records"/>
              <field name="can_receive_notifications"/>
            </list>
          </field>
          <group>
            <field name="primary_guardian_id" readonly="1"/>
            <field name="financial_guarantor_id" readonly="1"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
