<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_oacis_guardian" model="ir.actions.act_window">
        <field name="name">Guardians</field>
        <field name="res_model">oacis.guardian</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record id="action_oacis_guardian_student_rel" model="ir.actions.act_window">
        <field name="name">Guardian-Student Relationships</field>
        <field name="res_model">oacis.guardian.student.rel</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_oacis_guardian_all"
              name="Guardians"
              parent="oacis_student.menu_oacis_student_root"
              action="action_oacis_guardian"
              sequence="40"/>

    <menuitem id="menu_oacis_guardian_student_rel"
              name="Guardian-Student Links"
              parent="oacis_student.menu_oacis_student_root"
              action="action_oacis_guardian_student_rel"
              sequence="50"
              groups="oacis_base.group_oacis_registrar"/>
