        <field name="name">Guardians</field>
        <field name="res_model">unicore.guardian</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record id="action_unicore_guardian_student_rel" model="ir.actions.act_window">
