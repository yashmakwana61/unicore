<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data noupdate="1">
    <record id="seq_oacis_transport_pass" model="ir.sequence">
      <field name="name">Transport Pass</field>
      <field name="code">oacis.transport.pass</field>
      <field name="prefix">TP/%(year)s/</field>
      <field name="padding">5</field>
      <field name="number_next">1</field>
      <field name="number_increment">1</field>
      <field name="company_id" eval="False"/>
    </record>
    <record id="seq_oacis_transport_trip" model="ir.sequence">
      <field name="name">Transport Trip Log</field>
      <field name="code">oacis.transport.trip</field>
      <field name="prefix">TL/%(year)s/</field>
      <field name="padding">5</field>
      <field name="number_next">1</field>
      <field name="number_increment">1</field>
      <field name="company_id" eval="False"/>
    </record>
  </data>
</odoo>
