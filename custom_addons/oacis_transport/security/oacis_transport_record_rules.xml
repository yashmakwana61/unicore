      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_oacis_transport_stop_company" model="ir.rule">
      <field name="name">Transport Stop: Company Isolation</field>
      <field name="model_id" ref="oacis_transport.model_oacis_transport_stop"/>
