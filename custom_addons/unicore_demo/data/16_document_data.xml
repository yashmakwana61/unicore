<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="uc_demo_doc_cat_academic" model="unicore.document.category">
      <field name="name">Academic Documents</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="category_type">institutional</field>
      <field name="sequence">10</field>
    </record>

    <record id="uc_demo_doc_cat_student" model="unicore.document.category">
      <field name="name">Student Documents</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="category_type">student</field>
      <field name="sequence">20</field>
    </record>

    <record id="uc_demo_doc_template_bonafide" model="unicore.document.template">
      <field name="name">Standard Bonafide Letter</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="template_type">bonafide</field>
      <field name="subject">Bonafide Certificate</field>
      <field name="body_html"><![CDATA[<p>This is to certify that {student_name} is a bona fide student of {institution_name}, enrolled in {program_name} for the academic year {academic_year}.</p>]]></field>
      <field name="is_active_template">True</field>
    </record>

    <record id="uc_demo_doc_calendar" model="unicore.document">
      <field name="name">Academic Calendar 2025-26</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="category_id" ref="uc_demo_doc_cat_academic"/>
      <field name="document_type">academic_calendar</field>
      <field name="upload_date">2025-07-01</field>
      <field name="document_state">active</field>
    </record>

    <record id="uc_demo_doc_policy" model="unicore.document">
      <field name="name">Attendance Policy 2025-26</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="category_id" ref="uc_demo_doc_cat_academic"/>
      <field name="document_type">policy</field>
      <field name="upload_date">2025-07-01</field>
      <field name="document_state">active</field>
    </record>
  </data>
</odoo>
