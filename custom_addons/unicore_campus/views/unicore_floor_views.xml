<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Window Action -->
    <record id="action_unicore_floor" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">unicore.floor</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <!-- Form View -->
    <record id="unicore_floor_form_view" model="ir.ui.view">
        <field name="name">unicore.floor.form</field>
        <field name="model">unicore.floor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_rooms" type="object"
                                class="oe_stat_button" icon="fa-door-open">
                            <field string="Rooms" name="room_count" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group name="left">
                            <field name="name"/>
                            <field name="floor_number"/>
                            <field name="building_id" options="{'no_create': True}"/>
                            <field name="campus_id"/>
                        </group>
                        <group name="right">
                            <field name="room_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="rooms" string="Rooms">
                            <field name="room_ids">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="room_type"/>
                                    <field name="capacity"/>
                                    <field name="room_state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="unicore_floor_list_view" model="ir.ui.view">
        <field name="name">unicore.floor.list</field>
        <field name="model">unicore.floor</field>
        <field name="arch" type="xml">
            <list>
                <field name="floor_number"/>
                <field name="name"/>
                <field name="building_id"/>
                <field name="campus_id"/>
                <field name="room_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="unicore_floor_search_view" model="ir.ui.view">
        <field name="name">unicore.floor.search</field>
        <field name="model">unicore.floor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="building_id"/>
                <field name="campus_id"/>
            </search>
        </field>
    </record>

</odoo>
