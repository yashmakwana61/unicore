<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_studio_user" model="res.groups">
            <field name="name">Studio User</field>
            <field name="comment">Can use Studio apps and launch AI previews</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_studio_builder" model="res.groups">
            <field name="name">Studio Builder</field>
            <field name="comment">Can create apps, models, fields, views, datasets, reports, dashboards</field>
            <field name="implied_ids" eval="[(4, ref('oacis_studio.group_studio_user'))]"/>
        </record>
        <record id="group_studio_admin" model="res.groups">
            <field name="name">Studio Admin</field>
            <field name="comment">Can publish, rollback, manage security, trigger registry rebuild</field>
            <field name="implied_ids" eval="[(4, ref('oacis_studio.group_studio_builder')), (4, ref('base.group_erp_manager'))]"/>
        </record>
    </data>
</odoo>
