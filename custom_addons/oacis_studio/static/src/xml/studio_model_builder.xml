<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
<t t-name="oacis_studio.StudioModelBuilder">
    <div class="h-100 d-flex flex-column" style="font-family:Inter,-apple-system,sans-serif; font-size:13px;">
        <div class="o_forge_header">
            <div class="o_forge_header_section o_forge_header_section--left">
                <button class="o_forge_btn o_forge_btn--ghost o_forge_btn--sm" t-on-click="() => this.action.doAction('oacis_studio.action_studio_home')"><i class="fa fa-arrow-left"/> Back</button>
                <div class="o_forge_separator"/><span class="o_forge_breadcrumb"><b>Create Application</b></span>
            </div>
            <div class="o_forge_header_section o_forge_header_section--right">
                <span class="o_forge_badge o_forge_badge--model" t-esc="'Step ' + state.step + ' / 2'"/>
            </div>
        </div>
        <div class="flex-grow-1 overflow-auto p-4" style="background:#f8fafc;">
            <div style="max-width:720px; margin:0 auto;">
                <t t-if="state.step === 1">
                    <div style="background:white; border:1px solid #e2e8f0; border-radius:12px; padding:24px;">
                        <h5 style="font-weight:700; margin:0 0 4px;">What do you want to build?</h5>
                        <p style="color:#64748b; font-size:12px; margin:0 0 16px;">Describe your application. Forge will propose models, fields, views, workflow, report and dashboard.</p>
                        <div class="row g-3">
                            <div class="col-8">
                                <div class="o_forge_prop_label">Application Name</div>
                                <input class="o_forge_prop_input" placeholder="e.g. Scholarship" t-att-value="state.appName" t-on-input="(ev)=>this.state.appName=ev.target.value" style="height:36px;"/>
                            </div>
                            <div class="col-4">
                                <div class="o_forge_prop_label">Key <a href="#" style="font-size:10px; font-weight:400;" t-on-click.prevent="useHint">use hint</a></div>
                                <input class="o_forge_prop_input" placeholder="scholarship" t-att-value="state.appKey" t-on-input="(ev)=>this.state.appKey=ev.target.value" style="height:36px;"/>
                            </div>
                        </div>
                        <div class="mt-3">
                            <div class="o_forge_prop_label">Describe your application <span style="font-weight:400; text-transform:none; letter-spacing:0;">— ✨ Generate with Forge</span></div>
                            <textarea class="o_forge_prop_textarea" style="min-height:88px;" t-on-input="(ev)=>this.state.prompt=ev.target.value" t-esc="state.prompt"/>
                        </div>
                        <t t-if="state.error"><div class="alert alert-danger mt-3" style="font-size:12px;" t-esc="state.error"/></t>
                        <div class="d-flex gap-2 justify-content-end mt-4">
                            <button class="o_forge_btn" t-on-click="() => this.action.doAction('oacis_studio.action_studio_app')">Cancel</button>
                            <button class="o_forge_btn o_forge_btn--accent" t-on-click="generate" t-att-disabled="state.loading">
                                <t t-if="state.loading"><i class="fa fa-spinner fa-spin me-1"/> Generating…</t>
                                <t t-else="">✨ Generate with Forge</t>
                            </button>
                        </div>
                        <div class="mt-3 p-3" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; font-size:11px; color:#64748b;">
                            <b>Technical editor remains available</b> in Settings → Models/Fields for Advanced/Developer mode.
                        </div>
                    </div>
                </t>
                <t t-if="state.step === 2">
                    <div style="background:white; border:1px solid #e2e8f0; border-radius:12px; padding:24px;">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <h5 style="font-weight:700; margin:0;">Forge proposes</h5>
                            <span class="o_forge_badge o_forge_badge--saved">Preview</span>
                        </div>
                        <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:12px;">
                            <t t-foreach="previewChecklist" t-as="item" t-key="item_index">
                                <div style="display:flex; align-items:center; gap:8px; padding:6px 0; font-size:12px; border-bottom:1px solid #f1f5f9;">
                                    <i class="fa fa-check" style="color:#10b981;"/>
                                    <span t-esc="item"/>
                                </div>
                            </t>
                            <t t-if="!previewChecklist.length"><div style="padding:12px; text-align:center; color:#94a3b8; font-size:12px;">No checklist returned — using DSL preview.</div></t>
                        </div>
                        <t t-if="state.dsl">
                            <div class="mt-3">
                                <div class="o_forge_prop_label">DSL Preview</div>
                                <pre class="bg-light p-2" style="max-height:240px; overflow:auto; font-size:10px; border-radius:4px; border:1px solid #e2e8f0;" t-esc="previewDslJson"/>
                            </div>
                        </t>
                        <div class="d-flex gap-2 justify-content-end mt-4">
                            <button class="o_forge_btn" t-on-click="() => this.state.step = 1">Back</button>
                            <button class="o_forge_btn" t-on-click="() => this.state.step = 1">Cancel</button>
                            <button class="o_forge_btn o_forge_btn--primary" t-on-click="create" t-att-disabled="state.loading">
                                <t t-if="state.loading"><i class="fa fa-spinner fa-spin me-1"/> Creating…</t>
                                <t t-else="">Create</t>
                            </button>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </div>
</t>
</templates>
