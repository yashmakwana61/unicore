<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
<t t-name="oacis_studio.ForgeCommandPalette">
    <t t-if="state.open">
        <div class="o_forge_dialog_overlay" t-on-click="() => this.state.open = false">
            <div class="o_forge_command_palette" t-on-click.stop="" style="background:white; border-radius:8px; box-shadow:0 8px 32px rgba(0,0,0,0.2); width:480px; max-width:90vw; padding:12px; position:fixed; top:20%; left:50%; transform:translateX(-50%); z-index:1060;">
                <div style="position:relative; margin-bottom:8px;">
                    <i class="fa fa-search" style="position:absolute; left:10px; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:12px;"/>
                    <input class="o_forge_prop_input" style="padding-left:28px; height:32px; width:100%;"
                           placeholder="Search Studio — Add field, Create report, Open security..."
                           t-att-value="state.query" t-on-input="onInput" autofocus="autofocus"/>
                </div>
                <div style="max-height:300px; overflow:auto;">
                    <t t-foreach="state.filtered" t-as="cmd" t-key="cmd.id">
                        <div class="o_forge_component_item" t-on-click="() => this.select(cmd)"
                             style="padding:6px 8px; border-radius:4px; cursor:pointer;">
                            <span t-esc="cmd.label" style="flex:1;"/>
                            <span style="font-size:10px; color:#94a3b8;" t-esc="cmd.id"/>
                        </div>
                    </t>
                    <t t-if="!state.filtered.length">
                        <div style="padding:12px; text-align:center; color:#94a3b8; font-size:12px;">
                            No match — try "report", "field", "security"
                        </div>
                    </t>
                </div>
                <div style="font-size:10px; color:#94a3b8; margin-top:8px; text-align:center;">
                    Ctrl+K to toggle · Enter to select
                </div>
            </div>
        </div>
    </t>
</t>
</templates>
