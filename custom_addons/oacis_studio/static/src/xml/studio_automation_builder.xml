<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
<t t-name="oacis_studio.StudioAutomationBuilder">
    <div class="h-100 d-flex flex-column" style="font-family:Inter,-apple-system,sans-serif; font-size:13px;">
        <!-- Header -->
        <div class="o_forge_header">
            <div class="o_forge_header_section o_forge_header_section--left">
                <button class="o_forge_btn o_forge_btn--ghost o_forge_btn--sm" t-on-click="() => this.action.doAction('oacis_studio.action_studio_home')">
                    <i class="fa fa-arrow-left"/> Back
                </button>
                <div class="o_forge_separator"/>
                <span class="o_forge_breadcrumb"><b>Automation Builder</b></span>
            </div>
            <div class="o_forge_header_section o_forge_header_section--right">
                <button class="o_forge_btn o_forge_btn--primary o_forge_btn--sm" t-on-click="showNew">
                    <i class="fa fa-plus"/> New Automation
                </button>
            </div>
        </div>

        <!-- Content -->
        <div class="d-flex flex-grow-1 overflow-hidden" style="min-height:0;">
            <!-- Left: Automation list -->
            <div class="o_forge_sidebar" style="width:240px;">
                <div class="o_forge_sidebar_search" style="padding:8px;">
                    <div class="o_forge_props_title" style="font-size:12px; font-weight:600; padding:4px 0;">Automations</div>
                </div>
                <div class="o_forge_sidebar_content">
                    <t t-foreach="state.automations" t-as="auto" t-key="auto.id">
                        <div class="o_forge_component_item"
                             t-att-class="state.selectedAutomation === auto ? 'active' : ''"
                             t-on-click="() => this.selectAutomation(auto)">
                            <i class="fa fa-bolt" style="color:#f59e0b;"/>
                            <span class="o_forge_component_label" t-esc="auto.name"/>
                            <span class="o_forge_badge" t-att-class="auto.active ? 'o_forge_badge--saved' : 'o_forge_badge--dirty'" t-esc="auto.active ? 'Active' : 'Off'"/>
                        </div>
                    </t>
                    <t t-if="!state.automations.length">
                        <div class="p-3 text-center" style="font-size:11px; color:#94a3b8;">
                            No automations yet. Click "New Automation" to start.
                        </div>
                    </t>
                </div>
            </div>

            <!-- Center: Visual builder or empty state -->
            <div class="flex-grow-1 overflow-auto p-4" style="background:#f8fafc;">
                <!-- New Automation form -->
                <t t-if="state.showNewForm">
                    <div style="max-width:720px; margin:0 auto;">
                        <h5 style="font-weight:600; margin-bottom:16px;">
                            <i class="fa fa-bolt me-2" style="color:#f59e0b;"/>New Automation
                        </h5>

                        <!-- Name -->
                        <div class="o_forge_prop_group mb-3">
                            <div class="o_forge_prop_label">Automation Name</div>
                            <input class="o_forge_prop_input" placeholder="e.g., Low Attendance Alert" t-att-value="state.newAutomation.name" t-on-input="(ev) => this.state.newAutomation.name = ev.target.value"/>
                        </div>

                        <!-- ═══ WHEN ═══ -->
                        <div style="background:white; border:1px solid #e2e8f0; border-radius:6px; padding:16px; margin-bottom:12px;">
                            <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
                                <span style="background:#714B67; color:white; padding:2px 8px; border-radius:4px; font-size:11px; font-weight:600;">WHEN</span>
                                <span style="font-size:12px; color:#64748b;">Something happens in the system</span>
                            </div>
                            <select class="o_forge_prop_select" t-on-change="(ev) => this.state.newAutomation.trigger = ev.target.value">
                                <t t-foreach="[{value:'create',label:'Record is created'},{value:'write',label:'Record is updated'},{value:'create_or_write',label:'Record is created or updated'},{value:'unlink',label:'Record is deleted'},{value:'cron',label:'On a schedule'},{value:'button',label:'Button click'}]" t-as="opt" t-key="opt.value">
                                    <option t-att-value="opt.value" t-att-selected="state.newAutomation.trigger === opt.value ? 'selected' : null" t-esc="opt.label"/>
                                </t>
                            </select>
                        </div>

                        <!-- ═══ IF (Conditions) ═══ -->
                        <div style="background:white; border:1px solid #e2e8f0; border-radius:6px; padding:16px; margin-bottom:12px;">
                            <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
                                <span style="background:#f59e0b; color:white; padding:2px 8px; border-radius:4px; font-size:11px; font-weight:600;">IF</span>
                                <span style="font-size:12px; color:#64748b;">Conditions are met</span>
                                <button class="o_forge_btn o_forge_btn--ghost o_forge_btn--sm" t-on-click="addCondition" style="margin-left:auto;">
                                    <i class="fa fa-plus"/> Add Condition
                                </button>
                            </div>
                            <t t-foreach="state.newAutomation.conditions" t-as="cond" t-key="cond_index">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <!-- Sentence: [field] [operator] [value] -->
                                    <select class="o_forge_prop_select" style="width:160px;" t-on-change="(ev) => cond.field = ev.target.value">
                                        <t t-foreach="[{value:'attendance_pct',label:'Attendance Percentage'},{value:'fee_balance',label:'Fee Balance'},{value:'status',label:'Status'},{value:'admission_date',label:'Admission Date'},{value:'grade',label:'Grade'}]" t-as="f" t-key="f.value">
                                            <option t-att-value="f.value" t-att-selected="cond.field === f.value ? 'selected' : null" t-esc="f.label"/>
                                        </t>
                                    </select>
                                    <select class="o_forge_prop_select" style="width:140px;" t-on-change="(ev) => cond.operator = ev.target.value">
                                        <t t-foreach="[{value:'less_than',label:'is less than'},{value:'greater_than',label:'is greater than'},{value:'equals',label:'equals'},{value:'not_equals',label:'does not equal'},{value:'contains',label:'contains'},{value:'is_set',label:'is set'}]" t-as="op" t-key="op.value">
                                            <option t-att-value="op.value" t-att-selected="cond.operator === op.value ? 'selected' : null" t-esc="op.label"/>
                                        </t>
                                    </select>
                                    <input class="o_forge_prop_input" style="width:100px;" placeholder="value" t-att-value="cond.value" t-on-input="(ev) => cond.value = ev.target.value"/>
                                    <button class="o_forge_btn o_forge_btn--danger o_forge_btn--icon-sm" t-on-click="() => this.removeCondition(cond_index)">
                                        <i class="fa fa-times"/>
                                    </button>
                                </div>
                            </t>
                        </div>

                        <!-- ═══ THEN (Actions) ═══ -->
                        <div style="background:white; border:1px solid #e2e8f0; border-radius:6px; padding:16px; margin-bottom:16px;">
                            <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
                                <span style="background:#10b981; color:white; padding:2px 8px; border-radius:4px; font-size:11px; font-weight:600;">THEN</span>
                                <span style="font-size:12px; color:#64748b;">Take these actions</span>
                                <button class="o_forge_btn o_forge_btn--ghost o_forge_btn--sm" t-on-click="addAction" style="margin-left:auto;">
                                    <i class="fa fa-plus"/> Add Action
                                </button>
                            </div>
                            <t t-foreach="state.newAutomation.actions" t-as="act" t-key="act_index">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <select class="o_forge_prop_select" style="width:160px;" t-on-change="(ev) => act.type = ev.target.value">
                                        <t t-foreach="[{value:'send_notification',label:'Send Notification'},{value:'send_email',label:'Send Email'},{value:'create_activity',label:'Create Activity'},{value:'update_record',label:'Update Record'},{value:'create_record',label:'Create Record'},{value:'webhook',label:'Webhook'},{value:'generate_report',label:'Generate Report'}]" t-as="a" t-key="a.value">
                                            <option t-att-value="a.value" t-att-selected="act.type === a.value ? 'selected' : null" t-esc="a.label"/>
                                        </t>
                                    </select>
                                    <select class="o_forge_prop_select" style="width:120px;" t-on-change="(ev) => act.recipient = ev.target.value">
                                        <t t-foreach="[{value:'teacher',label:'Teacher'},{value:'parent',label:'Parent'},{value:'principal',label:'Principal'},{value:'admin',label:'Administrator'},{value:'student',label:'Student'}]" t-as="r" t-key="r.value">
                                            <option t-att-value="r.value" t-att-selected="act.recipient === r.value ? 'selected' : null" t-esc="r.label"/>
                                        </t>
                                    </select>
                                    <input class="o_forge_prop_input" style="flex:1;" placeholder="Message..." t-att-value="act.message" t-on-input="(ev) => act.message = ev.target.value"/>
                                    <button class="o_forge_btn o_forge_btn--danger o_forge_btn--icon-sm" t-on-click="() => this.removeAction(act_index)">
                                        <i class="fa fa-times"/>
                                    </button>
                                </div>
                            </t>
                        </div>

                        <!-- Preview sentence -->
                        <div style="background:#f5f3ff; border:1px solid #c4b5fd; border-radius:6px; padding:12px 16px; margin-bottom:16px;">
                            <div style="font-size:12px; font-weight:600; color:#5b21b6; margin-bottom:4px;">Automation Preview</div>
                            <div style="font-size:13px; color:#1e293b;">
                                <b>WHEN</b> <span t-esc="triggerLabel"/>
                                <b>IF</b>
                                <t t-foreach="state.newAutomation.conditions" t-as="cond" t-key="cond_index">
                                    <t t-if="cond_index > 0"> AND </t>
                                    <span t-esc="cond.field"/> <span t-esc="cond.operator"/> <b t-esc="cond.value || '...'"/>
                                </t>
                                <b>THEN</b>
                                <t t-foreach="state.newAutomation.actions" t-as="act" t-key="act_index">
                                    <t t-if="act_index > 0">, </t>
                                    <span t-esc="act.type"/> to <span t-esc="act.recipient || '...'"/>
                                </t>
                            </div>
                        </div>

                        <!-- Save -->
                        <div class="d-flex gap-2">
                            <button class="o_forge_btn o_forge_btn--primary" t-on-click="saveAutomation">
                                <i class="fa fa-check me-1"/> Create Automation
                            </button>
                            <button class="o_forge_btn" t-on-click="() => this.state.showNewForm = false">Cancel</button>
                        </div>
                    </div>
                </t>

                <!-- Empty state -->
                <t t-if="!state.showNewForm &amp;&amp; !state.selectedAutomation">
                    <div class="d-flex align-items-center justify-content-center h-100">
                        <div class="text-center" style="max-width:400px;">
                            <div style="font-size:48px; margin-bottom:12px;">⚡</div>
                            <h5 style="font-weight:600;">Automation Builder</h5>
                            <p style="color:#64748b; font-size:13px;">
                                Create visual automations using a simple sentence builder.
                                WHEN something happens → IF conditions are met → THEN take action.
                            </p>
                            <button class="o_forge_btn o_forge_btn--primary mt-2" t-on-click="showNew">
                                <i class="fa fa-plus me-1"/> New Automation
                            </button>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </div>
</t>
</templates>
