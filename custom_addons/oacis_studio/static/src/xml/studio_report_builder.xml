<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
<t t-name="oacis_studio.StudioReportBuilder">
    <div class="o_studio_report_builder h-100 d-flex flex-column" style="font-family:Inter,-apple-system,sans-serif; font-size:13px;">
        <!-- Header -->
        <div class="o_forge_header">
            <div class="o_forge_header_section o_forge_header_section--left">
                <button class="o_forge_btn o_forge_btn--ghost o_forge_btn--sm" t-on-click="() => this.action.doAction('oacis_studio.action_studio_home')">
                    <i class="fa fa-arrow-left"/> Back
                </button>
                <div class="o_forge_separator"/>
                <span class="o_forge_breadcrumb"><b>Report Builder</b> <span class="sep">▸</span> <t t-esc="state.reportName"/></span>
            </div>
            <div class="o_forge_header_section o_forge_header_section--right">
                <button class="o_forge_btn o_forge_btn--sm" t-att-class="state.showJson ? 'active' : ''" t-on-click="() => this.state.showJson = !state.showJson">
                    <i class="fa fa-code"/> JSON
                </button>
                <button class="o_forge_btn o_forge_btn--sm" t-on-click="previewPdf"><i class="fa fa-eye"/> Preview PDF</button>
                <button class="o_forge_btn o_forge_btn--sm" t-on-click="bulkGenerate"><i class="fa fa-files-o"/> Bulk</button>
                <button class="o_forge_btn o_forge_btn--primary o_forge_btn--sm" t-on-click="save">
                    <i class="fa fa-save"/> Save
                </button>
            </div>
        </div>

        <!-- 3-pane layout -->
        <div class="d-flex flex-grow-1 overflow-hidden" style="min-height:0;">
            <!-- Left: Component palette -->
            <div class="o_forge_sidebar" style="width:200px;">
                <div class="o_forge_sidebar_content">
                    <t t-foreach="REPORT_COMPONENTS" t-as="section" t-key="section.section">
                        <div class="o_forge_sidebar_section">
                            <div class="o_forge_sidebar_section_header" t-on-click="() => this.toggleSection(section.section)">
                                <span class="title" t-esc="section.section"/>
                                <i t-att-class="'fa fa-chevron-down chevron ' + (isSectionCollapsed(section.section) ? 'collapsed' : '')" style="font-size:10px; color:#94a3b8;"/>
                            </div>
                            <t t-if="!isSectionCollapsed(section.section)">
                                <t t-foreach="section.items" t-as="comp" t-key="comp.type">
                                    <div class="o_forge_component_item" t-on-click="() => this.addComponent(comp.type)">
                                        <i t-att-class="'fa ' + comp.icon"/>
                                        <span class="o_forge_component_label" t-esc="comp.label"/>
                                    </div>
                                </t>
                            </t>
                        </div>
                    </t>

                    <div class="o_forge_sidebar_section">
                        <div class="o_forge_sidebar_section_header">
                            <span class="title">Fields</span>
                            <span class="count" t-esc="state.fields.length"/>
                        </div>
                        <t t-foreach="state.fields" t-as="fld" t-key="fld.key">
                            <div class="o_forge_field_item" t-on-click="() => this.addFieldToBand(fld)">
                                <span class="o_forge_field_ttype">Aa</span>
                                <span class="o_forge_field_name" t-esc="fld.label"/>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Center: A4 page -->
            <div class="flex-grow-1 overflow-auto p-4" style="background:#f1f5f9;">
                <div style="width:794px; min-height:1123px; margin:0 auto; background:white; box-shadow:0 2px 8px rgba(0,0,0,0.1); padding:48px 56px; font-family:Arial;">
                    <!-- Band tabs -->
                    <div class="d-flex gap-1 mb-3">
                        <button class="o_forge_btn o_forge_btn--sm" t-att-class="state.selectedBand === 'header' ? 'active' : ''" t-on-click="() => this.selectBand('header')">Header</button>
                        <button class="o_forge_btn o_forge_btn--sm" t-att-class="state.selectedBand === 'body' ? 'active' : ''" t-on-click="() => this.selectBand('body')">Body</button>
                        <button class="o_forge_btn o_forge_btn--sm" t-att-class="state.selectedBand === 'footer' ? 'active' : ''" t-on-click="() => this.selectBand('footer')">Footer</button>
                    </div>

                    <!-- Live preview -->
                    <div t-out="state.previewHtml"/>
                </div>
            </div>

            <!-- Right: Properties / JSON -->
            <div class="o_forge_properties" style="width:280px;">
                <div class="o_forge_props_header">
                    <span class="o_forge_props_title">Report Properties</span>
                </div>
                <div class="o_forge_props_content">
                    <!-- Selected component props -->
                    <t t-if="state.selectedComponent">
                        <div class="o_forge_prop_group">
                            <div class="o_forge_prop_label">Component Type</div>
                            <input class="o_forge_prop_input" t-att-value="state.selectedComponent.type" readonly="readonly"/>
                        </div>
                        <t t-if="state.selectedComponent.type === 'field'">
                            <div class="o_forge_prop_group">
                                <div class="o_forge_prop_label">Field Path</div>
                                <input class="o_forge_prop_input" t-att-value="state.selectedComponent.path" t-on-input="(ev) => this.updateComponentProp(state.selectedComponent, 'path', ev.target.value)"/>
                            </div>
                            <div class="o_forge_prop_group">
                                <div class="o_forge_prop_label">Label</div>
                                <input class="o_forge_prop_input" t-att-value="state.selectedComponent.label" t-on-input="(ev) => this.updateComponentProp(state.selectedComponent, 'label', ev.target.value)"/>
                            </div>
                        </t>
                        <t t-if="state.selectedComponent.type === 'text'">
                            <div class="o_forge_prop_group">
                                <div class="o_forge_prop_label">Content</div>
                                <textarea class="o_forge_prop_textarea" t-on-input="(ev) => this.updateComponentProp(state.selectedComponent, 'value', ev.target.value)" t-esc="state.selectedComponent.value"/>
                            </div>
                        </t>
                    </t>

                    <t t-if="!state.selectedComponent">
                        <div class="o_forge_props_empty">
                            <i class="fa fa-file-pdf-o"/>
                            <p>Report content editor</p>
                            <p style="font-size:11px;">Click a band (Header/Body/Footer) to edit. Click components in the palette to add.</p>
                        </div>
                    </t>

                    <!-- JSON view -->
                    <t t-if="state.showJson">
                        <div class="mt-3">
                            <div class="o_forge_prop_label">Layout JSON</div>
                            <pre class="bg-light p-2" style="max-height:400px; overflow:auto; font-size:10px; border-radius:4px; border:1px solid #e2e8f0;" t-esc="layoutJson"/>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </div>
</t>
</templates>
