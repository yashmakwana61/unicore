<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_studio_record_list" model="ir.ui.view">
        <field name="name">studio.record.list</field>
        <field name="model">studio.record</field>
        <field name="arch" type="xml">
            <list string="Studio Runtime Records (JSONB)">
                <field name="app_id"/>
                <field name="model_id"/>
                <field name="name"/>
                <field name="state" widget="badge" decoration-success="state=='approved'" decoration-warning="state=='draft'"/>
                <field name="values_json" widget="ace" options="{'mode':'json'}" optional="hide"/>
                <field name="campus_id" optional="hide"/>
                <field name="create_date"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_studio_record_form" model="ir.ui.view">
        <field name="name">studio.record.form</field>
        <field name="model">studio.record</field>
        <field name="arch" type="xml">
            <form string="Runtime Record">
                <header><field name="state" widget="statusbar" options="{'clickable':'1'}"/></header>
                <sheet>
                    <div class="alert alert-light" role="alert">
                        Phase 2 Hybrid Runtime — values stored as <code>values_json</code> JSONB (no registry reload). For <b>many2one</b> put integer ID in JSON, e.g. <code>{"student_id": 123, "amount": 5000}</code>. Required fields validated per <code>studio.field</code>.
                    </div>
                    <group>
                        <field name="app_id" options="{'no_create': True}" readonly="1"/>
                        <field name="model_id" options="{'no_create': True, 'no_open': True}" domain="[('app_id','=',app_id)]"/>
                        <field name="name" readonly="1"/>
                        <field name="state"/>
                        <field name="campus_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Values (JSONB) — Dynamic Fields">
                        <field name="values_json" widget="ace" options="{'mode':'json'}" nolabel="1" placeholder='{"name": "Scholarship A", "student_id": 1, "amount": 10000}'/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Tip: Use <b>Data Dictionary</b> to discover <code>oacis.student</code> IDs. Future Phase 3 will render true form widgets from <code>studio.field</code> palette.
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                    <field name="activity_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_studio_record_search" model="ir.ui.view">
        <field name="name">studio.record.search</field>
        <field name="model">studio.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="app_id"/>
                <field name="model_id"/>
                <field name="state"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
            </search>
        </field>
    </record>
    <record id="action_studio_record" model="ir.actions.act_window">
        <field name="name">Studio Records</field>
        <field name="res_model">studio.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
