<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_studio_dd_list" model="ir.ui.view">
        <field name="name">studio.data.dictionary.list</field>
        <field name="model">studio.data.dictionary</field>
        <field name="arch" type="xml">
            <list>
                <field name="model_technical"/>
                <field name="field_technical"/>
                <field name="field_label" optional="hide"/>
                <field name="ttype"/>
                <field name="relation" optional="hide"/>
                <field name="tags" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_studio_dd_search" model="ir.ui.view">
        <field name="name">studio.data.dictionary.search</field>
        <field name="model">studio.data.dictionary</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_technical"/>
                <field name="field_technical"/>
                <field name="ttype"/>
                <filter string="Models" name="models" domain="[('ttype','=','model')]"/>
                <separator/>
                <filter string="oacis" name="oacis" domain="[('model_technical','like','oacis.%')]"/>
                <filter string="Studio" name="studio" domain="[('is_studio','=',True)]"/>
            </search>
        </field>
    </record>
    <record id="action_studio_dd" model="ir.actions.act_window">
        <field name="name">Data Dictionary</field>
        <field name="res_model">studio.data.dictionary</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
