<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_unicore_transport_pass_form"
          model="ir.ui.view">
    <field name="name">unicore.transport.pass.form</field>
    <field name="model">unicore.transport.pass</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_suspend"
            string="Suspend Pass"
            type="object"
            invisible="pass_state != 'active'"
            groups="unicore_base.group_unicore_admin"/>
          <button name="action_reactivate"
            string="Reactivate"
            type="object"
            invisible="pass_state != 'suspended'"
            class="btn-primary"/>
          <button name="action_cancel"
            string="Cancel Pass"
            type="object"
            invisible="pass_state in
              ('cancelled','expired')"
            groups="unicore_base.group_unicore_admin"/>
          <button name="action_mark_fee_paid"
            string="Mark Fee Paid"
            type="object"
            invisible="fee_paid"
            class="btn-success"
            groups="unicore_base.group_unicore_staff"/>
          <field name="pass_state"
            widget="statusbar"
            statusbar_visible="active,suspended,
              cancelled"/>
        </header>
        <sheet>
          <widget name="web_ribbon"
            title="ACTIVE"
            invisible="pass_state != 'active'"
            bg_color="text-bg-success"/>
          <widget name="web_ribbon"
            title="FEE PENDING"
            invisible="fee_paid or
              pass_state != 'active'"
            bg_color="text-bg-warning"/>
          <widget name="web_ribbon"
            title="EXPIRED"
            invisible="not is_expired"
            bg_color="text-bg-secondary"/>
          <group>
            <group string="Pass Details">
              <field name="pass_number"
                     readonly="1"/>
              <field name="student_id"/>
              <field name="route_id"/>
              <field name="vehicle_id"
                     readonly="1"/>
              <field name="boarding_stop_id"/>
              <field name="company_id"/>
            </group>
            <group string="Validity and Fees">
              <field name="academic_year_id"/>
              <field name="semester_id"/>
              <field name="valid_from"/>
              <field name="valid_until"/>
              <field name="is_expired" readonly="1"/>
              <field name="transport_fee"/>
              <field name="fee_paid"/>
              <field name="fee_paid_date"
                     readonly="1"/>
              <field name="payment_reference"/>
            </group>
          </group>
          <group string="Emergency Contact">
            <group>
              <field name="emergency_contact"/>
              <field name="emergency_mobile"/>
            </group>
          </group>
          <group string="Notes">
            <field name="notes" nolabel="1"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_unicore_transport_pass_list"
          model="ir.ui.view">
    <field name="name">unicore.transport.pass.list</field>
    <field name="model">unicore.transport.pass</field>
    <field name="arch" type="xml">
      <list decoration-success=
              "pass_state == 'active' and fee_paid"
            decoration-warning=
              "pass_state == 'active' and
               not fee_paid"
            decoration-muted=
              "pass_state in
              ('cancelled','expired')">
        <field name="pass_number"/>
        <field name="student_id"/>
        <field name="route_id"/>
        <field name="boarding_stop_id"/>
        <field name="vehicle_id"/>
        <field name="valid_from"/>
        <field name="valid_until"/>
        <field name="transport_fee"/>
        <field name="fee_paid"/>
        <field name="pass_state"/>
      </list>
    </field>
  </record>

  <record id="view_unicore_transport_pass_search"
          model="ir.ui.view">
    <field name="name">unicore.transport.pass.search</field>
    <field name="model">unicore.transport.pass</field>
    <field name="arch" type="xml">
      <search>
        <field name="pass_number"/>
        <field name="student_id"/>
        <field name="route_id"/>
        <filter name="active" string="Active Passes"
          domain="[('pass_state','=','active')]"/>
        <filter name="fee_pending"
          string="Fee Pending"
          domain="[('fee_paid','=',False),('pass_state','=','active')]"/>
        <filter name="expired" string="Expired"
          domain="[('is_expired','=',True)]"/>
        <group name="group_by">
          <filter name="group_by_route"
            string="Route"
            context="{'group_by':'route_id'}"/>
          <filter name="group_by_vehicle"
            string="Vehicle"
            context="{'group_by':'vehicle_id'}"/>
          <filter name="group_by_state"
            string="Status"
            context="{'group_by':'pass_state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_unicore_transport_pass"
          model="ir.actions.act_window">
    <field name="name">Transport Passes</field>
    <field name="res_model">unicore.transport.pass</field>
    <field name="view_mode">list,form</field>
    <field name="context">
      {'search_default_active': 1}
    </field>
  </record>

  <record id="action_unicore_transport_fee_pending"
          model="ir.actions.act_window">
    <field name="name">Fee Pending Passes</field>
    <field name="res_model">unicore.transport.pass</field>
    <field name="view_mode">list,form</field>
    <field name="domain">
      [('fee_paid','=',False),
       ('pass_state','=','active')]
    </field>
  </record>

</odoo>
