<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_unicore_transport_vehicle_form"
          model="ir.ui.view">
    <field name="name">unicore.transport.vehicle.form</field>
    <field name="model">unicore.transport.vehicle</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="vehicle_state"
            widget="statusbar"
            statusbar_visible="active,maintenance"/>
        </header>
        <sheet>
          <widget name="web_ribbon"
            title="Maintenance"
            invisible="vehicle_state != 'maintenance'"
            bg_color="text-bg-warning"/>
          <widget name="web_ribbon"
            title="Retired"
            invisible="vehicle_state != 'retired'"
            bg_color="text-bg-secondary"/>
          <widget name="web_ribbon"
            title="Insurance Expiring"
            invisible="not is_insurance_expiring"
            bg_color="text-bg-danger"/>
          <div class="oe_button_box"
               name="button_box">
            <button class="oe_stat_button"
                    icon="fa-road"
                    type="object"
                    name="action_view_routes">
              <field name="route_count"
                     widget="statinfo"
                     string="Routes"/>
            </button>
            <button class="oe_stat_button"
                    icon="fa-ticket"
                    type="object"
                    name="action_view_passes">
              <field name="current_pass_count"
                     widget="statinfo"
                     string="Active Passes"/>
            </button>
          </div>
          <group>
            <group string="Vehicle Identity">
              <field name="name"/>
              <field name="registration_number"/>
              <field name="vehicle_type"/>
              <field name="make"/>
              <field name="model_name"/>
              <field name="manufacture_year"/>
              <field name="color"/>
              <field name="seating_capacity"/>
              <field name="fuel_type"/>
              <field name="company_id"/>
              <field name="campus_id"/>
            </group>
            <group string="Driver Details">
              <field name="driver_name"/>
              <field name="driver_license"/>
              <field name="driver_mobile"/>
              <field name="conductor_name"/>
              <field name="conductor_mobile"/>
            </group>
          </group>
          <group string="Compliance Documents">
            <group>
              <field name="insurance_policy"/>
              <field name="insurance_expiry"/>
              <field name="days_to_insurance_expiry"
                     readonly="1"/>
              <field name="fitness_expiry"/>
              <field name="days_to_fitness_expiry"
                     readonly="1"/>
            </group>
            <group>
              <field name="permit_expiry"/>
              <field name="puc_expiry"/>
            </group>
          </group>
          <group string="Notes">
            <field name="notes" nolabel="1"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_unicore_transport_vehicle_list"
          model="ir.ui.view">
    <field name="name">unicore.transport.vehicle.list</field>
    <field name="model">unicore.transport.vehicle</field>
    <field name="arch" type="xml">
      <list decoration-success=
              "vehicle_state == 'active'"
            decoration-warning=
              "vehicle_state == 'maintenance'
              or is_insurance_expiring
              or is_fitness_expiring"
            decoration-muted=
              "vehicle_state in
              ('retired','breakdown')">
        <field name="name"/>
        <field name="registration_number"/>
        <field name="vehicle_type"/>
        <field name="seating_capacity"/>
        <field name="driver_name"/>
        <field name="insurance_expiry"/>
        <field name="fitness_expiry"/>
        <field name="is_insurance_expiring"/>
        <field name="current_pass_count"/>
        <field name="vehicle_state"/>
      </list>
    </field>
  </record>

  <record id="action_unicore_transport_vehicle"
          model="ir.actions.act_window">
    <field name="name">Vehicles</field>
    <field name="res_model">unicore.transport.vehicle</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="action_unicore_transport_vehicle_expiring"
          model="ir.actions.act_window">
    <field name="name">Expiring Documents</field>
    <field name="res_model">unicore.transport.vehicle</field>
    <field name="view_mode">list,form</field>
    <field name="domain">
      [('vehicle_state','=','active')]
    </field>
    <field name="context">
      {'search_default_expiring': 1}
    </field>
  </record>

</odoo>
