<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_unicore_transport_route_form"
          model="ir.ui.view">
    <field name="name">unicore.transport.route.form</field>
    <field name="model">unicore.transport.route</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="route_state"
            widget="statusbar"
            statusbar_visible="active,suspended"/>
        </header>
        <sheet>
          <widget name="web_ribbon"
            title="Active"
            invisible="route_state != 'active'"
            bg_color="text-bg-success"/>
          <widget name="web_ribbon"
            title="Suspended"
            invisible="route_state != 'suspended'"
            bg_color="text-bg-warning"/>
          <div class="oe_button_box"
               name="button_box">
            <button type="object"
              name="action_view_passes"
              class="oe_stat_button"
              icon="fa-ticket">
              <field name="active_pass_count"
                     widget="statinfo"
                     string="Active Passes"/>
            </button>
            <button class="oe_stat_button"
                    icon="fa-map-pin"
                    type="object"
                    name="action_view_passes">
              <field name="stop_count"
                     widget="statinfo"
                     string="Stops"/>
            </button>
          </div>
          <group>
            <group string="Route Details">
              <field name="name"/>
              <field name="code"/>
              <field name="company_id"/>
              <field name="campus_id"/>
              <field name="vehicle_id"/>
              <field name="direction"/>
            </group>
            <group string="Timing and Distance">
              <field name="morning_departure_time"
                     widget="float_time"/>
              <field name="morning_arrival_time"
                     widget="float_time"/>
              <field name="evening_departure_time"
                     widget="float_time"/>
              <field name="total_distance_km"/>
              <field name="estimated_duration_minutes"/>
              <field name="fee_per_semester"/>
            </group>
          </group>
          <notebook>
            <page string="Stops">
              <field name="stop_ids">
                <list editable="bottom">
                  <field name="sequence"
                         widget="handle"/>
                  <field name="name"/>
                  <field name="area"/>
                  <field name="landmark"/>
                  <field name="pickup_time"
                         widget="float_time"/>
                  <field name="distance_from_campus_km"/>
                  <field name="stop_fee"/>
                  <field name="is_active"/>
                </list>
              </field>
            </page>
            <page string="Notes">
              <field name="notes" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_unicore_transport_route_list"
          model="ir.ui.view">
    <field name="name">unicore.transport.route.list</field>
    <field name="model">unicore.transport.route</field>
    <field name="arch" type="xml">
      <list decoration-success=
              "route_state == 'active'"
            decoration-warning=
              "route_state == 'suspended'"
            decoration-muted=
              "route_state == 'discontinued'">
        <field name="code"/>
        <field name="name"/>
        <field name="vehicle_id"/>
        <field name="direction"/>
        <field name="stop_count"/>
        <field name="active_pass_count"/>
        <field name="morning_departure_time"
               widget="float_time"/>
        <field name="total_distance_km"/>
        <field name="fee_per_semester"/>
        <field name="route_state"/>
      </list>
    </field>
  </record>

  <record id="action_unicore_transport_route"
          model="ir.actions.act_window">
    <field name="name">Transport Routes</field>
    <field name="res_model">unicore.transport.route</field>
    <field name="view_mode">list,form</field>
    <field name="domain">
      [('route_state','=','active')]
    </field>
  </record>

</odoo>
