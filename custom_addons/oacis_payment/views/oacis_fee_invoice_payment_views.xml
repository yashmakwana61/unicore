<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Backend: Payment Link button + Online Payments smart button -->
    <record id="view_unicore_fee_invoice_payment_ext_form"
            model="ir.ui.view">
        <field name="name">unicore.fee.invoice.form.online.payment</field>
        <field name="model">unicore.fee.invoice</field>
        <field name="inherit_id" ref="unicore_fees.view_unicore_fee_invoice_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_payment_link"
                        string="Payment Link"
                        type="object"
                        class="btn-secondary"
                        groups="unicore_base.group_unicore_admin,unicore_base.group_unicore_finance"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_online_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        invisible="payment_tx_count == 0">
                    <field name="payment_tx_count" widget="statinfo"/>
                    <span class="o_stat_text">Online Payments</span>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
