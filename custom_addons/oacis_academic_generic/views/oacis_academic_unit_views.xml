<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== ACADEMIC UNIT LIST VIEW ==================== -->
    <record id="oacis_academic_unit_view_tree" model="ir.ui.view">
        <field name="name">oacis.academic.unit.tree</field>
        <field name="model">oacis.academic.unit</field>
        <field name="arch" type="xml">
            <list string="Academic Units" default_order="sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="name" class="fw-bold"/>
                <field name="code"/>
                <field name="unit_type_id" widget="badge"/>
                <field name="parent_id"/>
                <field name="head_user_id" widget="many2one_avatar" optional="show"/>
                <field name="unit_count" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ==================== ACADEMIC UNIT FORM VIEW ==================== -->
    <record id="oacis_academic_unit_view_form" model="ir.ui.view">
        <field name="name">oacis.academic.unit.form</field>
        <field name="model">oacis.academic.unit</field>
        <field name="arch" type="xml">
            <form string="Academic Unit">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_children" type="object" class="oe_stat_button" icon="fa-sitemap" invisible="unit_count == 0">
                            <field name="unit_count" widget="statinfo" string="Sub-Units"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Unit Name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Faculty of Science / Grade 10 / Batch 2026"/></h1>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <field name="code" placeholder="CODE" class="fw-bold text-muted"/>
                            <field name="unit_type_id" widget="badge"/>
                        </div>
                    </div>
                    <group>
                        <group name="hierarchy" string="Structure &amp; Hierarchy">
                            <field name="unit_type_id" options="{'no_create_edit': True}"/>
                            <field name="parent_id" options="{'no_create_edit': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="leadership" string="Leadership &amp; Order">
                            <field name="head_user_id" widget="many2one_avatar" options="{'no_create_edit': True}"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="children" string="Child Units">
                            <field name="child_ids">
                                <list string="Sub-Units">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" class="fw-bold"/>
                                    <field name="code"/>
                                    <field name="unit_type_id" widget="badge"/>
                                    <field name="head_user_id" widget="many2one_avatar"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== ACADEMIC UNIT KANBAN VIEW ==================== -->
    <record id="oacis_academic_unit_view_kanban" model="ir.ui.view">
        <field name="name">oacis.academic.unit.kanban</field>
        <field name="model">oacis.academic.unit</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="unit_type_id">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="unit_type_id"/>
                <field name="parent_id"/>
                <field name="head_user_id" widget="many2one_avatar"/>
                <field name="unit_count"/>
                <templates>
                    <t t-name="card" class="flex-column">
                        <div class="d-flex justify-content-between align-items-start">
                            <field name="name" class="fw-bold fs-6"/>
                            <field name="unit_type_id" widget="badge"/>
                        </div>
                        <div class="mt-1 text-muted small">
                            <span class="badge text-bg-light border me-1"><field name="code"/></span>
                            <span t-if="record.parent_id.raw_value"><i class="fa fa-level-up me-1" title="Level Up"/><field name="parent_id"/></span>
                        </div>
                        <div class="mt-2 d-flex justify-content-between align-items-center small text-muted">
                            <span><i class="fa fa-user-circle me-1" title="User Circle"/><field name="head_user_id" widget="many2one_avatar"/></span>
                            <span t-if="record.unit_count.raw_value &gt; 0" class="badge text-bg-secondary"><field name="unit_count"/> children</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==================== ACADEMIC UNIT SEARCH VIEW ==================== -->
    <record id="oacis_academic_unit_view_search" model="ir.ui.view">
        <field name="name">oacis.academic.unit.search</field>
        <field name="model">oacis.academic.unit</field>
        <field name="arch" type="xml">
            <search string="Search Academic Units">
                <field name="name" string="Unit (Name / Code)" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code"/>
                <field name="unit_type_id"/>
                <field name="parent_id"/>
                <field name="head_user_id" widget="many2one_avatar"/>

                <searchpanel>
                    <field name="unit_type_id" icon="fa-tags" enable_counters="1"/>
                    <field name="parent_id" icon="fa-sitemap" enable_counters="1"/>
                </searchpanel>

                <group name="groupby">
                    <filter name="group_type" string="Unit Type" context="{'group_by': 'unit_type_id'}"/>
                    <filter name="group_parent" string="Parent Unit" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_head" string="Unit Head" context="{'group_by': 'head_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== ACTION ==================== -->
    <record id="action_oacis_academic_unit" model="ir.actions.act_window">
        <field name="name">Academic Units</field>
        <field name="res_model">oacis.academic.unit</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first academic unit
            </p>
            <p>
                Configure the organizational tree: Faculties, Departments, Grade Levels, Batches, or Streams.
            </p>
        </field>
    </record>

</odoo>
