<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Expose the new kanban/calendar/pivot/graph/activity views through the
         view switcher on the existing actions. -->

    <record id="action_unicore_notification_log" model="ir.actions.act_window">
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <record id="action_unicore_notification_log_failed" model="ir.actions.act_window">
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <record id="action_unicore_notification_log_today" model="ir.actions.act_window">
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

</odoo>
