<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- FORM VIEW                                                     -->
        <!-- ============================================================ -->

        <record id="view_unicore_enrollment_waitlist_form" model="ir.ui.view">
            <field name="name">unicore.enrollment.waitlist.form</field>
            <field name="model">unicore.enrollment.waitlist</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="waitlist_state" widget="statusbar" clickable="False"/>
                        <button name="action_promote_to_enrollment" type="object"
                                string="Promote to Enrollment"
                                class="btn-primary"
                                invisible="waitlist_state != 'waiting'"
                                groups="unicore_base.group_unicore_registrar"/>
                        <button name="action_decline" type="object"
                                string="Mark Declined"
                                invisible="waitlist_state != 'waiting'"
                                groups="unicore_base.group_unicore_registrar"/>
                        <button name="action_expire" type="object"
                                string="Mark Expired"
                                invisible="waitlist_state != 'waiting'"
                                groups="unicore_base.group_unicore_registrar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="student_id"/>
                                <field name="course_offering_id"/>
                                <field name="company_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="position"/>
                                <field name="waitlist_date" readonly="1"/>
                                <field name="waitlist_state" readonly="1" widget="badge"/>
                                <field name="promoted_enrollment_id" readonly="1"
                                       invisible="not promoted_enrollment_id"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- LIST VIEW                                                     -->
        <!-- ============================================================ -->

        <record id="view_unicore_enrollment_waitlist_list" model="ir.ui.view">
            <field name="name">unicore.enrollment.waitlist.list</field>
            <field name="model">unicore.enrollment.waitlist</field>
            <field name="arch" type="xml">
                <list decoration-warning="waitlist_state == 'waiting'"
                      decoration-success="waitlist_state == 'promoted'"
                      decoration-muted="waitlist_state in ('expired','declined')">
                    <field name="position"/>
                    <field name="student_id"/>
                    <field name="course_offering_id"/>
                    <field name="company_id"/>
                    <field name="waitlist_date"/>
                    <field name="waitlist_state"/>
                </list>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- SEARCH VIEW                                                   -->
        <!-- ============================================================ -->

        <record id="view_unicore_enrollment_waitlist_search" model="ir.ui.view">
            <field name="name">unicore.enrollment.waitlist.search</field>
            <field name="model">unicore.enrollment.waitlist</field>
            <field name="arch" type="xml">
                <search>
                    <field name="student_id"/>
                    <field name="course_offering_id"/>
                    <filter name="waiting" string="Waiting"
                            domain="[('waitlist_state', '=', 'waiting')]"/>
                    <filter name="promoted" string="Promoted"
                            domain="[('waitlist_state', '=', 'promoted')]"/>
                    <group>
                        <filter name="group_by_offering" string="Course Offering"
                                context="{'group_by': 'course_offering_id'}"/>
                        <filter name="group_by_state" string="Status"
                                context="{'group_by': 'waitlist_state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- WINDOW ACTION                                                 -->
        <!-- ============================================================ -->

        <record id="action_unicore_enrollment_waitlist" model="ir.actions.act_window">
            <field name="name">Enrollment Waitlist</field>
            <field name="res_model">unicore.enrollment.waitlist</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_waiting': 1}</field>
        </record>

    </data>
</odoo>
