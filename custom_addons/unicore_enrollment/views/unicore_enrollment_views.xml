<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- FORM VIEW                                                     -->
        <!-- ============================================================ -->

        <record id="view_unicore_enrollment_form" model="ir.ui.view">
            <field name="name">unicore.enrollment.form</field>
            <field name="model">unicore.enrollment</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="enrollment_state" widget="statusbar" clickable="False"/>
                        <button name="action_drop" type="object"
                                string="Drop Course"
                                class="btn-warning"
                                invisible="enrollment_state != 'registered'"/>
                        <button name="action_withdraw" type="object"
                                string="Withdraw"
                                invisible="enrollment_state != 'registered'"
                                groups="unicore_base.group_unicore_registrar"/>
                        <button name="action_complete" type="object"
                                string="Mark Completed"
                                invisible="enrollment_state != 'registered'"
                                groups="unicore_base.group_unicore_registrar"/>
                        <button name="action_cancel" type="object"
                                string="Cancel (Admin)"
                                invisible="enrollment_state in ('dropped','withdrawn','completed','cancelled')"
                                groups="unicore_base.group_unicore_admin"/>
                    </header>
                    <sheet>
                        <group name="enrollment_details" string="Enrollment Details">
                            <group>
                                <field name="student_id"/>
                                <field name="course_offering_id"/>
                                <field name="course_id" readonly="1"/>
                                <field name="semester_id" readonly="1"/>
                                <field name="campus_id" readonly="1"/>
                                <field name="company_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="enrollment_state" readonly="1" widget="badge"/>
                                <field name="registration_date" readonly="1"/>
                                <field name="registration_type"/>
                                <field name="registered_by_id" readonly="1"/>
                                <field name="credit_hours" readonly="1"/>
                            </group>
                        </group>
                        <group name="cohort" string="Cohort">
                            <group>
                                <field name="cohort_kind" readonly="1"/>
                                <field name="cohort_label" readonly="1"/>
                            </group>
                            <group>
                                <field name="grade_level_id" readonly="1"
                                       invisible="cohort_kind != 'grade_batch'"/>
                                <field name="cohort_start_date" readonly="1"
                                       invisible="cohort_kind != 'rolling'"/>
                                <field name="batch_year" readonly="1"
                                       invisible="cohort_kind != 'academic_year'"/>
                            </group>
                        </group>
                        <group name="academic_result" string="Academic Result">
                            <group>
                                <field name="grade_status"/>
                                <field name="final_grade_letter" readonly="1"/>
                            </group>
                            <group>
                                <p class="text-muted">
                                    Grade entry is managed by the Grading module.
                                    grade_status here is a status indicator only.
                                </p>
                            </group>
                        </group>
                        <group name="drop_withdrawal" string="Drop / Withdrawal"
                               invisible="enrollment_state not in ('dropped','withdrawn')">
                            <group>
                                <field name="drop_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="drop_reason"/>
                            </group>
                        </group>
                        <separator string="Validation Results"/>
                        <group>
                            <group>
                                <field name="prerequisite_check_passed" readonly="1"/>
                                <field name="prerequisite_check_notes" readonly="1"/>
                            </group>
                            <group>
                                <field name="schedule_conflict_checked" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- LIST VIEW                                                     -->
        <!-- ============================================================ -->

        <record id="view_unicore_enrollment_list" model="ir.ui.view">
            <field name="name">unicore.enrollment.list</field>
            <field name="model">unicore.enrollment</field>
            <field name="arch" type="xml">
                <list decoration-success="enrollment_state == 'registered'"
                      decoration-muted="enrollment_state in ('dropped','withdrawn','cancelled')"
                      decoration-info="enrollment_state == 'completed'">
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="semester_id"/>
                    <field name="campus_id"/>
                    <field name="cohort_kind" optional="hide"/>
                    <field name="cohort_label" optional="hide"/>
                    <field name="credit_hours"/>
                    <field name="grade_status"/>
                    <field name="enrollment_state"/>
                    <field name="registration_date"/>
                </list>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- SEARCH VIEW                                                   -->
        <!-- ============================================================ -->

        <record id="view_unicore_enrollment_search" model="ir.ui.view">
            <field name="name">unicore.enrollment.search</field>
            <field name="model">unicore.enrollment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="semester_id"/>
                    <field name="course_offering_id"/>
                    <field name="cohort_kind"/>
                    <filter name="active_enrollments" string="Active Enrollments"
                            domain="[('enrollment_state', '=', 'registered')]"/>
                    <filter name="completed" string="Completed"
                            domain="[('enrollment_state', '=', 'completed')]"/>
                    <filter name="dropped_withdrawn" string="Dropped / Withdrawn"
                            domain="[('enrollment_state', 'in', ['dropped','withdrawn'])]"/>
                    <filter name="prerequisites_failed" string="Prerequisites Failed"
                            domain="[('prerequisite_check_passed', '=', False)]"/>
                    <group>
                        <filter name="group_by_student" string="Student"
                                context="{'group_by': 'student_id'}"/>
                        <filter name="group_by_course" string="Course"
                                context="{'group_by': 'course_id'}"/>
                        <filter name="group_by_semester" string="Semester"
                                context="{'group_by': 'semester_id'}"/>
                        <filter name="group_by_campus" string="Campus"
                                context="{'group_by': 'campus_id'}"/>
                        <filter name="group_by_state" string="Status"
                                context="{'group_by': 'enrollment_state'}"/>
                        <filter name="group_by_grade" string="Grade Status"
                                context="{'group_by': 'grade_status'}"/>
                        <filter name="group_by_cohort" string="Cohort Kind"
                                context="{'group_by': 'cohort_kind'}"/>
                        <filter name="group_by_grade_level" string="Grade Level"
                                context="{'group_by': 'grade_level_id'}"/>
                        <filter name="group_by_intake" string="Intake Date"
                                context="{'group_by': 'cohort_start_date'}"/>
                        <filter name="group_by_batch" string="Batch Year"
                                context="{'group_by': 'batch_year'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- KANBAN VIEW                                                   -->
        <!-- ============================================================ -->

        <record id="view_unicore_enrollment_kanban" model="ir.ui.view">
            <field name="name">unicore.enrollment.kanban</field>
            <field name="model">unicore.enrollment</field>
            <field name="arch" type="xml">
                <kanban default_group_by="enrollment_state">
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_card_header">
                                    <strong><field name="student_id"/></strong>
                                </div>
                                <div class="o_kanban_card_body">
                                    <div><field name="course_id"/></div>
                                    <div><field name="semester_id"/></div>
                                    <div class="o_kanban_card_bottom">
                                        <span class="o_kanban_badge">
                                            <field name="credit_hours"/> credits
                                        </span>
                                        <span class="o_kanban_badge">
                                            <field name="grade_status"/>
                                        </span>
                                        <field name="enrollment_state" widget="badge"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- WINDOW ACTIONS                                                -->
        <!-- ============================================================ -->

        <record id="action_unicore_enrollment_all" model="ir.actions.act_window">
            <field name="name">All Enrollments</field>
            <field name="res_model">unicore.enrollment</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="domain">[]</field>
        </record>

        <record id="action_unicore_enrollment_active" model="ir.actions.act_window">
            <field name="name">Active Enrollments</field>
            <field name="res_model">unicore.enrollment</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('enrollment_state','=','registered')]</field>
            <field name="context">{'search_default_group_by_semester': 1}</field>
        </record>

        <record id="action_unicore_enrollment_my" model="ir.actions.act_window">
            <field name="name">My Enrollments</field>
            <field name="res_model">unicore.enrollment</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('student_id.partner_id.user_ids', 'in', [uid])]</field>
        </record>

    </data>
</odoo>
