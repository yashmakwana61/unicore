<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

    <!-- STUDENT: company isolation -->
    <record id="rule_edicai_student_company" model="ir.rule">
        <field name="name">edicai.student: company isolation</field>
        <field name="model_id" ref="model_edicai_student"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- STUDENT: campus isolation for staff (non-student users) -->
    <record id="rule_edicai_student_campus" model="ir.rule">
        <field name="name">edicai.student: campus isolation</field>
        <field name="model_id" ref="model_edicai_student"/>
        <field name="global" eval="False"/>
        <field name="groups" eval="[(4, ref('edicai_base.group_edicai_faculty')), (4, ref('edicai_base.group_edicai_staff'))]"/>
        <field name="domain_force">[
            '|',
            ('campus_id', 'in', user.edicai_campus_ids.ids),
            ('company_id', 'in', company_ids),
        ]</field>
    </record>

    <!-- STUDENT: self-view for student user (portal-like) -->
    <record id="rule_edicai_student_self" model="ir.rule">
        <field name="name">edicai.student: self-view only</field>
        <field name="model_id" ref="model_edicai_student"/>
        <field name="global" eval="False"/>
        <field name="groups" eval="[(4, ref('edicai_base.group_edicai_student'))]"/>
        <field name="domain_force">[('partner_id.user_ids', 'in', [user.id])]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- DOCUMENT: company isolation -->
    <record id="rule_edicai_student_document_company" model="ir.rule">
        <field name="name">edicai.student.document: company isolation</field>
        <field name="model_id" ref="model_edicai_student_document"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- EMERGENCY CONTACT: company isolation -->
    <record id="rule_edicai_student_emergency_contact_company" model="ir.rule">
        <field name="name">edicai.student.emergency.contact: company isolation</field>
        <field name="model_id" ref="model_edicai_student_emergency_contact"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- ACADEMIC HISTORY: company isolation -->
    <record id="rule_edicai_student_academic_history_company" model="ir.rule">
        <field name="name">edicai.student.academic.history: company isolation</field>
        <field name="model_id" ref="model_edicai_student_academic_history"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- DOCUMENT: self-view (own documents only) -->
    <record id="rule_edicai_student_document_self" model="ir.rule">
        <field name="name">edicai.student.document: self-view only</field>
        <field name="model_id" ref="model_edicai_student_document"/>
        <field name="global" eval="False"/>
        <field name="groups" eval="[(4, ref('edicai_base.group_edicai_student'))]"/>
        <field name="domain_force">[('student_id.partner_id.user_ids', 'in', [user.id])]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- EMERGENCY CONTACT: self-view (own contacts only) -->
    <record id="rule_edicai_student_emergency_contact_self" model="ir.rule">
        <field name="name">edicai.student.emergency.contact: self-view only</field>
        <field name="model_id" ref="model_edicai_student_emergency_contact"/>
        <field name="global" eval="False"/>
        <field name="groups" eval="[(4, ref('edicai_base.group_edicai_student'))]"/>
        <field name="domain_force">[('student_id.partner_id.user_ids', 'in', [user.id])]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ACADEMIC HISTORY: self-view (own history only) -->
    <record id="rule_edicai_student_academic_history_self" model="ir.rule">
        <field name="name">edicai.student.academic.history: self-view only</field>
        <field name="model_id" ref="model_edicai_student_academic_history"/>
        <field name="global" eval="False"/>
        <field name="groups" eval="[(4, ref('edicai_base.group_edicai_student'))]"/>
        <field name="domain_force">[('student_id.partner_id.user_ids', 'in', [user.id])]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ADMIN BYPASS: Full access for admin group -->
    <record id="rule_edicai_student_admin" model="ir.rule">
        <field name="name">edicai.student: admin bypass</field>
        <field name="model_id" ref="model_edicai_student"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('edicai_base.group_edicai_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_edicai_student_document_admin" model="ir.rule">
        <field name="name">edicai.student.document: admin bypass</field>
        <field name="model_id" ref="model_edicai_student_document"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('edicai_base.group_edicai_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_edicai_student_emergency_contact_admin" model="ir.rule">
        <field name="name">edicai.student.emergency.contact: admin bypass</field>
        <field name="model_id" ref="model_edicai_student_emergency_contact"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('edicai_base.group_edicai_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_edicai_student_academic_history_admin" model="ir.rule">
        <field name="name">edicai.student.academic.history: admin bypass</field>
        <field name="model_id" ref="model_edicai_student_academic_history"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('edicai_base.group_edicai_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    </data>
</odoo>
