<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

    <!-- Company isolation for all users -->
    <record id="rule_oacis_secure_transcript_company" model="ir.rule">
        <field name="name">oacis.secure.transcript: company isolation</field>
        <field name="model_id" ref="model_oacis_secure_transcript"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Students may read only their own transcripts -->
    <record id="rule_oacis_secure_transcript_student" model="ir.rule">
        <field name="name">oacis.secure.transcript: student self-view</field>
        <field name="model_id" ref="model_oacis_secure_transcript"/>
        <field name="global" eval="False"/>
        <field name="groups" eval="[(4, ref('oacis_base.group_oacis_student'))]"/>
        <field name="domain_force">[('student_id.partner_id.user_ids', 'in', [user.id])]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Admin bypass -->
    <record id="rule_oacis_secure_transcript_admin" model="ir.rule">
        <field name="name">oacis.secure.transcript: admin bypass</field>
        <field name="model_id" ref="model_oacis_secure_transcript"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('oacis_base.group_oacis_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    </data>
</odoo>
