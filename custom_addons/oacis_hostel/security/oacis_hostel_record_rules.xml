      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_oacis_hostel_allocation_student" model="ir.rule">
      <field name="name">Hostel Allocation: Student Own Record</field>
      <field name="model_id" ref="oacis_hostel.model_oacis_hostel_allocation"/>
      <field name="domain_force">[('student_id.partner_id.user_ids',
          'in', [user.id])]</field>
      <field name="groups" eval="[(4,ref('oacis_base.group_oacis_student'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_oacis_hostel_maintenance_company" model="ir.rule">
