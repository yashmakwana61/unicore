<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data noupdate="1">
    <record id="seq_oacis_hostel_allocation" model="ir.sequence">
      <field name="name">Oacis Hostel Allocation</field>
      <field name="code">oacis.hostel.allocation</field>
      <field name="prefix">HA/%(year)s/</field>
      <field name="padding">5</field>
      <field name="number_next">1</field>
      <field name="number_increment">1</field>
      <field name="company_id" eval="False"/>
    </record>
    <record id="seq_oacis_hostel_maintenance" model="ir.sequence">
      <field name="name">Oacis Hostel Maintenance</field>
      <field name="code">oacis.hostel.maintenance</field>
      <field name="prefix">MR/%(year)s/</field>
      <field name="padding">5</field>
      <field name="number_next">1</field>
      <field name="number_increment">1</field>
      <field name="company_id" eval="False"/>
    </record>
  </data>
</odoo>
