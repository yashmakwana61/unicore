<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_slide_channel_form_inherit_unicore_lms" model="ir.ui.view">
            <field name="name">slide.channel.form.inherit.unicore.lms</field>
            <field name="model">slide.channel</field>
            <field name="inherit_id" ref="website_slides.view_slide_channel_form"/>
            <field name="arch" type="xml">
                <!-- Add to the Options or a new Page for Academic Info -->
                <xpath expr="//notebook" position="inside">
                    <page string="Unicore Academic" name="unicore_academic">
                        <group>
                            <group>
                                <field name="is_academic_course"/>
                                <field name="course_offering_id" 
                                       invisible="not is_academic_course"
                                       required="is_academic_course"/>
                            </group>
                            <group invisible="not is_academic_course">
                                <field name="program_id"/>
                                <field name="semester_id"/>
                            </group>
                        </group>
                        <div invisible="not is_academic_course">
                            <button name="action_sync_academic_enrollments" 
                                    type="object" 
                                    string="Sync Enrollments from Unicore" 
                                    class="btn-primary"/>
                        </div>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
