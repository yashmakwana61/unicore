<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ========================================== -->
        <!-- Time Slot Record Rules                      -->
        <!-- ========================================== -->

        <record id="rule_unicore_time_slot_company" model="ir.rule">
            <field name="name">Time Slot: Company Isolation</field>
            <field name="model_id" ref="model_unicore_time_slot"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_unicore_time_slot_admin" model="ir.rule">
            <field name="name">Time Slot: Admin Bypass</field>
            <field name="model_id" ref="model_unicore_time_slot"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_admin'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- ========================================== -->
        <!-- Timetable Entry Record Rules                -->
        <!-- ========================================== -->

        <record id="rule_unicore_timetable_entry_company" model="ir.rule">
            <field name="name">Timetable Entry: Company Isolation</field>
            <field name="model_id" ref="model_unicore_timetable_entry"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_unicore_timetable_entry_campus_staff" model="ir.rule">
            <field name="name">Timetable Entry: Campus Restriction for Staff</field>
            <field name="model_id" ref="model_unicore_timetable_entry"/>
            <field name="domain_force">['|', ('campus_id', '=', False), ('campus_id', 'in', user.unicore_campus_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_staff'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_unicore_timetable_entry_faculty_own" model="ir.rule">
            <field name="name">Timetable Entry: Faculty Own Schedule</field>
            <field name="model_id" ref="model_unicore_timetable_entry"/>
            <field name="domain_force">[('instructor_id.partner_id.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_faculty'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_unicore_timetable_entry_student_read" model="ir.rule">
            <field name="name">Timetable Entry: Student Read Access</field>
            <field name="model_id" ref="model_unicore_timetable_entry"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_student'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_unicore_timetable_entry_admin" model="ir.rule">
            <field name="name">Timetable Entry: Admin Bypass</field>
            <field name="model_id" ref="model_unicore_timetable_entry"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_admin'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- ========================================== -->
        <!-- Room Booking Record Rules                   -->
        <!-- ========================================== -->

        <record id="rule_unicore_room_booking_company" model="ir.rule">
            <field name="name">Room Booking: Company Isolation</field>
            <field name="model_id" ref="model_unicore_room_booking"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_unicore_room_booking_faculty_own" model="ir.rule">
            <field name="name">Room Booking: Faculty Own Requests</field>
            <field name="model_id" ref="model_unicore_room_booking"/>
            <field name="domain_force">[('requested_by_id.partner_id.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_faculty'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_unicore_room_booking_admin" model="ir.rule">
            <field name="name">Room Booking: Admin Bypass</field>
            <field name="model_id" ref="model_unicore_room_booking"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_admin'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

    </data>
</odoo>
