<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Expose the new kanban/calendar/pivot/graph/activity views through the
         view switcher on the existing actions. -->

    <record id="action_oacis_room_booking" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar</field>
    </record>

    <record id="action_oacis_time_slot" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="action_oacis_timetable_entry" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,calendar</field>
    </record>

    <record id="action_oacis_timetable_my_schedule" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,calendar</field>
    </record>

</odoo>
