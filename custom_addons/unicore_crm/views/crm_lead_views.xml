<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.form.unicore.crm.ext</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_admission_applicant"
                        type="object" class="oe_stat_button"
                        icon="fa-graduation-cap"
                        invisible="not applicant_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Applicant</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//sheet//group[1]" position="inside">
                <field name="applicant_id" readonly="1"
                       invisible="not applicant_id"/>
            </xpath>
        </field>
    </record>

</odoo>