<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.oacis_design</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Oacis Theme" string="Oacis Theme" name="oacis_theme_setting_container">
                    <setting id="theme_font_family_setting" string="Font Family" help="Select default font family for the backend interface.">
                        <field name="theme_font_family"/>
                    </setting>
                    <setting id="theme_list_density_setting" string="List Density" help="Adjust rows height and spacing in list views.">
                        <field name="theme_list_density"/>
                    </setting>
                    <setting id="theme_border_radius_setting" string="Border Radius" help="Configure global border radius for UI components.">
                        <field name="theme_border_radius"/>
                    </setting>
                    <setting id="theme_chatter_position_setting" string="Chatter Position" help="Position the chatter at the bottom or to the side of form views.">
                        <field name="theme_chatter_position"/>
                    </setting>
                    <setting id="theme_start_menu_bg_setting" string="Start Menu Background" help="Background style of the full-screen Start Menu.">
                        <field name="theme_start_menu_bg"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
