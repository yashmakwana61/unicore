<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="oacis_design.KanbanFlyout">
        <div class="o_oacis_flyout_wrapper">
            <div class="o_oacis_flyout_backdrop" t-on-click="props.onClose"/>
            <div class="o_oacis_flyout_panel shadow-lg">
                <div class="o_oacis_flyout_header d-flex align-items-center justify-content-between px-3 py-2 border-bottom bg-view">
                    <div class="d-flex align-items-center gap-2 overflow-hidden me-2">
                        <i class="fa fa-file-text-o text-primary fs-5"/>
                        <h5 class="m-0 text-truncate font-weight-bold text-dark" t-esc="props.title || 'Quick View'"/>
                    </div>
                    <button class="btn btn-sm btn-icon btn-outline-secondary rounded-circle ms-2" t-on-click="props.onClose" aria-label="Close">
                        <i class="fa fa-times"/>
                    </button>
                </div>
                <div class="o_oacis_flyout_body p-3 overflow-auto flex-grow-1">
                    <View type="'form'" resModel="props.resModel" resId="props.resId" display="{ controlPanel: false }" mode="'readonly'"/>
                </div>
            </div>
        </div>
    </t>

    <t t-name="oacis_design.KanbanRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="inside">
            <KanbanFlyout t-if="oacisState.flyoutData"
                          resModel="oacisState.flyoutData.resModel"
                          resId="oacisState.flyoutData.resId"
                          title="oacisState.flyoutData.title"
                          onClose="() => this.closeKanbanFlyout()"/>
        </xpath>
    </t>

    <t t-name="oacis_design.ControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_cp_pager')]" position="before">
            <button class="btn btn-icon btn-outline-secondary o_smart_refresher_btn me-1 d-inline-flex align-items-center justify-content-center"
                    t-on-click="onSmartRefresh"
                    title="Smart Refresh Data"
                    aria-label="Smart Refresh Data">
                <i class="fa fa-refresh" t-att-class="{ 'fa-spin': oacisRefresherState.isRefreshing }"/>
            </button>
        </xpath>
    </t>

    <!-- Form view header toggle buttons for Fullscreen and Chatter Position -->
    <t t-name="oacis_design.FormButtons" t-inherit="web.FormView.Buttons" t-inherit-mode="extension">
        <xpath expr="//button" position="before">
            <!-- Fullscreen Form View Toggle -->
            <button type="button" class="btn btn-outline-secondary o_oacis_fullscreen_btn me-1 d-inline-flex align-items-center justify-content-center"
                    t-on-click="toggleFullscreen"
                    t-att-class="{ 'active': oacisFormState.isFullscreen }"
                    title="Toggle Fullscreen Form"
                    aria-label="Toggle Fullscreen Form">
                <i class="fa" t-att-class="oacisFormState.isFullscreen ? 'fa-compress' : 'fa-expand'"/>
                <span class="d-none d-xl-inline ms-1">Fullscreen</span>
            </button>

            <!-- Chatter Position Toggle -->
            <button t-if="hasChatter" type="button" class="btn btn-outline-secondary o_oacis_chatter_toggle_btn me-1 d-inline-flex align-items-center justify-content-center"
                    t-on-click="toggleChatterPosition"
                    t-att-title="chatterToggleTitle"
                    t-att-aria-label="chatterToggleTitle">
                <i class="fa" t-att-class="chatterToggleIcon"/>
            </button>
        </xpath>
    </t>

    <!-- Resizable side chatter vertical drag handle -->
    <t t-name="oacis_design.Chatter" t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Chatter')]" position="inside">
            <div t-if="props.isChatterAside" class="o-oacis-chatter-drag-handle" t-on-mousedown="onChatterResizeMouseDown"/>
        </xpath>
    </t>

</templates>
