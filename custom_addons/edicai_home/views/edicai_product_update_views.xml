<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_update_tree" model="ir.ui.view">
            <field name="name">edicai.product.update.tree</field>
            <field name="model">edicai.product.update</field>
            <field name="arch" type="xml">
                <list string="Product Updates">
                    <field name="name"/>
                    <field name="update_type"/>
                    <field name="state"/>
                    <field name="publish_date"/>
                </list>
            </field>
        </record>

        <record id="view_product_update_form" model="ir.ui.view">
            <field name="name">edicai.product.update.form</field>
            <field name="model">edicai.product.update</field>
            <field name="arch" type="xml">
                <form string="Product Update">
                    <header>
                        <button name="action_publish" type="object" string="Publish"
                                class="btn-primary" invisible="state == 'published'"/>
                        <button name="action_unpublish" type="object" string="Unpublish"
                                invisible="state != 'published'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="update_type"/>
                            <field name="summary"/>
                            <field name="company_id" options="{}"/>
                            <field name="publish_date" invisible="not publish_date"/>
                            <field name="audience_groups" widget="many2many_tags"
                                   placeholder="Empty = all internal users"/>
                        </group>
                        <group>
                            <field name="body"/>
                        </group>
                        <group>
                            <field name="create_uid" readonly="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_product_update" model="ir.actions.act_window">
            <field name="name">Product Updates</field>
            <field name="res_model">edicai.product.update</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_onboarding_item_tree" model="ir.ui.view">
            <field name="name">edicai.onboarding.item.tree</field>
            <field name="model">edicai.onboarding.item</field>
            <field name="arch" type="xml">
                <list string="Getting Started Items">
                    <field name="name"/>
                    <field name="role"/>
                    <field name="sequence"/>
                    <field name="completion_mode"/>
                    <field name="derive_check" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="action_onboarding_item" model="ir.actions.act_window">
            <field name="name">Getting Started Items</field>
            <field name="res_model">edicai.onboarding.item</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
