<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="edicai_home.Home" owl="1">
        <div class="o_edicai_home">
            <t t-if="state.loading">
                <div class="o_home_skeleton" role="status" aria-live="polite">
                    <div class="o_skel_header"/>
                    <div class="o_skel_tabs"/>
                    <div class="o_skel_grid">
                        <div class="o_skel_card"/>
                        <div class="o_skel_card"/>
                        <div class="o_skel_card"/>
                        <div class="o_skel_card"/>
                    </div>
                    <span class="visually-hidden">Loading Home…</span>
                </div>
            </t>

            <t t-elif="state.error">
                <div class="alert alert-danger o_home_error" role="alert">
                    <i class="fa fa-warning me-1"/> <t t-esc="state.error"/>
                    <button class="btn btn-sm btn-outline-danger ms-2"
                            t-on-click="() => this.loadData()">Retry</button>
                </div>
            </t>

            <t t-elif="state.data">
                <!-- ============ Customize Modal ===================== -->
                <div t-if="state.showCustomize" class="o_customize_overlay" t-on-click="toggleCustomize">
                    <div class="o_customize_modal" t-on-click.stop="">
                        <div class="o_customize_header">
                            <h3>Customize Dashboard</h3>
                            <button class="o_customize_close" t-on-click="toggleCustomize">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <div class="o_customize_body">
                            <p class="text-muted small mb-2">Choose which widgets to display on your dashboard.</p>
                            <div class="o_customize_list">
                                <t t-foreach="state.availableWidgets" t-as="wkey" t-key="wkey">
                                    <label class="o_customize_item">
                                        <input type="checkbox"
                                               t-att-checked="isWidgetEnabled(wkey) ? 'checked' : null"
                                               t-on-change="() => this.toggleWidget(wkey)"/>
                                        <span><t t-esc="widgetLabel(wkey)"/></span>
                                    </label>
                                </t>
                            </div>
                        </div>
                        <div class="o_customize_footer">
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="resetWidgetPrefs">
                                Reset to defaults
                            </button>
                            <button class="btn btn-sm btn-primary" t-on-click="saveWidgetPrefs">
                                Save
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ============ Header ============================= -->
                <header class="o_home_header">
                    <div class="o_home_header_main">
                        <div class="o_home_header_text">
                            <h1 class="o_home_greeting mb-0">
                                <t t-esc="state.data.header.greeting"/>,
                                <t t-esc="state.data.header.user_name"/>
                            </h1>
                            <div class="o_home_context text-muted">
                                <t t-if="state.data.header.company">
                                    <span><t t-esc="state.data.header.company"/></span>
                                    <span class="o_home_dot">·</span>
                                </t>
                                <t t-if="state.data.header.semester">
                                    <span><t t-esc="state.data.header.semester.name"/></span>
                                    <t t-if="state.data.header.semester.code">
                                        <span class="text-muted">
                                            (<t t-esc="state.data.header.semester.code"/>)
                                        </span>
                                    </t>
                                    <t t-if="state.data.header.semester.year">
                                        <span class="text-muted">
                                            | <t t-esc="state.data.header.semester.year"/>
                                        </span>
                                    </t>
                                    <span class="o_home_dot">·</span>
                                </t>
                                <span><t t-esc="state.data.header.date"/></span>
                            </div>
                        </div>
                        <div class="o_home_header_action">
                            <button class="o_home_customize_btn" t-on-click="toggleCustomize"
                                    title="Customize dashboard widgets" aria-label="Customize dashboard">
                                <i class="fa fa-sliders"/> Customize
                            </button>
                            <t t-if="state.data.onboarding and state.data.onboarding.progress and state.data.onboarding.progress.percent &lt; 100">
                                <button class="o_home_cta" t-on-click="continueSetup"
                                        aria-label="Continue setup">
                                    <span class="o_home_cta_pct">
                                        <t t-esc="Math.round(state.data.onboarding.progress.percent)"/>%
                                    </span>
                                    <span class="o_home_cta_label">
                                        <t t-if="nextOnboardingStep() &amp;&amp; state.data.onboarding.progress.percent &lt; 100">
                                            Continue setup — <t t-esc="nextOnboardingStep()"/>
                                        </t>
                                        <t t-else="">Continue setup</t>
                                    </span>
                                </button>
                            </t>
                        </div>
                    </div>
                    <nav class="o_home_tabs" role="tablist" aria-label="Home sections">
                        <button class="o_home_tab" role="tab"
                                data-tab="dashboard"
                                t-att-aria-selected="state.tab === 'dashboard' ? 'true' : 'false'"
                                t-att-class="{active: state.tab === 'dashboard'}"
                                t-on-click="selectTab" tabindex="0">Dashboard</button>
                        <span class="o_home_tab_sep" aria-hidden="true">|</span>
                        <button class="o_home_tab" role="tab"
                                data-tab="getting-started"
                                t-att-aria-selected="state.tab === 'getting-started' ? 'true' : 'false'"
                                t-att-class="{active: state.tab === 'getting-started'}"
                                t-on-click="selectTab" tabindex="0">Getting Started</button>
                        <span class="o_home_tab_sep" aria-hidden="true">|</span>
                        <button class="o_home_tab" role="tab"
                                data-tab="recent-updates"
                                t-att-aria-selected="state.tab === 'recent-updates' ? 'true' : 'false'"
                                t-att-class="{active: state.tab === 'recent-updates'}"
                                t-on-click="selectTab" tabindex="0">Recent Updates</button>
                    </nav>
                </header>

                <!-- ============ DASHBOARD =========================== -->
                <section t-if="state.tab === 'dashboard'" class="o_home_tabpane">
                    <!-- Primary metrics -->
                    <t t-set="prim" t-value="widgetsIn('primary')"/>
                    <div t-if="prim.length" class="o_metrics_grid">
                        <t t-foreach="prim" t-as="widget" t-key="widget.key">
                            <t t-call="edicai_home.WidgetCard"/>
                        </t>
                    </div>

                    <!-- Interactive Charts -->
                    <div t-if="state.data.charts and state.data.charts.length" class="o_charts_grid">
                        <t t-foreach="state.data.charts" t-as="chart" t-key="chart.key">
                            <div class="o_chart_card">
                                <header class="o_chart_head">
                                    <h3><t t-esc="chart.title"/></h3>
                                </header>
                                <div class="o_chart_body">
                                    <t t-if="chart.type === 'donut'">
                                        <svg class="o_chart_donut" viewBox="0 0 120 120" width="120" height="120">
                                            <t t-set="total" t-value="chart.values.reduce((a,b)=>a+b,0)"/>
                                            <t t-set="offset" t-value="0"/>
                                            <t t-foreach="chart.values" t-as="val" t-key="val_index">
                                                <t t-set="pct" t-value="total ? val/total : 0"/>
                                                <t t-set="dash" t-value="pct * 314"/>
                                                <circle cx="60" cy="60" r="50" fill="none"
                                                        t-att-stroke="chart.colors[val_index % chart.colors.length]"
                                                        stroke-width="20"
                                                        t-att-stroke-dasharray="dash + ' 314'"
                                                        t-att-transform="'rotate(' + (offset*360-90) + ' 60 60)'"/>
                                                <t t-set="offset" t-value="offset + pct"/>
                                            </t>
                                            <text x="60" y="60" text-anchor="middle" dominant-baseline="central"
                                                  class="o_chart_center_text">
                                                <t t-esc="total"/>
                                            </text>
                                        </svg>
                                        <div class="o_chart_legend">
                                            <t t-foreach="chart.labels" t-as="lbl" t-key="lbl_index">
                                                <div class="o_chart_legend_item">
                                                    <span class="o_chart_dot"
                                                          t-att-style="'background:' + chart.colors[lbl_index % chart.colors.length]"/>
                                                    <span><t t-esc="lbl"/> (<t t-esc="chart.values[lbl_index]"/>)</span>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-elif="chart.type === 'bar'">
                                        <svg class="o_chart_bar" viewBox="0 0 300 150" width="300" height="150">
                                            <t t-set="maxVal" t-value="Math.max(...chart.values, 1)"/>
                                            <t t-foreach="chart.values" t-as="val" t-key="val_index">
                                                <t t-set="barH" t-value="(val/maxVal)*120"/>
                                                <t t-set="barW" t-value="300/chart.values.length - 8"/>
                                                <t t-set="barX" t-value="val_index*(300/chart.values.length)+4"/>
                                                <rect t-att-x="barX" t-att-y="150-barH-20" t-att-width="barW" t-att-height="barH"
                                                      t-att-fill="chart.colors[0]" rx="4"/>
                                                <text t-att-x="barX+barW/2" y="145" text-anchor="middle"
                                                      class="o_chart_bar_label">
                                                    <t t-esc="chart.labels[val_index]"/>
                                                </text>
                                                <text t-att-x="barX+barW/2" t-att-y="150-barH-25" text-anchor="middle"
                                                      class="o_chart_bar_value">
                                                    <t t-esc="val"/>
                                                </text>
                                            </t>
                                        </svg>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Attention + schedule side by side -->
                    <t t-set="attention" t-value="widgetsIn('attention')"/>
                    <t t-set="schedule" t-value="widgetsIn('schedule')"/>
                    <div t-if="attention.length or schedule.length" class="o_two_col">
                        <div class="o_col_stack">
                            <t t-foreach="attention" t-as="widget" t-key="widget.key">
                                <t t-call="edicai_home.WidgetCard"/>
                            </t>
                        </div>
                        <div class="o_col_stack">
                            <t t-foreach="schedule" t-as="widget" t-key="widget.key">
                                <t t-call="edicai_home.WidgetCard"/>
                            </t>
                        </div>
                    </div>

                    <!-- AI Insights -->
                    <div class="o_ai_insights">
                        <h3><i class="fa fa-lightbulb-o"/> Edicai AI Insights</h3>
                        <div class="o_ai_insight_item">
                            <i class="fa fa-info-circle"/>
                            <span>AI-powered institutional insights will appear here once the Edicai AI engine is connected to your data.</span>
                            <span class="o_ai_insight_action">Learn more</span>
                        </div>
                        <div class="o_ai_insight_item">
                            <i class="fa fa-line-chart"/>
                            <span>Trend analysis, anomaly detection, and predictive recommendations will be available in a future update.</span>
                        </div>
                    </div>

                    <!-- Secondary / supporting -->
                    <t t-set="sec" t-value="widgetsIn('secondary')"/>
                    <div t-if="sec.length" class="o_metrics_grid o_metrics_grid-secondary">
                        <t t-foreach="sec" t-as="widget" t-key="widget.key">
                            <t t-call="edicai_home.WidgetCard"/>
                        </t>
                    </div>
                    <t t-if="!prim.length and !attention.length and !schedule.length and !sec.length">
                        <div class="o_widget_state empty">Nothing needs your attention right now.</div>
                    </t>
                </section>

                <!-- ============ GETTING STARTED ===================== -->
                <section t-if="state.tab === 'getting-started' and state.data.onboarding"
                         class="o_home_tabpane">
                    <t t-if="!state.data.onboarding.items.length">
                        <div class="o_widget_state empty">
                            No onboarding guidance exists for your role yet.
                        </div>
                    </t>
                    <t t-else="">
                        <div class="o_onboard_progress" role="status">
                            <div class="o_progress_text">
                                <t t-esc="state.data.onboarding.progress.done"/> of
                                <t t-esc="state.data.onboarding.progress.total"/> steps completed
                            </div>
                            <div class="o_progress_bar" aria-hidden="true">
                                <div t-attf-class="o_progress_fill"
                                     t-att-style="'width:' + state.data.onboarding.progress.percent + '%'"/>
                            </div>
                        </div>
                        <ul class="o_onboard_list">
                            <t t-foreach="state.data.onboarding.items" t-as="item" t-key="item.id">
                                <li t-att-class="'o_onboard_item ' + (item.state === 'done' ? 'done' : item.state === 'skipped' ? 'skipped' : '')">
                                    <span class="o_onboard_check" aria-hidden="true">
                                        <i t-att-class="item.state === 'done' ? 'fa fa-check' : item.state === 'skipped' ? 'fa fa-forward' : 'fa fa-circle-o'"/>
                                    </span>
                                    <div class="o_onboard_body">
                                        <div class="o_onboard_title"><t t-esc="item.name"/></div>
                                        <div class="o_onboard_desc text-muted">
                                            <t t-if="item.completion_mode === 'derived' and item.state === 'done'">
                                                Complete
                                                <t t-if="item.completed_on">· <t t-esc="item.completed_on"/></t> (auto-detected)
                                            </t>
                                            <t t-else=""><t t-esc="item.description"/></t>
                                        </div>
                                    </div>
                                    <div class="o_onboard_actions">
                                        <button t-if="item.link_action and item.state !== 'done'"
                                                class="o_home_linklike"
                                                t-on-click="() => this.openItemLink(item)">
                                            <t t-esc="item.link_label || 'Open'"/>
                                        </button>
                                        <t t-if="item.completion_mode === 'manual' and item.state !== 'done'">
                                            <button class="btn btn-sm btn-primary o_btn"
                                                    t-on-click="() => this.setItemState(item, 'done')">Mark done</button>
                                            <button class="btn btn-sm o_btn"
                                                    t-on-click="() => this.setItemState(item, 'skipped')">Skip</button>
                                        </t>
                                        <t t-elif="item.state === 'done'">
                                            <span class="text-success small">
                                                <i class="fa fa-check me-1"/>Done
                                            </span>
                                        </t>
                                        <t t-elif="item.state === 'skipped'">
                                            <button class="o_home_linklike small"
                                                    t-on-click="() => this.setItemState(item, 'todo')">Restore</button>
                                        </t>
                                    </div>
                                </li>
                            </t>
                        </ul>
                    </t>
                </section>

                <!-- ============ RECENT UPDATES ====================== -->
                <section t-if="state.tab === 'recent-updates'" class="o_home_tabpane">
                    <t t-if="state.data.updates and state.data.updates.product and state.data.updates.product.length">
                        <h2 class="o_update_section">Edicai Product Updates</h2>
                        <ul class="o_update_list">
                            <t t-foreach="state.data.updates.product" t-as="upd" t-key="upd.id">
                                <li class="o_update_item" t-att-class="'o_upd_' + upd.update_type">
                                    <span class="o_update_icon" aria-hidden="true">
                                        <i t-att-class="'fa ' + updateIcon(upd.update_type)"/>
                                    </span>
                                    <div class="o_update_body">
                                        <div class="o_update_title"><t t-esc="upd.title"/></div>
                                        <p class="o_update_summary text-muted mb-0">
                                            <t t-esc="upd.summary"/>
                                        </p>
                                    </div>
                                    <span class="o_update_meta">
                                        <span class="o_upd_cat" t-esc="upd.update_type"/>
                                        <span class="text-muted"><t t-esc="upd.date"/></span>
                                    </span>
                                </li>
                            </t>
                        </ul>
                    </t>
                    <t t-if="state.data.updates and state.data.updates.notices and state.data.updates.notices.length">
                        <h2 class="o_update_section">Institution Announcements</h2>
                        <ul class="o_update_list">
                            <t t-foreach="state.data.updates.notices" t-as="n" t-key="n.id">
                                <li class="o_update_item"
                                    t-att-class="'o_notice_' + (n.notice_type || 'general')"
                                    t-on-click="() => this.openRow({
                                        id: n.id, res_model: n.res_model,
                                        title: n.title, subtitle: n.summary,
                                        values: {}, badge: null, badge_type: null})">
                                    <span class="o_update_icon">
                                        <i t-att-class="'fa ' + noticeIcon(n.notice_type)"/>
                                    </span>
                                    <div class="o_update_body">
                                        <div class="o_update_title">
                                            <t t-if="n.pinned"><i class="fa fa-thumb-tack me-1" title="Pinned"/></t>
                                            <t t-esc="n.title"/>
                                        </div>
                                        <p class="o_update_summary text-muted mb-0">
                                            <t t-esc="n.summary"/>
                                        </p>
                                    </div>
                                    <span class="o_update_meta text-muted"><t t-esc="n.date"/></span>
                                </li>
                            </t>
                        </ul>
                    </t>
                    <t t-if="state.data.updates and !state.data.updates.product and !state.data.updates.notices">
                        <div class="o_widget_state empty">
                            No updates published yet. Announcements will appear here.
                        </div>
                    </t>
                </section>
            </t>
        </div>
    </t>

    <!-- ============ Shared widget card ============ -->
    <t t-name="edicai_home.WidgetCard" owl="1">
        <article t-att-class="'o_home_widget o_widget_' + widget.kind + ' o_widget_sec-' + widget.section + (widget.error ? ' o_widget_error' : '')">
            <t t-if="widget.error">
                <div class="o_widget_state">
                    <i class="fa fa-plug"/> Widget unavailable —
                    <button class="o_home_linklike"
                            t-on-click="() => this.loadData()">reload</button>
                </div>
            </t>
            <t t-elif="widget.restricted">
                <div class="o_widget_state text-muted">
                    <i class="fa fa-lock"/> You do not have access to this data.
                </div>
            </t>
            <t t-else="">
                <header class="o_widget_head">
                    <i t-att-class="'fa ' + (widget.icon || 'fa-square')"/>
                    <h3><t t-esc="widget.title"/></h3>
                    <button t-if="widget.view_all" class="o_widget_more"
                            t-on-click="() => this.openList(widget)"
                            tabindex="0">View all</button>
                </header>
                <p t-if="widget.title_extra" class="text-muted small mb-1">
                    <t t-esc="widget.title_extra"/>
                </p>

                <div t-if="widget.kind === 'kpi' and widget.kpis" class="o_kpi_row">
                    <t t-foreach="widget.kpis" t-as="kpi" t-key="kpi.label">
                        <div class="o_kpi">
                            <div class="o_kpi_value"><t t-esc="kpi.value"/></div>
                            <div class="o_kpi_label"><t t-esc="kpi.label"/></div>
                        </div>
                    </t>
                </div>

                <ul t-if="widget.rows" class="o_widget_rows">
                    <t t-foreach="widget.rows" t-as="row" t-key="row.id">
                        <li>
                            <button class="o_home_linklike w-100 text-start"
                                    t-att-aria-label="row.title"
                                    t-on-click="() => this.openRow(row)">
                                <span class="o_row_title"><t t-esc="row.title"/></span>
                                <span class="o_row_sub muted"><t t-esc="row.subtitle"/></span>
                                <span t-if="row.badge"
                                      t-att-class="badgeClass(row.badge_type)">
                                    <t t-esc="row.badge"/>
                                </span>
                            </button>
                        </li>
                    </t>
                </ul>
                <div t-if="widget.rows and widget.rows.length === 0 and !widget.kpis and !widget.actions"
                     class="o_widget_state empty">Nothing needs attention here.</div>

                <div t-if="widget.actions" class="o_quick_links">
                    <t t-foreach="widget.actions" t-as="act" t-key="act.label">
                        <button class="o_quick_link"
                                t-att-aria-label="'Open ' + act.label"
                                t-on-click="() => this.openQuickLink(act)">
                            <t t-esc="act.label"/>
                        </button>
                    </t>
                </div>
            </t>
        </article>
    </t>

</templates>
