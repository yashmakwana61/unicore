<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Assignment auto-numbering sequence -->
        <record id="seq_oacis_assignment" model="ir.sequence">
            <field name="name">Assignment Sequence</field>
            <field name="code">oacis.assignment</field>
            <field name="prefix">ASG/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Rubric auto-numbering sequence -->
        <record id="seq_oacis_assignment_rubric" model="ir.sequence">
            <field name="name">Rubric Sequence</field>
            <field name="code">oacis.assignment.rubric</field>
            <field name="prefix">RBR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
