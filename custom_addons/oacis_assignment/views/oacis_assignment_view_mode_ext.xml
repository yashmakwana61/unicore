<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Expose the kanban/calendar/pivot/graph views through the view
         switcher on the main actions. -->

    <record id="action_oacis_assignment_all" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
    </record>

    <record id="action_oacis_assignment_my" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
    </record>

    <record id="action_oacis_assignment_published" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
    </record>

    <record id="action_oacis_assignment_submission_all" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,pivot,graph</field>
    </record>

    <record id="action_oacis_assignment_submission_pending" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,pivot,graph</field>
    </record>

    <record id="action_oacis_assignment_submission_my" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,pivot,graph</field>
    </record>

    <record id="action_oacis_assignment_rubric" model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
    </record>

</odoo>
