<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- SUBMISSION ANALYSIS (PIVOT + GRAPH)                           -->
        <!-- ============================================================ -->

        <record id="view_unicore_assignment_submission_pivot" model="ir.ui.view">
            <field name="name">unicore.assignment.submission.pivot</field>
            <field name="model">unicore.assignment.submission</field>
            <field name="arch" type="xml">
                <pivot string="Submission Analysis">
                    <field name="course_id" type="row"/>
                    <field name="state" type="col"/>
                    <field name="marks_obtained" type="measure"/>
                    <field name="marks_percentage" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="view_unicore_assignment_submission_graph" model="ir.ui.view">
            <field name="name">unicore.assignment.submission.graph</field>
            <field name="model">unicore.assignment.submission</field>
            <field name="arch" type="xml">
                <graph string="Submission Analysis">
                    <field name="state"/>
                </graph>
            </field>
        </record>

    </data>
</odoo>
