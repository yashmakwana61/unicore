<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="uc_demo_notif_template_attendance" model="oacis.notification.template">
      <field name="name">Attendance Shortage Alert</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="trigger_event">attendance_shortage</field>
      <field name="channel">email</field>
      <field name="email_subject">Attendance Shortage Warning</field>
      <field name="email_body_html"><![CDATA[<p>Dear {student_name}, your attendance in {course_name} has fallen below the minimum required threshold. Please contact your faculty advisor.</p>]]></field>
      <field name="is_active_trigger">True</field>
    </record>

    <record id="uc_demo_notif_template_fee" model="oacis.notification.template">
      <field name="name">Fee Payment Reminder</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="trigger_event">fee_due</field>
      <field name="channel">email</field>
      <field name="email_subject">Fee Payment Due Reminder</field>
      <field name="email_body_html"><![CDATA[<p>Dear {student_name}, your fee payment of {amount} is due. Please pay before the deadline.</p>]]></field>
      <field name="is_active_trigger">True</field>
    </record>
  </data>
</odoo>
