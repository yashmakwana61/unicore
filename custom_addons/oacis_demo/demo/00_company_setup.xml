<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="base.main_company" model="res.company">
      <field name="name">PreciseFect University</field>
      <field name="street">University Road, Satellite</field>
      <field name="city">Ahmedabad</field>
      <field name="zip">380015</field>
      <field name="country_id" ref="base.in"/>
      <field name="phone">+91 79 2600 0000</field>
      <field name="email">info@pfu.precisefect.com</field>
      <field name="website">https://pfu.precisefect.com</field>
      <field name="university_type">university</field>
      <!-- The legacy static dataset below is a university dataset, so the
           company explicitly carries the legacy university profile. This keeps
           calendar/grading/unit constraints consistent. For any other
           institution type, use the Demo Data generator instead of relying on
           the company's previous profile. -->
      <field name="institution_profile_id" ref="oacis_institution_profile.profile_university_legacy"/>
      <field name="established_year">1995</field>
      <field name="accreditation_body">NAAC — Grade A+</field>
    </record>
  </data>
</odoo>
