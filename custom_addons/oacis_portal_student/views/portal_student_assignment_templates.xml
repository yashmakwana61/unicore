<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
  =====================================================
  TEMPLATE: MY ASSIGNMENTS (list)
  =====================================================
  -->
  <template id="portal_student_assignments"
            name="My Assignments">
    <t t-call="oacis_portal_student.portal_student_layout">
      <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h4 class="mb-0">My Assignments</h4>
          <span class="text-muted">
            <t t-esc="len(assignments)"/> assignment(s)
          </span>
        </div>

        <t t-if="not assignments">
          <div class="alert alert-info">
            No assignments have been published for your courses yet.
          </div>
        </t>

        <t t-foreach="assignments" t-as="assignment">
          <t t-set="sub" t-value="submission_map.get(assignment.id, False)"/>
          <div class="card mb-3"
               t-attf-class="oacis-assignment-card #{'oacis-assignment-due' if assignment.id in overdue_ids and not sub else ''}">
            <div class="card-header d-flex justify-content-between align-items-center">
              <div>
                <strong>
                  <t t-esc="assignment.course_id.code"/> —
                  <t t-esc="assignment.course_id.name"/>
                </strong>
                <span class="badge bg-secondary ms-2">
                  <t t-esc="assignment.assignment_type"/>
                </span>
              </div>
              <span t-att-class="'badge ' + ('bg-success' if assignment.assignment_state == 'published' else 'bg-dark')">
                <t t-esc="assignment.assignment_state"/>
              </span>
            </div>
            <div class="card-body">
              <h5 class="card-title">
                <a t-attf-href="/my/oacis/student/assignments/#{assignment.id}">
                  <t t-esc="assignment.title"/>
                </a>
              </h5>
              <div class="row">
                <div class="col-md-6">
                  <p class="mb-1">
                    <i class="fa fa-calendar fa-fw"/>
                    Due:
                    <t t-esc="assignment.due_date"/>
                    <t t-if="assignment.due_time">
                      at <t t-esc="assignment.due_time"/>
                    </t>
                  </p>
                  <p class="mb-1">
                    <i class="fa fa-trophy fa-fw"/>
                    Max Marks:
                    <t t-esc="assignment.max_marks"/>
                  </p>
                  <p class="mb-1">
                    <i class="fa fa-user fa-fw"/>
                    Instructor:
                    <t t-esc="assignment.faculty_member_id.display_name if assignment.faculty_member_id else '—'"/>
                  </p>
                </div>
                <div class="col-md-6 text-md-end">
                  <t t-if="sub and sub.state == 'graded'">
                    <span class="badge bg-success">
                      <i class="fa fa-check"/> Graded:
                      <t t-esc="sub.marks_obtained"/> / <t t-esc="assignment.max_marks"/>
                    </span>
                  </t>
                  <t t-elif="sub and sub.state in ('submitted','late')">
                    <span t-att-class="'badge ' + ('bg-warning text-dark' if sub.state == 'late' else 'bg-info')">
                      <i class="fa fa-paper-plane"/> Submitted
                      <t t-if="sub.is_late">(late)</t>
                    </span>
                  </t>
                  <t t-elif="sub and sub.state == 'returned'">
                    <span class="badge bg-danger">
                      <i class="fa fa-undo"/> Returned for revision
                    </span>
                  </t>
                  <t t-elif="assignment.id in overdue_ids">
                    <span class="badge bg-danger">
                      <i class="fa fa-clock-o"/> Overdue
                    </span>
                  </t>
                  <t t-else="">
                    <span class="badge bg-secondary">
                      <i class="fa fa-hourglass-half"/> Not submitted
                    </span>
                  </t>
                  <div class="mt-2">
                    <a t-attf-href="/my/oacis/student/assignments/#{assignment.id}"
                       class="btn btn-sm btn-primary">
                      <t t-esc="'View / Submit' if not sub or sub.state in ('draft','returned') else 'View Submission'"/>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </t>

      </div>
    </t>
  </template>

  <!--
  =====================================================
  TEMPLATE: ASSIGNMENT DETAIL (view + submit)
  =====================================================
  -->
  <template id="portal_student_assignment_detail"
            name="Assignment Detail">
    <t t-call="oacis_portal_student.portal_student_layout">
      <div class="container">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item">
              <a href="/my/oacis/student/assignments">Assignments</a>
            </li>
            <li class="breadcrumb-item active">
              <t t-esc="assignment.title"/>
            </li>
          </ol>
        </nav>

        <div class="card mb-3">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
              <t t-esc="assignment.course_id.code"/> —
              <t t-esc="assignment.course_id.name"/>
            </h4>
            <span t-att-class="'badge ' + ('bg-success' if assignment.assignment_state == 'published' else 'bg-dark')">
              <t t-esc="assignment.assignment_state"/>
            </span>
          </div>
          <div class="card-body">
            <h5><t t-esc="assignment.title"/></h5>

            <div class="row mb-3">
              <div class="col-md-3">
                <div class="border rounded p-2 text-center">
                  <div class="text-muted small">Type</div>
                  <div><t t-esc="assignment.assignment_type"/></div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="border rounded p-2 text-center">
                  <div class="text-muted small">Due Date</div>
                  <div>
                    <t t-esc="assignment.due_date"/>
                    <t t-if="assignment.due_time"> at <t t-esc="assignment.due_time"/></t>
                  </div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="border rounded p-2 text-center">
                  <div class="text-muted small">Max Marks</div>
                  <div><t t-esc="assignment.max_marks"/></div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="border rounded p-2 text-center">
                  <div class="text-muted small">Instructor</div>
                  <div>
                    <t t-esc="assignment.faculty_member_id.display_name if assignment.faculty_member_id else '—'"/>
                  </div>
                </div>
              </div>
            </div>

            <t t-if="assignment.description">
              <h6>Description</h6>
              <div t-raw="assignment.description"/>
            </t>

            <t t-if="assignment.attachment_ids">
              <h6>Reference Files</h6>
              <ul class="list-unstyled">
                <t t-foreach="assignment.attachment_ids" t-as="att">
                  <li>
                    <a t-attf-href="/web/content/#{att.id}?download=true"
                       target="_blank">
                      <i class="fa fa-file-o"/> <t t-esc="att.name"/>
                    </a>
                  </li>
                </t>
              </ul>
            </t>

            <t t-if="assignment.rubric_id">
              <h6>Rubric</h6>
              <table class="table table-sm table-bordered">
                <thead>
                  <tr>
                    <th>Criterion</th>
                    <th class="text-center">Max Points</th>
                    <th>Description</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-foreach="assignment.rubric_id.criterion_ids" t-as="criterion">
                    <tr>
                      <td><t t-esc="criterion.name"/></td>
                      <td class="text-center"><t t-esc="criterion.max_points"/></td>
                      <td><t t-esc="criterion.description"/></td>
                    </tr>
                  </t>
                </tbody>
                <tfoot>
                  <tr>
                    <th>Total</th>
                    <th class="text-center">
                      <t t-esc="assignment.rubric_id.total_points"/>
                    </th>
                    <th/>
                  </tr>
                </tfoot>
              </table>
            </t>
          </div>
        </div>

        <!-- Submission status / form -->
        <div class="card mb-3">
          <div class="card-header">
            <h5 class="mb-0">Your Submission</h5>
          </div>
          <div class="card-body">

            <t t-if="submission and submission.state == 'graded'">
              <div class="alert alert-success">
                <i class="fa fa-check-circle"/> This assignment has been graded.
              </div>
              <div class="row">
                <div class="col-md-3">
                  <div class="border rounded p-2 text-center">
                    <div class="text-muted small">Marks</div>
                    <div class="h4">
                      <t t-esc="submission.marks_obtained"/> / <t t-esc="assignment.max_marks"/>
                    </div>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="border rounded p-2 text-center">
                    <div class="text-muted small">Percentage</div>
                    <div class="h4"><t t-esc="submission.marks_percentage"/>%</div>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="border rounded p-2 text-center">
                    <div class="text-muted small">Grade</div>
                    <div class="h4"><t t-esc="submission.grade_letter or '—'"/></div>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="border rounded p-2 text-center">
                    <div class="text-muted small">Submitted</div>
                    <div><t t-esc="submission.submission_date"/></div>
                  </div>
                </div>
              </div>
              <t t-if="submission.feedback">
                <div class="mt-3">
                  <h6>Feedback</h6>
                  <div t-raw="submission.feedback"/>
                </div>
              </t>
              <t t-if="submission.submission_file">
                <a t-attf-href="/web/content/oacis.assignment.submission/#{submission.id}/submission_file?download=true&amp;filename=#{submission.submission_filename}"
                   class="btn btn-outline-primary btn-sm mt-2">
                  <i class="fa fa-download"/> Download my submission
                </a>
              </t>
            </t>

            <t t-elif="submission and submission.state == 'returned'">
              <div class="alert alert-warning">
                <i class="fa fa-undo"/> Your submission was returned for revision.
              </div>
              <t t-if="submission.feedback">
                <h6>Feedback</h6>
                <div t-raw="submission.feedback"/>
              </t>
              <form t-attf-action="/my/oacis/student/assignments/#{assignment.id}/submit"
                    method="post" enctype="multipart/form-data"
                    class="mt-3">
                <input type="hidden" name="csrf_token"
                       t-att-value="csrf_token"/>
                <div class="mb-3">
                  <label class="form-label">Updated File</label>
                  <input type="file" class="form-control"
                         name="submission_file"/>
                </div>
                <div class="mb-3">
                  <label class="form-label">Notes</label>
                  <textarea class="form-control" rows="3"
                            name="submission_text"/>
                </div>
                <button type="submit" class="btn btn-primary">
                  <i class="fa fa-paper-plane"/> Resubmit
                </button>
              </form>
            </t>

            <t t-elif="can_submit">
              <form t-attf-action="/my/oacis/student/assignments/#{assignment.id}/submit"
                    method="post" enctype="multipart/form-data">
                <input type="hidden" name="csrf_token"
                       t-att-value="csrf_token"/>
                <div class="mb-3">
                  <label class="form-label">Upload File</label>
                  <input type="file" class="form-control"
                         name="submission_file" id="submission_file"/>
                  <div class="form-text">
                    <t t-esc="'PDF, DOCX or ZIP up to a few MB.'"/>
                  </div>
                </div>
                <div class="mb-3">
                  <label class="form-label">Notes (optional)</label>
                  <textarea class="form-control" rows="3"
                            name="submission_text"
                            placeholder="Anything the instructor should know..."/>
                </div>
                <button type="submit" class="btn btn-primary">
                  <i class="fa fa-paper-plane"/> Submit Assignment
                </button>
              </form>
            </t>

            <t t-elif="submission and submission.state in ('submitted','late')">
              <div t-att-class="'alert ' + ('alert-warning' if submission.state == 'late' else 'alert-info')">
                <i class="fa fa-paper-plane"/>
                You have already submitted this assignment
                <t t-if="submission.is_late">(late)</t> on
                <t t-esc="submission.submission_date"/>.
              </div>
              <t t-if="submission.submission_file">
                <a t-attf-href="/web/content/oacis.assignment.submission/#{submission.id}/submission_file?download=true&amp;filename=#{submission.submission_filename}"
                   class="btn btn-outline-primary btn-sm">
                  <i class="fa fa-download"/> Download my submission
                </a>
              </t>
            </t>

            <t t-else="">
              <div class="alert alert-secondary">
                <i class="fa fa-lock"/>
                This assignment is not accepting submissions right now.
                <t t-if="assignment.assignment_state == 'closed'">
                  It has been closed by the instructor.
                </t>
              </div>
            </t>

          </div>
        </div>
      </div>
    </t>
  </template>

</odoo>
