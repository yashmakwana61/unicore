<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data>
    <!-- ============================================= -->
    <!-- WINDOW ACTIONS (must precede views that      -->
    <!-- reference them via %(xmlid)d)                -->
    <!-- ============================================= -->
    <record id="action_unicore_course_prerequisite" model="ir.actions.act_window">
      <field name="name">Prerequisites</field>
      <field name="res_model">unicore.course.prerequisite</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('course_id', '=', active_id)]</field>
      <field name="context">{'default_course_id': active_id}</field>
    </record>
    <record id="action_unicore_course_offering" model="ir.actions.act_window">
      <field name="name">Course Offerings</field>
      <field name="res_model">unicore.course.offering</field>
      <field name="view_mode">kanban,list,form</field>
      <field name="context">{'search_default_group_by_semester': 1}</field>
    </record>
    <!-- ============================================= -->
    <!-- FORM VIEW                                     -->
    <!-- ============================================= -->
    <record id="view_unicore_course_form" model="ir.ui.view">
      <field name="name">unicore.course.form</field>
      <field name="model">unicore.course</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <field name="course_state" widget="statusbar" clickable="True"/>
            <button name="action_approve" type="object" string="Approve" invisible="course_state != 'draft'"/>
            <button name="action_activate" type="object" string="Activate" invisible="course_state != 'approved'" class="btn-primary"/>
            <button name="action_discontinue" type="object" string="Discontinue" invisible="course_state != 'active'"/>
            <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="course_state == 'draft'" groups="unicore_base.group_unicore_admin"/>
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button name="%(action_unicore_course_prerequisite)d" type="action" class="oe_stat_button" icon="fa-link" context="{'default_course_id': id}">
                <field name="prerequisite_count" widget="statinfo" string="Prerequisites"/>
              </button>
              <button type="object" class="oe_stat_button" icon="fa-graduation-cap" readonly="1">
                <field name="program_count" widget="statinfo" string="Programs"/>
              </button>
              <button name="%(action_unicore_course_offering)d" type="action" class="oe_stat_button" icon="fa-calendar" context="{'search_default_course_id': id}">
                <field name="offering_count" widget="statinfo" string="Offerings"/>
              </button>
            </div>
            <widget name="web_ribbon" title="Discontinued" invisible="course_state != 'discontinued'" bg_color="text-bg-danger"/>
            <group>
              <group string="Identity">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" options="{'no_create': True}"/>
                <field name="department_id" required="is_legacy_institution"/>
                <field name="academic_faculty_id" readonly="1"/>
              </group>
              <group string="Classification">
                <field name="course_category"/>
                <field name="course_type"/>
                <field name="is_graded"/>
              </group>
            </group>
            <group>
              <group string="Credit &amp; Contact Hours">
                <field name="credit_hours" required="is_legacy_institution"/>
                <field name="is_legacy_institution" invisible="1"/>
                <field name="theory_hours"/>
                <field name="lab_hours"/>
                <field name="tutorial_hours"/>
              </group>
              <group string="Assessment">
                <field name="has_internal_assessment"/>
                <field name="internal_assessment_marks" invisible="not has_internal_assessment"/>
                <field name="external_assessment_marks"/>
                <field name="total_marks" readonly="1"/>
                <field name="passing_marks"/>
                <field name="passing_percentage" readonly="1" widget="percentage"/>
              </group>
            </group>
            <notebook>
              <page string="Prerequisites" name="prerequisites">
                <field name="prerequisite_ids" nolabel="1">
                  <list editable="bottom">
                    <field name="prerequisite_course_id"/>
                    <field name="prerequisite_type"/>
                    <field name="minimum_grade"/>
                    <field name="notes"/>
                  </list>
                </field>
              </page>
              <page string="Description" name="description">
                <field name="description" nolabel="1"/>
              </page>
              <page string="Syllabus" name="syllabus">
                <field name="syllabus" nolabel="1"/>
              </page>
              <page string="Learning Outcomes" name="learning_outcomes">
                <field name="learning_outcomes" nolabel="1"/>
              </page>
              <page string="Reference Materials" name="reference_materials">
                <field name="reference_books" nolabel="1"/>
              </page>
              <page string="Approval Info" name="approval_info">
                <group>
                  <group>
                    <field name="course_state" readonly="1"/>
                  </group>
                  <group>
                    <field name="approved_by_id" readonly="1"/>
                    <field name="approved_on" readonly="1"/>
                  </group>
                </group>
              </page>
            </notebook>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>
    <!-- ============================================= -->
    <!-- LIST VIEW                                     -->
    <!-- ============================================= -->
    <record id="view_unicore_course_list" model="ir.ui.view">
      <field name="name">unicore.course.list</field>
      <field name="model">unicore.course</field>
      <field name="arch" type="xml">
        <list decoration-success="course_state == 'active'" decoration-muted="course_state == 'discontinued'" decoration-info="course_state == 'draft'">
          <field name="code"/>
          <field name="name"/>
          <field name="department_id"/>
          <field name="course_category"/>
          <field name="course_type"/>
          <field name="credit_hours"/>
          <field name="course_state"/>
        </list>
      </field>
    </record>
    <!-- ============================================= -->
    <!-- SEARCH VIEW                                   -->
    <!-- ============================================= -->
    <record id="view_unicore_course_search" model="ir.ui.view">
      <field name="name">unicore.course.search</field>
      <field name="model">unicore.course</field>
      <field name="arch" type="xml">
        <search>
          <field name="name"/>
          <field name="code"/>
          <field name="department_id"/>
          <filter name="active_courses" string="Active" domain="[('course_state', '=', 'active')]"/>
          <filter name="draft_courses" string="Draft" domain="[('course_state', '=', 'draft')]"/>
          <separator/>
          <filter name="core_courses" string="Core" domain="[('course_category', '=', 'core')]"/>
          <filter name="elective_courses" string="Elective" domain="[('course_category', '=', 'elective')]"/>
          <group>
            <filter name="group_by_department" string="Department" context="{'group_by': 'department_id'}"/>
            <filter name="group_by_category" string="Course Category" context="{'group_by': 'course_category'}"/>
            <filter name="group_by_type" string="Course Type" context="{'group_by': 'course_type'}"/>
            <filter name="group_by_state" string="Status" context="{'group_by': 'course_state'}"/>
          </group>
        </search>
      </field>
    </record>
    <!-- ============================================= -->
    <!-- KANBAN VIEW                                   -->
    <!-- ============================================= -->
    <record id="view_unicore_course_kanban" model="ir.ui.view">
      <field name="name">unicore.course.kanban</field>
      <field name="model">unicore.course</field>
      <field name="arch" type="xml">
        <kanban default_group_by="course_state">
          <templates>
            <t t-name="card">
              <div class="oe_kanban_card oe_kanban_global_click">
                <div class="o_kanban_card_header">
                  <strong>
                    <field name="code"/>
                  </strong>
                </div>
                <div class="o_kanban_card_body">
                  <div>
                    <field name="name"/>
                  </div>
                  <div>
                    <field name="department_id"/>
                  </div>
                  <div class="o_kanban_card_bottom">
                    <span class="o_kanban_badge">
                      <field name="credit_hours"/> hrs
                                        </span>
                    <span class="o_kanban_badge" t-if="record.course_state.raw_value == 'active'" style="background-color: #28a745; color: white;">
                                            Active
                                        </span>
                    <span class="o_kanban_badge" t-if="record.course_state.raw_value == 'draft'" style="background-color: #17a2b8; color: white;">
                                            Draft
                                        </span>
                    <span class="o_kanban_badge" t-if="record.course_state.raw_value == 'discontinued'" style="background-color: #6c757d; color: white;">
                                            Discontinued
                                        </span>
                    <span class="o_kanban_badge" t-if="record.course_state.raw_value == 'approved'" style="background-color: #007bff; color: white;">
                                            Approved
                                        </span>
                  </div>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>
    <!-- ============================================= -->
    <!-- WINDOW ACTION                                 -->
    <!-- ============================================= -->
    <record id="action_unicore_course" model="ir.actions.act_window">
      <field name="name">Courses</field>
      <field name="res_model">unicore.course</field>
      <field name="view_mode">list,kanban,form</field>
    </record>
  </data>
</odoo>
