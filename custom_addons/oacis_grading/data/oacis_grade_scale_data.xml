<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data noupdate="1">
    <!-- Default 4-Point Grade Scale -->
    <record id="oacis_grade_scale_default_4pt" model="oacis.grade.scale">
      <field name="name">Standard 4.0 Grade Scale</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="sequence">10</field>
      <field name="is_default">True</field>
      <field name="max_gpa">4.0</field>
      <field name="description">Standard 4-point GPA scale used for
        undergraduate and postgraduate programs.</field>
    </record>
    <!-- Grade Scale Lines \u2014 A+ to F -->
    <record id="line_a_plus" model="oacis.grade.scale.line">
      <field name="scale_id" ref="oacis_grade_scale_default_4pt"/>
      <field name="letter_grade">A+</field>
      <field name="min_percentage">90.0</field>
      <field name="max_percentage">100.0</field>
      <field name="grade_point">4.0</field>
      <field name="is_passing">True</field>
      <field name="description">Outstanding</field>
    </record>
    <record id="line_a" model="oacis.grade.scale.line">
      <field name="scale_id" ref="oacis_grade_scale_default_4pt"/>
      <field name="letter_grade">A</field>
      <field name="min_percentage">80.0</field>
      <field name="max_percentage">89.99</field>
      <field name="grade_point">4.0</field>
      <field name="is_passing">True</field>
      <field name="description">Excellent</field>
    </record>
    <record id="line_b_plus" model="oacis.grade.scale.line">
      <field name="scale_id" ref="oacis_grade_scale_default_4pt"/>
      <field name="letter_grade">B+</field>
      <field name="min_percentage">75.0</field>
      <field name="max_percentage">79.99</field>
      <field name="grade_point">3.5</field>
      <field name="is_passing">True</field>
      <field name="description">Very Good</field>
    </record>
    <record id="line_b" model="oacis.grade.scale.line">
      <field name="scale_id" ref="oacis_grade_scale_default_4pt"/>
      <field name="letter_grade">B</field>
      <field name="min_percentage">65.0</field>
      <field name="max_percentage">74.99</field>
      <field name="grade_point">3.0</field>
      <field name="is_passing">True</field>
      <field name="description">Good</field>
    </record>
    <record id="line_c_plus" model="oacis.grade.scale.line">
      <field name="scale_id" ref="oacis_grade_scale_default_4pt"/>
      <field name="letter_grade">C+</field>
      <field name="min_percentage">55.0</field>
      <field name="max_percentage">64.99</field>
      <field name="grade_point">2.5</field>
      <field name="is_passing">True</field>
      <field name="description">Above Average</field>
    </record>
    <record id="line_c" model="oacis.grade.scale.line">
      <field name="scale_id" ref="oacis_grade_scale_default_4pt"/>
      <field name="letter_grade">C</field>
      <field name="min_percentage">45.0</field>
      <field name="max_percentage">54.99</field>
      <field name="grade_point">2.0</field>
      <field name="is_passing">True</field>
      <field name="description">Average</field>
    </record>
    <record id="line_d" model="oacis.grade.scale.line">
      <field name="scale_id" ref="oacis_grade_scale_default_4pt"/>
      <field name="letter_grade">D</field>
      <field name="min_percentage">40.0</field>
      <field name="max_percentage">44.99</field>
      <field name="grade_point">1.0</field>
      <field name="is_passing">True</field>
      <field name="description">Pass</field>
    </record>
    <record id="line_f" model="oacis.grade.scale.line">
      <field name="scale_id" ref="oacis_grade_scale_default_4pt"/>
      <field name="letter_grade">F</field>
      <field name="min_percentage">0.0</field>
      <field name="max_percentage">39.99</field>
      <field name="grade_point">0.0</field>
      <field name="is_passing">False</field>
      <field name="description">Fail</field>
    </record>
  </data>
</odoo>
