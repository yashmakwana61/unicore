<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Expose the new kanban/calendar/pivot/graph/activity views through the
         view switcher on the existing actions. -->

    <record id="action_oacis_grade_entry" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,pivot,graph,activity</field>
    </record>

    <record id="action_oacis_grade_entry_my" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,pivot,graph,activity</field>
    </record>

    <record id="action_oacis_grade_entry_pending" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,pivot,graph,activity</field>
    </record>

    <record id="action_oacis_grade_scale" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="action_oacis_semester_result" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
    </record>

    <record id="action_oacis_semester_result_my" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
    </record>

</odoo>
