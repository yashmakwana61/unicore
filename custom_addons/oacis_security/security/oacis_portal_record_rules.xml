<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
    =========================================================================
    STUDENT SELF-VIEW RECORD RULES
    =========================================================================
    These rules enforce portal data isolation at the database layer.
    Every rule links the current user's partner_id to student records,
    ensuring portal users can only see their own data.

    Target group: group_oacis_student
    Pattern:
      Model with student_id → [('student_id.partner_id', '=', user.partner_id.id)]
      oacis.student       → [('partner_id', '=', user.partner_id.id)]

    NOTE: Portal controllers currently use .sudo() which bypasses these
    rules. The proper fix requires:
      1. Adding ACLs (perm_read=1) for group_oacis_student on each model
      2. Removing .sudo() from portal controller queries
    These rules serve as defense-in-depth for any code path not using .sudo().
    =========================================================================
    -->
    <data noupdate="1">

        <!-- ============================================================== -->
        <!-- oacis.student — own record only                              -->
        <!-- ============================================================== -->
        <record id="rule_oacis_student_self_view" model="ir.rule">
            <field name="name">Student: Self-View (Own Record Only)</field>
            <field name="model_id" ref="oacis_student.model_oacis_student"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('oacis_base.group_oacis_student'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ============================================================== -->
        <!-- oacis.enrollment — own enrollments only                      -->
        <!-- ============================================================== -->
        <record id="rule_oacis_enrollment_self_view" model="ir.rule">
            <field name="name">Enrollment: Self-View (Own Enrollments Only)</field>
            <field name="model_id" ref="oacis_admission.model_oacis_enrollment"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('oacis_base.group_oacis_student'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ============================================================== -->
        <!-- oacis.grade.entry — own published/locked grades only         -->
        <!-- ============================================================== -->
        <record id="rule_oacis_grade_entry_self_view" model="ir.rule">
            <field name="name">Grade Entry: Self-View (Own Published Grades)</field>
            <field name="model_id" ref="oacis_grading.model_oacis_grade_entry"/>
            <field name="global" eval="False"/>
            <field name="domain_force">['&amp;', ('student_id.partner_id', '=', user.partner_id.id), ('entry_state', 'in', ('published', 'locked'))]</field>
            <field name="groups" eval="[(4, ref('oacis_base.group_oacis_student'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ============================================================== -->
        <!-- oacis.semester.result — own published results only            -->
        <!-- ============================================================== -->
        <record id="rule_oacis_semester_result_self_view" model="ir.rule">
            <field name="name">Semester Result: Self-View (Own Published Only)</field>
            <field name="model_id" ref="oacis_grading.model_oacis_semester_result"/>
            <field name="global" eval="False"/>
            <field name="domain_force">['&amp;', ('student_id.partner_id', '=', user.partner_id.id), ('is_published', '=', True)]</field>
            <field name="groups" eval="[(4, ref('oacis_base.group_oacis_student'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

