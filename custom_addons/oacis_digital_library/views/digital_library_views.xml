<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_unicore_digital_material_tree" model="ir.ui.view">
            <field name="name">unicore.digital.material.tree</field>
            <field name="model">unicore.digital.material</field>
            <field name="arch" type="xml">
                <list string="Digital Materials">
                    <field name="title"/>
                    <field name="author"/>
                    <field name="subject_id"/>
                    <field name="file_type"/>
                    <field name="access_level"/>
                </list>
            </field>
        </record>

        <record id="view_unicore_digital_material_form" model="ir.ui.view">
            <field name="name">unicore.digital.material.form</field>
            <field name="model">unicore.digital.material</field>
            <field name="arch" type="xml">
                <form string="Digital Material">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="title" placeholder="Title..."/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="author"/>
                                <field name="subject_id"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="file_type"/>
                                <field name="file_name" invisible="1"/>
                                <field name="file_content" filename="file_name"/>
                                <field name="access_level"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1" placeholder="Brief description of the material..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_unicore_digital_material_search" model="ir.ui.view">
            <field name="name">unicore.digital.material.search</field>
            <field name="model">unicore.digital.material</field>
            <field name="arch" type="xml">
                <search string="Search Digital Materials">
                    <field name="title"/>
                    <field name="author"/>
                    <field name="subject_id"/>
                    <filter string="PDFs" name="filter_pdf" domain="[('file_type', '=', 'pdf')]"/>
                    <filter string="Audio" name="filter_audio" domain="[('file_type', '=', 'audio')]"/>
                    <group>
                        <filter string="Subject" name="group_by_subject" context="{'group_by': 'subject_id'}"/>
                        <filter string="File Type" name="group_by_file_type" context="{'group_by': 'file_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_unicore_digital_material" model="ir.actions.act_window">
            <field name="name">Digital Materials</field>
            <field name="res_model">unicore.digital.material</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_unicore_digital_material_search"/>
        </record>
    </data>
</odoo>
