<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_oacis_discipline_record_student_own" model="ir.rule">
            <field name="name">Discipline Record: Student Own</field>
            <field name="model_id" ref="model_oacis_discipline_record"/>
            <field name="domain_force">[('student_id.partner_id.user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('oacis_base.group_oacis_student'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
        <record id="rule_oacis_discipline_record_faculty_own" model="ir.rule">
            <field name="name">Discipline Record: Faculty Reported</field>
            <field name="model_id" ref="model_oacis_discipline_record"/>
            <field name="domain_force">[('reported_by.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('oacis_base.group_oacis_faculty'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
