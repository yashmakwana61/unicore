<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_oacis_misbehaviour_category_tree" model="ir.ui.view">
            <field name="name">oacis.misbehaviour.category.tree</field>
            <field name="model">oacis.misbehaviour.category</field>
            <field name="arch" type="xml">
                <list string="Misbehaviour Categories">
                    <field name="name"/>
                    <field name="severity_level"/>
                </list>
            </field>
        </record>

        <record id="view_oacis_discipline_record_tree" model="ir.ui.view">
            <field name="name">oacis.discipline.record.tree</field>
            <field name="model">oacis.discipline.record</field>
            <field name="arch" type="xml">
                <list string="Discipline Records">
                    <field name="student_id" widget="many2one_avatar"/>
                    <field name="category_id"/>
                    <field name="reported_by"/>
                    <field name="incident_date"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-warning="state == 'under_review'"
                           decoration-danger="state == 'action_taken'"
                           decoration-success="state == 'closed'"/>
                </list>
            </field>
        </record>

        <record id="view_oacis_discipline_record_form" model="ir.ui.view">
            <field name="name">oacis.discipline.record.form</field>
            <field name="model">oacis.discipline.record</field>
            <field name="arch" type="xml">
                <form string="Discipline Record">
                    <header>
                        <button name="action_under_review" string="Submit for Review" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_take_action" string="Record Action Taken" type="object" class="oe_highlight" invisible="state != 'under_review'"/>
                        <button name="action_close" string="Close" type="object" invisible="state != 'action_taken'"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state in ('closed', 'cancelled')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,under_review,action_taken,closed"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="student_id" widget="many2one_avatar"/>
                                <field name="company_id" invisible="1"/>
                                <field name="category_id"/>
                            </group>
                            <group>
                                <field name="reported_by"/>
                                <field name="incident_date"/>
                            </group>
                        </group>
                        <group string="Incident Details">
                            <field name="description" nolabel="1" placeholder="Describe the incident..."/>
                        </group>
                        <group string="Action Taken" invisible="state == 'draft'">
                            <field name="action_taken" nolabel="1" placeholder="Describe the action taken..."/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_oacis_discipline_record" model="ir.actions.act_window">
            <field name="name">Discipline Records</field>
            <field name="res_model">oacis.discipline.record</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new discipline record
              </p>
            </field>
        </record>

        <record id="action_oacis_misbehaviour_category" model="ir.actions.act_window">
            <field name="name">Misbehaviour Categories</field>
            <field name="res_model">oacis.misbehaviour.category</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
