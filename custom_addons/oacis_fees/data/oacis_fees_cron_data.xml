<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Server Action: Batch Create GL Invoices -->
        <record id="action_batch_create_gl_invoices" model="ir.actions.server">
            <field name="name">Oacis Fees: Batch Create GL Invoices</field>
            <field name="model_id" ref="oacis_fees.model_oacis_fee_invoice"/>
            <field name="state">code</field>
            <field name="code">env['oacis.fee.invoice'].action_batch_create_gl_invoices()</field>
        </record>

        <!-- Cron Job: Batch Create GL Invoices -->
        <record id="cron_batch_create_gl_invoices" model="ir.cron">
            <field name="name">Oacis Fees: Batch Create GL Invoices</field>
            <field name="ir_actions_server_id" ref="action_batch_create_gl_invoices"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="nextcall" eval="DateTime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">5</field>
        </record>

        <!-- Payment reconciliation is now handled directly in GL module via payment recording -->
        <!-- Batch reconciliation server action and cron job removed -->

    </data>
</odoo>
