<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_oacis_fee_invoice" model="ir.sequence">
            <field name="name">Oacis Fee Invoice</field>
            <field name="code">oacis.fee.invoice</field>
            <field name="prefix">INV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_oacis_fee_payment" model="ir.sequence">
            <field name="name">Oacis Fee Payment</field>
            <field name="code">oacis.fee.payment</field>
            <field name="prefix">RCP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
