<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Phase 1: Invoice search view - missing filters + group-bys -->
    <!-- ========================================================= -->
    <record id="view_fee_invoice_search_phase1_filters" model="ir.ui.view">
        <field name="name">oacis.fee.invoice.search.phase1</field>
        <field name="model">oacis.fee.invoice</field>
        <field name="inherit_id" ref="oacis_fees.view_oacis_fee_invoice_search"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='semester_id']" position="after">
                <field name="academic_year_id"/>
                <field name="fee_structure_id"/>
                <field name="due_date"/>
                <field name="invoice_date"/>
            </xpath>

            <xpath expr="//filter[@name='overdue']" position="after">
                <filter name="draft" string="Draft" domain="[('invoice_state','=','draft')]"/>
                <filter name="sent" string="Sent to Student" domain="[('invoice_state','=','sent')]"/>
                <filter name="partial" string="Partially Paid" domain="[('invoice_state','=','partial')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('invoice_state','=','cancelled')]"/>
            </xpath>

            <xpath expr="//filter[@name='group_by_state']" position="after">
                <filter name="group_by_academic_year" string="Academic Year" context="{'group_by': 'academic_year_id'}"/>
                <filter name="group_by_fee_structure" string="Fee Structure" context="{'group_by': 'fee_structure_id'}"/>

            </xpath>

        </field>
    </record>

</odoo>
