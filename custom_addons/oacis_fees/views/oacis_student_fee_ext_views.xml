<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_oacis_student_fee_ext" model="ir.ui.view">
        <field name="name">oacis.student.fee.ext</field>
        <field name="model">oacis.student</field>
        <field name="inherit_id" ref="oacis_student.oacis_student_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_fee_invoices" class="oe_stat_button" icon="fa-credit-card" groups="oacis_base.group_oacis_finance">
                    <field name="fee_invoice_count" widget="statinfo" string="Fee Invoices"/>
                </button>
                <button type="object" name="action_view_fee_invoices" class="oe_stat_button" icon="fa-exclamation-triangle" invisible="not has_fee_dues" groups="oacis_base.group_oacis_finance">
                    <field name="total_fees_due" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <span class="o_stat_text">Outstanding</span>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
