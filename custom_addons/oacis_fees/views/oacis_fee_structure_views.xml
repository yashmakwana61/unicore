<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_oacis_fee_structure_form" model="ir.ui.view">
    <field name="name">oacis.fee.structure.form</field>
    <field name="model">oacis.fee.structure</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_activate" string="Activate" type="object" invisible="structure_state != 'draft'" class="btn-primary"/>
          <button name="action_archive_structure" string="Archive" type="object" invisible="structure_state != 'active'" groups="oacis_base.group_oacis_admin"/>
          <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="structure_state == 'draft'" groups="oacis_base.group_oacis_admin"/>
          <field name="structure_state" widget="statusbar" statusbar_visible="draft,active,archived"/>
        </header>
        <sheet>
          <widget name="web_ribbon" title="Active" invisible="structure_state != 'active'" bg_color="text-bg-success"/>
          <group>
            <group string="Structure Details">
              <field name="name"/>
              <field name="company_id"/>
              <field name="academic_year_id"/>
              <field name="semester_id"/>
              <field name="program_id"/>
              <field name="campus_id"/>
              <field name="currency_id"/>
            </group>
            <group string="Payment Settings">
              <field name="is_installment_allowed"/>
              <field name="installment_count" invisible="not is_installment_allowed"/>
              <field name="fee_due_date"/>
              <field name="late_fee_percentage"/>
              <field name="total_amount" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Fee Components">
              <field name="line_ids">
                <list editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="fee_type"/>
                  <field name="name"/>
                  <field name="amount"/>
                  <field name="is_mandatory"/>
                  <field name="is_refundable"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="view_oacis_fee_structure_list" model="ir.ui.view">
    <field name="name">oacis.fee.structure.list</field>
    <field name="model">oacis.fee.structure</field>
    <field name="arch" type="xml">
      <list decoration-success="structure_state == 'active'" decoration-muted="structure_state == 'archived'">
        <field name="name"/>
        <field name="academic_year_id"/>
        <field name="semester_id"/>
        <field name="program_id"/>
        <field name="campus_id"/>
        <field name="total_amount"/>
        <field name="currency_id"/>
        <field name="structure_state"/>
      </list>
    </field>
  </record>
  <record id="view_oacis_fee_structure_search" model="ir.ui.view">
    <field name="name">oacis.fee.structure.search</field>
    <field name="model">oacis.fee.structure</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="program_id"/>
        <field name="academic_year_id"/>
        <separator/>
        <filter name="active_only" string="Active" domain="[('structure_state','=','active')]"/>
        <separator/>
        <filter name="group_by_year" string="Academic Year" context="{'group_by':'academic_year_id'}"/>
        <filter name="group_by_program" string="Program" context="{'group_by':'program_id'}"/>
      </search>
    </field>
  </record>
  <record id="action_oacis_fee_structure" model="ir.actions.act_window">
    <field name="name">Fee Structures</field>
    <field name="res_model">oacis.fee.structure</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
