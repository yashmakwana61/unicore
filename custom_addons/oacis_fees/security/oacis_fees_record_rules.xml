<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- Fee Structure                                                 -->
        <!-- ============================================================ -->
        <record id="rule_unicore_fee_structure_company" model="ir.rule">
            <field name="name">Fee Structure: Company Isolation</field>
            <field name="model_id" ref="unicore_fees.model_unicore_fee_structure"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_unicore_fee_structure_admin" model="ir.rule">
            <field name="name">Fee Structure: Admin Bypass</field>
            <field name="model_id" ref="unicore_fees.model_unicore_fee_structure"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!-- Fee Invoice                                                   -->
        <!-- ============================================================ -->
        <record id="rule_unicore_fee_invoice_company" model="ir.rule">
            <field name="name">Fee Invoice: Company Isolation</field>
            <field name="model_id" ref="unicore_fees.model_unicore_fee_invoice"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_unicore_fee_invoice_student" model="ir.rule">
            <field name="name">Fee Invoice: Student Own Invoices</field>
            <field name="model_id" ref="unicore_fees.model_unicore_fee_invoice"/>
            <field name="domain_force">[('student_id.partner_id.user_ids','in',[user.id])]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_student'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_unicore_fee_invoice_admin" model="ir.rule">
            <field name="name">Fee Invoice: Admin Bypass</field>
            <field name="model_id" ref="unicore_fees.model_unicore_fee_invoice"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>


        <!-- ============================================================ -->
        <!-- Fee Payment                                                   -->
        <!-- ============================================================ -->
        <record id="rule_unicore_fee_payment_company" model="ir.rule">
            <field name="name">Fee Payment: Company Isolation</field>
            <field name="model_id" ref="unicore_fees.model_unicore_fee_payment"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_unicore_fee_payment_student" model="ir.rule">
            <field name="name">Fee Payment: Student Own Payments</field>
            <field name="model_id" ref="unicore_fees.model_unicore_fee_payment"/>
            <field name="domain_force">[('invoice_id.student_id.partner_id.user_ids','in',[user.id])]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_student'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_unicore_fee_payment_admin" model="ir.rule">
            <field name="name">Fee Payment: Admin Bypass</field>
            <field name="model_id" ref="unicore_fees.model_unicore_fee_payment"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
