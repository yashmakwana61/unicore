<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_edicai_document_form" model="ir.ui.view">
    <field name="name">edicai.document.form</field>
    <field name="model">edicai.document</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_activate" string="Activate" type="object" invisible="document_state != 'draft'" class="btn-primary" groups="edicai_base.group_edicai_registrar,edicai_base.group_edicai_faculty"/>
          <button name="action_verify" string="Verify Document" type="object" invisible="document_state != 'active' or is_verified" groups="edicai_base.group_edicai_registrar"/>
          <button name="action_create_new_version" string="New Version" type="object" invisible="document_state != 'active'" groups="edicai_base.group_edicai_registrar"/>
          <button name="action_archive_document" string="Archive" type="object" invisible="document_state in ('archived','draft')" groups="edicai_base.group_edicai_admin"/>
          <field name="document_state" widget="statusbar" statusbar_visible="draft,active,archived" clickable="False"/>
        </header>
        <sheet>
          <widget name="web_ribbon" title="VERIFIED" invisible="not is_verified" bg_color="text-bg-success"/>
          <widget name="web_ribbon" title="CONFIDENTIAL" invisible="not is_confidential" bg_color="text-bg-danger"/>
          <widget name="web_ribbon" title="EXPIRED" invisible="not is_expired" bg_color="text-bg-secondary"/>
          <group>
            <group string="Document Identity">
              <field name="name"/>
              <field name="document_number"/>
              <field name="company_id"/>
              <field name="category_id"/>
              <field name="document_type"/>
              <field name="tags"/>
            </group>
            <group string="Linked Record">
              <field name="student_id" widget="many2one_avatar"/>
              <field name="faculty_member_id"/>
              <field name="applicant_id"/>
            </group>
          </group>
          <group>
            <group string="Dates">
              <field name="upload_date"/>
              <field name="document_date"/>
              <field name="expiry_date"/>
              <field name="is_expired" readonly="1"/>
            </group>
            <group string="Access">
              <field name="is_student_visible"/>
              <field name="is_confidential"/>
              <field name="version" readonly="1"/>
              <field name="is_latest_version" readonly="1"/>
              <field name="previous_version_id" invisible="not previous_version_id" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Files">
              <field name="attachment_ids" widget="many2many_binary"/>
              <group class="mt-2">
                <field name="primary_attachment_id" domain="[('id','in',attachment_ids)]"/>
                <field name="file_type" readonly="1"/>
                <field name="file_size" readonly="1"/>
                <field name="file_count" readonly="1"/>
              </group>
            </page>
            <page string="Verification">
              <group>
                <field name="is_verified" readonly="1"/>
                <field name="verified_by_id" readonly="1"/>
                <field name="verified_on" readonly="1"/>
                <field name="verification_notes"/>
              </group>
            </page>
            <page string="Notes">
              <field name="description" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_edicai_document_list" model="ir.ui.view">
    <field name="name">edicai.document.list</field>
    <field name="model">edicai.document</field>
    <field name="arch" type="xml">
      <list decoration-success="is_verified and document_state == 'active'" decoration-warning="not is_verified and document_state == 'active'" decoration-muted="document_state == 'archived'" decoration-danger="is_expired">
        <field name="name"/>
        <field name="category_id"/>
        <field name="document_type"/>
        <field name="student_id" widget="many2one_avatar"/>
        <field name="faculty_member_id"/>
        <field name="upload_date"/>
        <field name="expiry_date"/>
        <field name="file_count"/>
        <field name="is_verified"/>
        <field name="is_confidential"/>
        <field name="document_state"/>
      </list>
    </field>
  </record>

  <record id="view_edicai_document_kanban" model="ir.ui.view">
    <field name="name">edicai.document.kanban</field>
    <field name="model">edicai.document</field>
    <field name="arch" type="xml">
      <kanban>
        <templates>
          <t t-name="card">
            <div class="edicai-kanban-document w-100 h-100 d-flex flex-column position-relative">
              <div class="edicai-document-icon text-center mt-2">
                <i class="fa fa-file-text-o"/>
              </div>
              
              <div class="edicai-kanban-title text-center mt-2">
                <field name="name"/>
              </div>
              <div class="edicai-kanban-subtitle text-center">
                <field name="category_id"/>
              </div>
              
              <div class="edicai-meta-row justify-content-center mt-2">
                <field name="document_type"/>
              </div>

              <div class="edicai-document-status d-flex gap-1">
                <t t-if="record.is_verified.raw_value">
                  <span class="edicai-badge edicai-status-success"><i class="fa fa-check-circle me-1"/>Verified</span>
                </t>
                <t t-if="record.is_confidential.raw_value">
                  <span class="edicai-badge edicai-status-danger"><i class="fa fa-lock me-1"/>Confidential</span>
                </t>
                <t t-if="record.is_expired.raw_value">
                  <span class="edicai-badge edicai-status-neutral"><i class="fa fa-clock-o me-1"/>Expired</span>
                </t>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_edicai_document_search" model="ir.ui.view">
    <field name="name">edicai.document.search</field>
    <field name="model">edicai.document</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="student_id" widget="many2one_avatar"/>
        <field name="faculty_member_id"/>
        <field name="document_type"/>
        <field name="category_id"/>
        <field name="tags"/>
        <filter name="active" string="Active" domain="[('document_state','=','active')]"/>
        <filter name="verified" string="Verified" domain="[('is_verified','=',True)]"/>
        <filter name="unverified" string="Unverified" domain="[('is_verified','=',False),('document_state','=','active')]"/>
        <filter name="expired" string="Expired" domain="[('expiry_date','&lt;',context_today().strftime('%Y-%m-%d')),('expiry_date','!=',False)]"/>
        <filter name="student_visible" string="Student Visible" domain="[('is_student_visible','=',True)]"/>
        <group name="group_by">
          <filter name="group_by_category" string="Category" context="{'group_by':'category_id'}"/>
          <filter name="group_by_type" string="Document Type" context="{'group_by':'document_type'}"/>
          <filter name="group_by_student" string="Student" context="{'group_by':'student_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Window Actions -->
  <record id="action_edicai_document_all" model="ir.actions.act_window">
    <field name="name">All Documents</field>
    <field name="res_model">edicai.document</field>
    <field name="view_mode">list,kanban,form</field>
    <field name="context">{'search_default_active': 1}</field>
  </record>

  <record id="action_edicai_document_student" model="ir.actions.act_window">
    <field name="name">Student Documents</field>
    <field name="res_model">edicai.document</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('category_type','=','student')]</field>
    <field name="context">{'search_default_active': 1}</field>
  </record>

  <record id="action_edicai_document_institutional" model="ir.actions.act_window">
    <field name="name">Institutional Documents</field>
    <field name="res_model">edicai.document</field>
    <field name="view_mode">list,kanban,form</field>
    <field name="domain">[('category_type','=','institutional')]</field>
  </record>

  <record id="action_edicai_document_unverified" model="ir.actions.act_window">
    <field name="name">Pending Verification</field>
    <field name="res_model">edicai.document</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('is_verified','=',False),('document_state','=','active')]</field>
  </record>

  <!-- Extend student form with Documents button -->
  <record id="view_edicai_student_doc_ext" model="ir.ui.view">
    <field name="name">edicai.student.doc.ext</field>
    <field name="model">edicai.student</field>
    <field name="inherit_id" ref="edicai_student.edicai_student_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button type="object" name="action_view_documents" class="oe_stat_button" icon="fa-file-text" groups="edicai_base.group_edicai_registrar">
          <field name="document_count" widget="statinfo" string="Documents"/>
        </button>
      </xpath>
    </field>
  </record>

  <!-- Extend faculty form with Documents button -->
  <record id="view_edicai_faculty_doc_ext" model="ir.ui.view">
    <field name="name">edicai.faculty.doc.ext</field>
    <field name="model">edicai.faculty.member</field>
    <field name="inherit_id" ref="edicai_faculty_profile.edicai_faculty_member_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button type="object" name="action_view_documents" class="oe_stat_button" icon="fa-file-text" groups="edicai_base.group_edicai_admin">
          <field name="document_count" widget="statinfo" string="Documents"/>
        </button>
      </xpath>
    </field>
  </record>

</odoo>
