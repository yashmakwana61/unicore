<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hostel_allocation_search_phase1_filters" model="ir.ui.view">
        <field name="name">unicore.hostel.allocation.search.phase1</field>
        <field name="model">unicore.hostel.allocation</field>
        <field name="inherit_id" ref="unicore_hostel.view_unicore_hostel_allocation_search"/>
        <field name="arch" type="xml">

            <xpath expr="//filter[@name='no_deposit']" position="after">
                <filter name="filter_checked_out" string="Checked Out"
                    domain="[('allocation_state','=','checked_out')]"/>
                <filter name="filter_cancelled" string="Cancelled"
                    domain="[('allocation_state','=','cancelled')]"/>
                <filter name="filter_no_show" string="No Show"
                    domain="[('allocation_state','=','no_show')]"/>
            </xpath>

        </field>
    </record>

    <record id="view_hostel_maintenance_search_phase1_filters" model="ir.ui.view">
        <field name="name">unicore.hostel.maintenance.search.phase1</field>
        <field name="model">unicore.hostel.maintenance</field>
        <field name="inherit_id" ref="unicore_hostel.view_unicore_hostel_maintenance_search"/>
        <field name="arch" type="xml">

            <xpath expr="//filter[@name='resolved']" position="after">
                <filter name="filter_cancelled" string="Cancelled"
                    domain="[('maintenance_state','=','cancelled')]"/>
            </xpath>

        </field>
    </record>

</odoo>
