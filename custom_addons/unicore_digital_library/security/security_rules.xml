<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_unicore_digital_material_student" model="ir.rule">
            <field name="name">Digital Material: Student Access</field>
            <field name="model_id" ref="model_unicore_digital_material"/>
            <field name="domain_force">[('access_level', 'in', ['all', 'enrolled_only'])]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_student'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
