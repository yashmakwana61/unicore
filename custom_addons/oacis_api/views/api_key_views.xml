<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_oacis_api_key_tree" model="ir.ui.view">
    <field name="name">oacis.api.key.tree</field>
    <field name="model">oacis.api.key</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="user_id"/>
        <field name="scope"/>
        <field name="daily_limit"/>
        <field name="call_count"/>
        <field name="expires_on"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_oacis_api_key_form" model="ir.ui.view">
    <field name="name">oacis.api.key.form</field>
    <field name="model">oacis.api.key</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_generate_key"
                    type="object"
                    string="Generate Key"
                    class="oe_stat_button"
                    icon="fa-refresh"
                    groups="oacis_api.group_oacis_api_admin"
                    help="Generate a new secret. It is shown once and never stored in plaintext."/>
          </div>
          <widget name="web_ribbon"
                  text="Expired"
                  bg_color="danger"
                  invisible="expires_on == False or expires_on &gt; current_date()"/>
          <group>
            <group>
              <field name="name"/>
              <field name="user_id"/>
              <field name="scope"/>
              <field name="active"/>
            </group>
            <group>
              <field name="token_hash"
                     readonly="1"
                     password="True"
                     groups="oacis_api.group_oacis_api_admin"/>
              <field name="expires_on"/>
              <field name="daily_limit"/>
              <field name="company_id"
                     groups="base.group_multi_company"/>
            </group>
          </group>
          <notebook>
            <page string="Usage">
              <group>
                <group>
                  <field name="call_count"/>
                  <field name="last_usage"/>
                  <field name="last_ip"/>
                </group>
              </group>
            </page>
            <page string="Notes" groups="base.group_no_one">
              <field name="notes"/>
            </page>
          </notebook>
          <chatter/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_oacis_api_key_search" model="ir.ui.view">
    <field name="name">oacis.api.key.search</field>
    <field name="model">oacis.api.key</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="user_id"/>
        <field name="scope"/>
        <filter name="active"
                string="Active"
                domain="[('active','=',True)]"/>
        <filter name="expired"
                string="Expired"
                domain="[('expires_on','&lt;=',context_today().isoformat())]"/>
        <separator/>
        <filter name="read_scope"
                string="Read Only"
                domain="[('scope','=','read')]"/>
        <filter name="write_scope"
                string="Read &amp; Write"
                domain="[('scope','=','write')]"/>
        <filter name="admin_scope"
                string="Full Access"
                domain="[('scope','=','admin')]"/>
        <group name="group_by">
          <filter name="group_by_scope"
                  string="Scope"
                  context="{'group_by': 'scope'}"/>
          <filter name="group_by_user"
                  string="User"
                  context="{'group_by': 'user_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_oacis_api_key_kanban" model="ir.ui.view">
    <field name="name">oacis.api.key.kanban</field>
    <field name="model">oacis.api.key</field>
    <field name="arch" type="xml">
      <kanban>
        <field name="name"/>
        <field name="scope"/>
        <field name="call_count"/>
        <field name="daily_limit"/>
        <field name="expires_on"/>
        <field name="active"/>
        <templates>
          <t t-name="kanban-card">
            <div class="oe_kanban_global_click">
              <div class="o_kanban_card_header">
                <field name="name"/>
              </div>
              <div class="o_kanban_card_content">
                <field name="scope"/>
                <field name="call_count"/> / <field name="daily_limit"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_oacis_api_key_token_wizard_form" model="ir.ui.view">
    <field name="name">oacis.api.key.token.wizard.form</field>
    <field name="model">oacis.api.key.token.wizard</field>
    <field name="arch" type="xml">
      <form string="Your New API Key">
        <div class="alert alert-warning" role="alert">
          Copy this key now. For security it will
          <b>never be shown again</b> and is not stored on the server.
        </div>
        <group>
          <field name="key_id"/>
          <field name="full_token" password="False" readonly="1"/>
        </group>
        <footer>
          <button name="action_done"
                  type="object"
                  string="I have saved the key"
                  class="btn-primary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_oacis_api_key" model="ir.actions.act_window">
    <field name="name">API Keys</field>
    <field name="res_model">oacis.api.key</field>
    <field name="view_mode">list,form,kanban</field>
  </record>

  <record id="ir_rule_oacis_api_key_company" model="ir.rule">
    <field name="name">API Key: Multi-Company</field>
    <field name="model_id" ref="model_oacis_api_key"/>
    <field name="global" eval="True"/>
    <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
