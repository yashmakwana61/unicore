<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <!-- Extend the UniCore company form (defined in unicore_base) to add the
         institution profile driver. Inherit the unicore view, not base, to keep
         field ordering. -->
  <record id="view_res_company_form_inherit_institution_profile" model="ir.ui.view">
    <field name="name">res.company.form.inherit.institution.profile</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="unicore_base.view_res_company_form_inherit_unicore"/>
    <field name="arch" type="xml">
      <field name="university_type" position="after">
        <field name="institution_profile_id" options="{'no_create': True}"/>
        <field name="terminology_profile_id" readonly="1" invisible="institution_profile_id == False"/>
        <field name="enabled_feature_codes" readonly="1" invisible="institution_profile_id == False" help="Feature codes enabled by this profile — controls which module menus are shown."/>
      </field>
    </field>
  </record>
</odoo>
