<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Window Action -->
    <record id="action_unicore_grading_scheme" model="ir.actions.act_window">
        <field name="name">Grading Schemes</field>
        <field name="res_model">unicore.grading.scheme</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>

    <!-- List View -->
    <record id="unicore_grading_scheme_list_view" model="ir.ui.view">
        <field name="name">unicore.grading.scheme.list</field>
        <field name="model">unicore.grading.scheme</field>
        <field name="arch" type="xml">
            <list string="Grading Schemes">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="scheme_type" optional="show"/>
                <field name="is_default" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="unicore_grading_scheme_form_view" model="ir.ui.view">
        <field name="name">unicore.grading.scheme.form</field>
        <field name="model">unicore.grading.scheme</field>
        <field name="arch" type="xml">
            <form string="Grading Scheme">
                <sheet>
                    <group>
                        <group name="left">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="scheme_type"/>
                        </group>
                        <group name="right">
                            <field name="is_default"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
