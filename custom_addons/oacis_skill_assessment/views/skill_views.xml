<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_oacis_skill_tree" model="ir.ui.view">
            <field name="name">oacis.skill.tree</field>
            <field name="model">oacis.skill</field>
            <field name="arch" type="xml">
                <list string="Skills">
                    <field name="name"/>
                    <field name="category"/>
                </list>
            </field>
        </record>

        <record id="view_oacis_skill_form" model="ir.ui.view">
            <field name="name">oacis.skill.form</field>
            <field name="model">oacis.skill</field>
            <field name="arch" type="xml">
                <form string="Skill">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="category"/>
                            </group>
                            <group>
                                <field name="company_id"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_oacis_skill_assessment_tree" model="ir.ui.view">
            <field name="name">oacis.student.skill.assessment.tree</field>
            <field name="model">oacis.student.skill.assessment</field>
            <field name="arch" type="xml">
                <list string="Skill Assessments">
                    <field name="student_id" widget="many2one_avatar"/>
                    <field name="skill_id"/>
                    <field name="proficiency_level" widget="badge"
                           decoration-muted="proficiency_level == 'beginner'"
                           decoration-info="proficiency_level == 'intermediate'"
                           decoration-success="proficiency_level == 'advanced'"
                           decoration-danger="proficiency_level == 'expert'"/>
                    <field name="assessed_by_id"/>
                    <field name="date_assessed"/>
                </list>
            </field>
        </record>

        <record id="view_oacis_skill_assessment_form" model="ir.ui.view">
            <field name="name">oacis.student.skill.assessment.form</field>
            <field name="model">oacis.student.skill.assessment</field>
            <field name="arch" type="xml">
                <form string="Skill Assessment">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="student_id" widget="many2one_avatar"/>
                                <field name="company_id" invisible="1"/>
                                <field name="skill_id"/>
                                <field name="proficiency_level"/>
                            </group>
                            <group>
                                <field name="assessed_by_id"/>
                                <field name="date_assessed"/>
                            </group>
                        </group>
                        <group string="Comments">
                            <field name="comments" nolabel="1" placeholder="Assessment comments..."/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_oacis_skill_assessment_search" model="ir.ui.view">
            <field name="name">oacis.student.skill.assessment.search</field>
            <field name="model">oacis.student.skill.assessment</field>
            <field name="arch" type="xml">
                <search string="Search Skill Assessments">
                    <field name="student_id" widget="many2one_avatar"/>
                    <field name="skill_id"/>
                    <group>
                        <filter string="Skill" name="group_by_skill" context="{'group_by': 'skill_id'}"/>
                        <filter string="Proficiency" name="group_by_level" context="{'group_by': 'proficiency_level'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_oacis_skill" model="ir.actions.act_window">
            <field name="name">Skills</field>
            <field name="res_model">oacis.skill</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_oacis_skill_assessment" model="ir.actions.act_window">
            <field name="name">Skill Assessments</field>
            <field name="res_model">oacis.student.skill.assessment</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_oacis_skill_assessment_search"/>
        </record>
    </data>
</odoo>
