<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Expose the new kanban/calendar/pivot/graph/activity views through the
         view switcher on the existing actions. -->

    <record id="action_unicore_scholarship_application" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph,activity</field>
    </record>

    <record id="action_unicore_scholarship_award" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
    </record>

    <record id="action_unicore_scholarship_program" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban</field>
    </record>

</odoo>
