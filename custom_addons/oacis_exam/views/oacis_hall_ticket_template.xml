    <template id="oacis_hall_ticket_styles">
        <style>
            .ht-copy {
                margin: 0;
                padding: 0;
            }
            .ht-copy-label {
                text-align: right;
                font-size: 8pt;
                color: #666;
                margin-bottom: 2mm;
                padding: 1mm 2mm;
                border-bottom: 0.5pt solid #ccc;
                text-transform: uppercase;
                letter-spacing: 1pt;
            }
            .ht-copy-label-inst {
                color: #c0392b;
            }
            .ht-card {
                position: relative;
                padding: 0;
                margin: 0;
                font-family: Arial, sans-serif;
                font-size: 9pt;
                color: #222;
                border: 1pt solid #1e3a5f;
                border-radius: 2mm;
                overflow: hidden;
                background: #ffffff;
            }
            .ht-ribbon {
                height: 3mm;
                background: linear-gradient(90deg, #1e3a5f, #2563eb, #1e3a5f);
            }
            .ht-body {
                padding: 5mm 6mm 4mm 6mm;
            }
            .ht-header-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 2mm;
            }
            .ht-photo-box {
                width: 30mm;
                height: 35mm;
                border: 1pt solid #333;
                display: inline-block;
                text-align: center;
                overflow: hidden;
                background: #f5f5f5;
            }
            .ht-photo-placeholder {
                display: block;
                margin-top: 10mm;
                font-size: 7pt;
                color: #999;
            }
            .ht-title {
                text-align: center;
                font-size: 14pt;
                font-weight: bold;
                color: #1e3a5f;
                letter-spacing: 1.5pt;
                margin: 3mm 0 1mm 0;
            }
            .ht-subtitle {
                text-align: center;
                font-size: 9pt;
                color: #555;
                margin-bottom: 4mm;
                padding-bottom: 2mm;
                border-bottom: 0.5pt solid #1e3a5f;
            }
            .ht-info-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 4mm;
            }
            .ht-info-table td {
                padding: 1.5mm 1mm;
                border-bottom: 0.5pt solid #ddd;
                vertical-align: top;
            }
            .ht-label {
                font-weight: bold;
                color: #555;
                width: 26mm;
                font-size: 8pt;
            }
            .ht-value {
                color: #222;
            }
            .ht-value-emphasis {
                font-size: 11pt;
                font-weight: bold;
                color: #1e3a5f;
            }
            .ht-section-title {
                font-size: 10pt;
                font-weight: bold;
                color: #1e3a5f;
                margin: 3mm 0 1.5mm 0;
                padding: 0.5mm 0;
                border-bottom: 1pt solid #2563eb;
            }
            .ht-schedule-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 4mm;
                font-size: 8.5pt;
            }
            .ht-schedule-table th {
                background-color: #1e3a5f;
                color: white;
                padding: 1.5mm 1mm;
                text-align: left;
                font-size: 8pt;
            }
            .ht-schedule-table td {
                padding: 1.2mm 1mm;
                border-bottom: 0.5pt solid #ddd;
            }
            .ht-schedule-table tbody tr:nth-child(even) {
                background-color: #f8faff;
            }
            .ht-eligibility-box {
                border: 1pt solid #ddd;
                border-radius: 1mm;
                padding: 2mm 3mm;
                margin-bottom: 4mm;
                background: #fafafa;
            }
            .ht-eligible-badge {
                display: inline-block;
                color: #155724;
                font-weight: bold;
                font-size: 10pt;
                border: 1pt solid #155724;
                border-radius: 1mm;
                padding: 1mm 3mm;
                background: #d4edda;
            }
            .ht-ineligible-badge {
                display: inline-block;
                color: #721c24;
                font-weight: bold;
                font-size: 10pt;
                border: 1pt solid #721c24;
                border-radius: 1mm;
                padding: 1mm 3mm;
                background: #f8d7da;
            }
            .ht-eligibility-note {
                margin-top: 1.5mm;
                font-size: 8pt;
                color: #721c24;
                font-style: italic;
            }
            .ht-ticket-state {
                display: inline-block;
                margin-left: 3mm;
                font-size: 8pt;
                font-weight: bold;
                color: #155724;
                border: 0.5pt solid #155724;
                border-radius: 0.5mm;
                padding: 0.5mm 2mm;
                background: #d4edda;
            }
            .ht-ticket-blocked {
                color: #721c24;
                border-color: #721c24;
                background: #f8d7da;
            }
            .ht-instructions {
                font-size: 8pt;
                line-height: 1.6;
                margin-bottom: 4mm;
                padding: 1mm 0;
            }
            .ht-instructions ol li {
                margin-bottom: 0.5mm;
            }
            .ht-signature-table {
                width: 100%;
                border-collapse: collapse;
                margin: 5mm 0 3mm 0;
            }
            .ht-disclaimer {
                text-align: center;
                font-size: 6.5pt;
                color: #999;
                margin-top: 2mm;
                padding-top: 1mm;
                border-top: 0.5pt solid #ddd;
            }
        </style>
    </template>
</odoo>
