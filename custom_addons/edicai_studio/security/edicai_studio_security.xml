<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="rule_studio_app_company" model="ir.rule">
            <field name="name">Studio App: company isolation</field>
            <field name="model_id" ref="model_studio_app"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
        </record>
        <record id="rule_studio_record_company" model="ir.rule">
            <field name="name">Studio Record: company isolation</field>
            <field name="model_id" ref="model_studio_record"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
        </record>
    </data>
</odoo>
