<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_studio_export_wizard_form" model="ir.ui.view">
        <field name="name">studio.export.wizard.form</field>
        <field name="model">studio.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Studio DSL">
                <group>
                    <field name="app_id" readonly="1"/>
                    <field name="filename_out" readonly="1"/>
                </group>
                <group>
                    <field name="preview" readonly="1" widget="ace" options="{'mode':'json'}" nolabel="1"/>
                </group>
                <group invisible="not file">
                    <field name="file" filename="filename_out" readonly="1"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generate" type="object" class="btn-primary" invisible="file"/>
                    <button special="cancel" string="Close"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_studio_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Studio App</field>
        <field name="res_model">studio.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
