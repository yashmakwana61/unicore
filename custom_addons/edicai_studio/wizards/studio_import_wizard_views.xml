<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_studio_import_wizard_form" model="ir.ui.view">
        <field name="name">studio.import.wizard.form</field>
        <field name="model">studio.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Studio DSL">
                <group>
                    <field name="upload" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="app_id" placeholder="Leave empty to create new app"/>
                </group>
                <group>
                    <field name="preview_json" readonly="1" widget="ace" options="{'mode':'json'}" nolabel="1" placeholder="Click Preview to validate DSL"/>
                </group>
                <footer>
                    <button name="action_preview" string="Preview / Validate" type="object" class="btn-primary"/>
                    <button name="action_import" string="Import" type="object" class="btn-primary oe_highlight" invisible="not preview_json"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_studio_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Studio App (.studio.json)</field>
        <field name="res_model">studio.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
