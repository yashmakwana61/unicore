<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_studio_ai_request_list" model="ir.ui.view">
        <field name="name">studio.ai.request.list</field>
        <field name="model">studio.ai.request</field>
        <field name="arch" type="xml">
            <list string="AI Requests (Audit)">
                <field name="name"/>
                <field name="prompt" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="dsl_valid" widget="boolean_toggle"/>
                <field name="state" widget="badge" decoration-success="state=='approved'"/>
                <field name="cost_tokens" optional="hide"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="view_studio_ai_request_form" model="ir.ui.view">
        <field name="name">studio.ai.request.form</field>
        <field name="model">studio.ai.request</field>
        <field name="arch" type="xml">
            <form string="AI Request">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="prompt" readonly="1"/>
                        <field name="user_id" readonly="1"/>
                        <field name="app_id" readonly="1"/>
                        <field name="state"/>
                        <field name="dsl_valid" readonly="1"/>
                        <field name="cost_tokens" readonly="1"/>
                    </group>
                    <group string="Tool Calls (RAG + Validate)"><field name="tool_calls_json" widget="ace" options="{'mode':'json'}" readonly="1" nolabel="1"/></group>
                    <group string="DSL Proposed"><field name="dsl_proposed" widget="ace" options="{'mode':'json'}" readonly="1" nolabel="1"/></group>
                </sheet>
                <div class="oe_chatter"><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="action_studio_ai_request" model="ir.actions.act_window">
        <field name="name">AI Audit Log</field>
        <field name="res_model">studio.ai.request</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_studio_ai_copilot" model="ir.actions.client">
        <field name="name">Ask Forge — AI Copilot</field>
        <field name="tag">studio.ai_copilot</field>
    </record>
</odoo>
