<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="portal_my_home_menu_grievance" name="Portal layout : grievance menu entries" inherit_id="portal.portal_breadcrumbs" priority="20">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li t-if="page_name == 'grievance' or page_name == 'grievance_new'" t-attf-class="breadcrumb-item #{'active ' if not grievance else ''}">
                    <a t-if="grievance" t-attf-href="/my/grievances?{{ keep_query() }}">Grievances</a>
                    <t t-else="">Grievances</t>
                </li>
            </xpath>
        </template>

        <template id="portal_my_home_grievance" name="Show Grievances" customize_show="True" inherit_id="portal.portal_my_home" priority="20">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Grievances</t>
                    <t t-set="url" t-value="'/my/grievances'"/>
                    <t t-set="placeholder_count" t-value="'grievance_count'"/>
                </t>
            </xpath>
        </template>

        <template id="portal_my_grievances" name="My Grievances">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Grievances</t>
                </t>
                <div class="mb-3">
                    <a href="/my/grievance/new" class="btn btn-primary">Raise Grievance</a>
                </div>
                <t t-if="not grievances">
                    <p>There are currently no grievances for your account.</p>
                </t>
                <t t-if="grievances">
                    <table class="table rounded mb-0 bg-white o_portal_my_doc_table">
                        <thead>
                            <tr class="active">
                                <th>Category</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="grievances" t-as="grievance">
                                <tr>
                                    <td>
                                        <a t-attf-href="/my/grievance/#{grievance.id}">
                                            <span t-field="grievance.category_id.name"/>
                                        </a>
                                    </td>
                                    <td><span t-field="grievance.create_date" t-options='{"widget": "date"}'/></td>
                                    <td>
                                        <span t-if="grievance.state == 'new'" class="badge rounded-pill text-bg-info">New</span>
                                        <span t-if="grievance.state == 'in_progress'" class="badge rounded-pill text-bg-warning">In Progress</span>
                                        <span t-if="grievance.state == 'resolved'" class="badge rounded-pill text-bg-success">Resolved</span>
                                        <span t-if="grievance.state == 'escalated'" class="badge rounded-pill text-bg-danger">Escalated</span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div t-if="pager" class="o_portal_pager text-center mt-3">
                        <t t-call="portal.pager"/>
                    </div>
                </t>
            </t>
        </template>

        <template id="portal_grievance_detail" name="Grievance Detail">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="/my/grievances">Grievances</a>
                            </li>
                            <li class="breadcrumb-item active" t-esc="grievance.category_id.name"/>
                        </ol>
                    </nav>
                    <h3>
                        <t t-esc="grievance.category_id.name"/>
                        <span t-if="grievance.state == 'new'" class="badge rounded-pill text-bg-info ms-2">New</span>
                        <span t-if="grievance.state == 'in_progress'" class="badge rounded-pill text-bg-warning ms-2">In Progress</span>
                        <span t-if="grievance.state == 'resolved'" class="badge rounded-pill text-bg-success ms-2">Resolved</span>
                        <span t-if="grievance.state == 'escalated'" class="badge rounded-pill text-bg-danger ms-2">Escalated</span>
                        <span t-if="grievance.state == 'cancelled'" class="badge rounded-pill text-bg-secondary ms-2">Cancelled</span>
                    </h3>
                    <p class="text-muted">
                        Raised on <span t-field="grievance.create_date" t-options='{"widget": "datetime"}'/>
                    </p>
                    <div class="card mb-3">
                        <div class="card-header">Your Description</div>
                        <div class="card-body">
                            <p class="mb-0" style="white-space: pre-line;" t-esc="grievance.description"/>
                        </div>
                    </div>
                    <div t-if="grievance.resolution_notes" class="card border-success mb-3">
                        <div class="card-header bg-success text-white">
                            Resolution
                            <t t-if="grievance.resolution_date">
                                — <span t-field="grievance.resolution_date" t-options='{"widget": "date"}'/>
                            </t>
                        </div>
                        <div class="card-body">
                            <p class="mb-0" style="white-space: pre-line;" t-esc="grievance.resolution_notes"/>
                        </div>
                    </div>
                    <a href="/my/grievances" class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i> Back to My Grievances
                    </a>
                </div>
            </t>
        </template>

        <template id="portal_grievance_new" name="New Grievance">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <h3>Raise a Grievance</h3>
                    <div t-if="error" class="alert alert-danger alert-dismissible fade show" role="alert">
                        <t t-esc="error"/>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                    <form action="/my/grievance/submit" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="mb-3">
                            <label for="category_id" class="form-label">Category</label>
                            <select name="category_id" class="form-select" required="1">
                                <t t-foreach="categories" t-as="cat">
                                    <option t-att-value="cat.id"><t t-esc="cat.name"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="description" class="form-label">Description</label>
                            <textarea name="description" class="form-control" rows="5" required="1"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <a href="/my/grievances" class="btn btn-secondary">Cancel</a>
                    </form>
                </div>
            </t>
        </template>
    </data>
</odoo>
