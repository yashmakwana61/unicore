<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Window Action -->
    <record id="action_unicore_academic_unit" model="ir.actions.act_window">
        <field name="name">Academic Units</field>
        <field name="res_model">unicore.academic.unit</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[]</field>
    </record>

    <!-- List View -->
    <record id="unicore_academic_unit_list_view" model="ir.ui.view">
        <field name="name">unicore.academic.unit.list</field>
        <field name="model">unicore.academic.unit</field>
        <field name="arch" type="xml">
            <list string="Academic Units">
                <field name="name"/>
                <field name="code"/>
                <field name="unit_type_id"/>
                <field name="parent_id" optional="show"/>
                <field name="head_user_id" optional="hide"/>
                <field name="company_id" optional="hide"/>
                <field name="unit_count" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="unicore_academic_unit_form_view" model="ir.ui.view">
        <field name="name">unicore.academic.unit.form</field>
        <field name="model">unicore.academic.unit</field>
        <field name="arch" type="xml">
            <form string="Academic Unit">
                <header>
                    <button name="action_open_children" type="object"
                            string="View Child Units"
                            class="btn-primary"
                            invisible="unit_count == 0"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_children" type="object"
                                class="oe_stat_button" icon="fa-sitemap">
                            <field string="Child Units" name="unit_count" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group name="left">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="unit_type_id" options="{'no_create': True}"/>
                            <field name="parent_id" options="{'no_create': True}"/>
                            <field name="sequence"/>
                        </group>
                        <group name="right">
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="head_user_id"/>
                            <field name="path" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="children" string="Child Units">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="unit_type_id"
                                           domain="[('id', 'in', parent.allowed_child_type_ids)]"
                                           options="{'no_create': True}"/>
                                    <field name="head_user_id" optional="hide"/>
                                    <field name="unit_count"/>
                                </list>
                            </field>
                        </page>
                        <page name="description" string="Description">
                            <group>
                                <field name="notes"/>
                                <field name="active"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="unicore_academic_unit_kanban_view" model="ir.ui.view">
        <field name="name">unicore.academic.unit.kanban</field>
        <field name="model">unicore.academic.unit</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="display_name"/>
                <field name="code"/>
                <field name="unit_type_id"/>
                <field name="unit_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image">
                            <div class="o_kanban_image">
                                <span class="o_image" t-attf-style="background-color: #7c7bad;"/>
                                <span class="o_kanban_record_title">
                                    <strong><field name="unit_type_id" widget="badge"/></strong>
                                </span>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="display_name"/></strong>
                                <div class="text-muted o_kanban_record_subtitle">
                                    <field name="code"/>
                                </div>
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge text-bg-secondary">
                                        <i class="fa fa-sitemap"/> <field name="unit_count"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
