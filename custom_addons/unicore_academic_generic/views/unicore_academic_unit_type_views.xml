<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Window Action -->
    <record id="action_unicore_academic_unit_type" model="ir.actions.act_window">
        <field name="name">Unit Types</field>
        <field name="res_model">unicore.academic.unit.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>

    <!-- List View -->
    <record id="unicore_academic_unit_type_list_view" model="ir.ui.view">
        <field name="name">unicore.academic.unit.type.list</field>
        <field name="model">unicore.academic.unit.type</field>
        <field name="arch" type="xml">
            <list string="Unit Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="allowed_child_type_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="unicore_academic_unit_type_form_view" model="ir.ui.view">
        <field name="name">unicore.academic.unit.type.form</field>
        <field name="model">unicore.academic.unit.type</field>
        <field name="arch" type="xml">
            <form string="Unit Type">
                <sheet>
                    <group>
                        <group name="left">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group name="right">
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Allowed Child Types">
                        <field name="allowed_child_type_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Description">
                        <field name="description"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
