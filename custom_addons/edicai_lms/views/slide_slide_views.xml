<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_slide_slide_form_inherit_edicai_lms" model="ir.ui.view">
            <field name="name">slide.slide.form.inherit.edicai.lms</field>
            <field name="model">slide.slide</field>
            <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
            <field name="arch" type="xml">
                <!-- Add Edicai specific fields after the general slide fields -->
                <xpath expr="//notebook" position="inside">
                    <page string="Edicai Assessments" name="edicai_assessments">
                        <group>
                            <group string="Edicai Assignment">
                                <field name="is_edicai_assignment"/>
                                <field name="edicai_assignment_id" invisible="not is_edicai_assignment" required="is_edicai_assignment"/>
                            </group>
                            <group string="Edicai Quiz">
                                <field name="is_edicai_quiz"/>
                                <field name="edicai_quiz_id" invisible="not is_edicai_quiz" required="is_edicai_quiz"/>
                            </group>
                            <group string="Live Class Integration">
                                <field name="is_live_class"/>
                                <field name="meeting_url" invisible="not is_live_class" required="is_live_class"/>
                                <field name="meeting_datetime" invisible="not is_live_class" required="is_live_class"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
