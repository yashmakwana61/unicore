<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="unicore_campus_form_view" model="ir.ui.view">
        <field name="name">unicore.campus.form</field>
        <field name="model">unicore.campus</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <group>
                        <group name="left">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="campus_type"/>
                            <field name="active"/>
                        </group>
                        <group name="right">
                            <field name="student_capacity"/>
                            <field name="is_main_campus"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="address" string="Address">
                            <group>
                                <field name="street"/>
                                <field name="city"/>
                                <field name="state_id"/>
                                <field name="country_id"/>
                                <field name="zip"/>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="website"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="unicore_campus_list_view" model="ir.ui.view">
        <field name="name">unicore.campus.list</field>
        <field name="model">unicore.campus</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="campus_type"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="unicore_campus_search_view" model="ir.ui.view">
        <field name="name">unicore.campus.search</field>
        <field name="model">unicore.campus</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <record id="action_unicore_campus" model="ir.actions.act_window">
        <field name="name">Campuses</field>
        <field name="res_model">unicore.campus</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
