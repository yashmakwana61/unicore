<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_company_form_inherit_oacis" model="ir.ui.view">
        <field name="name">res.company.form.inherit.oacis</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']/.." position="after">
                <group string="Institution Details">
                    <field name="university_type"/>
                    <field name="established_year"/>
                    <field name="accreditation_body"/>
                    <field name="website" placeholder="Institution Website"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
