<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_oacis_student" model="res.groups">
            <field name="name">Student</field>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="group_oacis_faculty" model="res.groups">
            <field name="name">Faculty</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_oacis_staff" model="res.groups">
            <field name="name">Staff</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_oacis_registrar" model="res.groups">
            <field name="name">Registrar</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_oacis_finance" model="res.groups">
            <field name="name">Finance</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_oacis_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_oacis_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="implied_ids" eval="[(4, ref('base.group_erp_manager')), (4, ref('group_oacis_manager')), (4, ref('group_oacis_registrar')), (4, ref('group_oacis_finance')), (4, ref('group_oacis_staff'))]"/>
        </record>
    </data>
</odoo>
