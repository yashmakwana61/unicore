<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_navigation_preview_form" model="ir.ui.view">
            <field name="name">navigation.preview.wizard.form</field>
            <field name="model">navigation.preview.wizard</field>
            <field name="arch" type="xml">
                <form string="Navigation Preview">
                    <field name="state" invisible="1"/>
                    <field name="info" readonly="1"/>
                    <separator string="Current state:"/>
                    <group>
                        <group>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_enable_preview" type="object"
                                string="Enable Workspace Preview"
                                class="btn-primary" icon="fa-flask"
                                invisible="state == 'on'"
                                confirm="Enable the experimental workspace navigation in THIS database?"/>
                        <button name="action_disable_preview" type="object"
                                string="Disable Preview (Restore Original)"
                                class="btn-secondary" icon="fa-undo"
                                invisible="state == 'off'"
                                confirm="Restore the original navigation layout?"/>
                        <button string="Close" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_navigation_preview_wizard" model="ir.actions.act_window">
            <field name="name">Navigation Preview Toggle</field>
            <field name="res_model">navigation.preview.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Visible only to System administrators, inside Settings -->
        <menuitem id="menu_navigation_preview"
                  name="Navigation Preview"
                  parent="base.menu_administration"
                  action="action_navigation_preview_wizard"
                  groups="base.group_system"
                  sequence="99"/>
    </data>
</odoo>
