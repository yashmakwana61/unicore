<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="oacis_gradebook_template">
        <t t-call="web.html_container">
            <t t-foreach="report_data" t-as="gb">
                <t t-call="oacis_gradebook.oacis_gradebook_styles"/>

                <div class="gb-container">
                    <!-- HEADER -->
                    <div class="gb-header">
                        <div class="gb-institution" t-esc="gb['company_name']"/>
                        <div class="gb-title">GRADE BOOK / MARK SHEET</div>
                        <div class="gb-subhead">Continuous Assessment (Internal Marks) — Assignment Roll-up</div>
                    </div>

                    <!-- COURSE INFO -->
                    <table class="gb-info-table">
                        <tr>
                            <td class="gb-label">Course</td>
                            <td class="gb-value" t-esc="gb['course'].name or gb['offering'].name"/>
                            <td class="gb-label">Code</td>
                            <td class="gb-value" t-esc="gb['course'].code"/>
                        </tr>
                        <tr>
                            <td class="gb-label">Semester</td>
                            <td class="gb-value" t-esc="gb['semester'].name"/>
                            <td class="gb-label">Instructor</td>
                            <td class="gb-value" t-esc="gb['faculty'].name or ''"/>
                        </tr>
                        <tr>
                            <td class="gb-label">CA Max Marks</td>
                            <td class="gb-value" t-esc="gb['max_ca']"/>
                            <td class="gb-label">Assignment Weight</td>
                            <td class="gb-value"><t t-esc="gb['weight']"/>%</td>
                        </tr>
                    </table>

                    <!-- MARK SHEET -->
                    <table class="gb-course-table">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th t-foreach="gb['assignments']" t-as="a"
                                    t-att-title="a['title']"
                                    style="text-align:center;"
                                    t-esc="a['title']"/>
                                <th style="width:12mm;">Graded</th>
                                <th style="width:12mm;">Obtained</th>
                                <th style="width:12mm;">Possible</th>
                                <th style="width:12mm;">%</th>
                                <th style="width:12mm;">CA Marks</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="gb['rows']" t-as="r">
                                <tr>
                                    <td t-esc="r['student'].display_name"/>
                                    <t t-foreach="gb['assignments']" t-as="a">
                                        <td style="text-align:center;"
                                            t-esc="r['scores'].get(a['id'], '')"/>
                                    </t>
                                    <td style="text-align:center;" t-esc="r['graded_count']"/>
                                    <td style="text-align:center;" t-esc="r['total_obtained']"/>
                                    <td style="text-align:center;" t-esc="r['total_possible']"/>
                                    <td style="text-align:center;" t-esc="r['percentage']"/>
                                    <td style="text-align:center;"
                                        t-att-class="'gb-synced' if r['is_synced'] else 'gb-pending'"
                                        t-esc="r['ca_component']"/>
                                </tr>
                            </t>
                            <t t-if="not gb['rows']">
                                <tr><td colspan="8" class="gb-empty">No student lines in this grade book.</td></tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- CLASS SUMMARY -->
                    <table class="gb-summary-table">
                        <tr>
                            <td class="gb-label">Students</td>
                            <td class="gb-value" t-esc="gb['student_count']"/>
                            <td class="gb-label">Class Average</td>
                            <td class="gb-value"><t t-esc="gb['class_avg']"/>%</td>
                            <td class="gb-label">Graded Assignments</td>
                            <td class="gb-value">
                                <t t-esc="gb['graded_assignment_count']"/> / <t t-esc="gb['assignment_count']"/>
                            </td>
                        </tr>
                    </table>

                    <!-- FOOTER -->
                    <div class="gb-footer">
                        <div class="gb-signature-line"></div>
                        <div class="gb-signature-label">Instructor Signature</div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <template id="oacis_gradebook_styles">
        <style>
            .gb-container {
                font-family: Arial, 'Helvetica Neue', sans-serif;
                font-size: 9pt; color: #222; line-height: 1.5;
                padding: 8mm 10mm;
            }
            .gb-header {
                text-align: center; margin-bottom: 5mm;
                padding-bottom: 3mm; border-bottom: 2pt solid #1e3a5f;
            }
            .gb-institution {
                font-size: 16pt; font-weight: bold; color: #1e3a5f;
                letter-spacing: 1pt;
            }
            .gb-title {
                font-size: 13pt; font-weight: bold; color: #2563eb;
                letter-spacing: 2pt; text-transform: uppercase;
                margin: 2mm 0 1mm 0;
            }
            .gb-subhead { font-size: 8pt; color: #666; font-style: italic; }
            .gb-info-table { width: 100%; border-collapse: collapse; margin-bottom: 4mm; }
            .gb-info-table td { padding: 1mm 1.5mm; border-bottom: 0.5pt solid #ddd; }
            .gb-label { font-weight: bold; color: #555; width: 30mm; font-size: 8pt; }
            .gb-value { color: #222; }
            .gb-course-table { width: 100%; border-collapse: collapse; margin-bottom: 4mm; }
            .gb-course-table th, .gb-course-table td {
                border: 0.5pt solid #999; padding: 1.2mm 1.5mm;
            }
            .gb-course-table th { background: #eef2f7; font-size: 8pt; color: #333; }
            .gb-synced { font-weight: bold; color: #166534; }
            .gb-pending { font-weight: bold; color: #b45309; }
            .gb-empty { text-align: center; color: #999; padding: 4mm 0; }
            .gb-summary-table { width: 100%; border-collapse: collapse; margin-bottom: 6mm; }
            .gb-summary-table td { padding: 1.2mm 1.5mm; border-bottom: 0.5pt solid #ddd; }
            .gb-footer { margin-top: 8mm; }
            .gb-signature-line { width: 50mm; border-bottom: 1pt solid #333; margin-bottom: 1mm; }
            .gb-signature-label { font-size: 8pt; color: #555; }
        </style>
    </template>
</odoo>
