<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- GRADE BOOK ASSIGNMENT SCORE LIST                             -->
        <!-- ============================================================ -->

        <record id="view_unicore_gradebook_assignment_line_list"
                model="ir.ui.view">
            <field name="name">unicore.gradebook.assignment.line.list</field>
            <field name="model">unicore.gradebook.assignment.line</field>
            <field name="arch" type="xml">
                <list string="Assignment Scores"
                      decoration-success="percentage >= 60.0"
                      decoration-warning="percentage >= 50.0 and percentage &lt; 60.0"
                      decoration-danger="percentage &lt; 50.0">
                    <field name="student_id"/>
                    <field name="assignment_title"/>
                    <field name="due_date"/>
                    <field name="assignment_type"/>
                    <field name="max_marks"/>
                    <field name="marks_obtained"/>
                    <field name="percentage"/>
                    <field name="is_late"/>
                    <field name="course_id"/>
                    <field name="semester_id"/>
                </list>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- GRADE BOOK ASSIGNMENT SCORE SEARCH                           -->
        <!-- ============================================================ -->

        <record id="view_unicore_gradebook_assignment_line_search"
                model="ir.ui.view">
            <field name="name">unicore.gradebook.assignment.line.search</field>
            <field name="model">unicore.gradebook.assignment.line</field>
            <field name="arch" type="xml">
                <search string="Assignment Scores">
                    <field name="student_id"/>
                    <field name="assignment_id"/>
                    <field name="course_id"/>
                    <field name="semester_id"/>
                    <filter name="filter_late" string="Late"
                            domain="[('is_late', '=', True)]"/>
                    <filter name="filter_low" string="Below 50%"
                            domain="[('percentage', '&lt;', 50.0)]"/>
                    <separator/>
                    <filter name="group_student" string="Student"
                            context="{'group_by': 'student_id'}"/>
                    <filter name="group_assignment" string="Assignment"
                            context="{'group_by': 'assignment_id'}"/>
                    <filter name="group_course" string="Course"
                            context="{'group_by': 'course_id'}"/>
                </search>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- GRADE BOOK ASSIGNMENT SCORE ACTIONS                          -->
        <!-- ============================================================ -->

        <record id="action_unicore_gradebook_assignment_line_all"
                model="ir.actions.act_window">
            <field name="name">Assignment Scores</field>
            <field name="res_model">unicore.gradebook.assignment.line</field>
            <field name="view_mode">list</field>
        </record>

        <record id="action_unicore_gradebook_assignment_line_my"
                model="ir.actions.act_window">
            <field name="name">My Assignment Scores</field>
            <field name="res_model">unicore.gradebook.assignment.line</field>
            <field name="view_mode">list</field>
            <field name="domain">[('student_id.partner_id.user_ids', 'in', [uid])]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No assignment scores yet
                </p>
                <p>
                    Your graded assignment scores across your
                    enrolled courses will appear here.
                </p>
            </field>
        </record>

    </data>
</odoo>
