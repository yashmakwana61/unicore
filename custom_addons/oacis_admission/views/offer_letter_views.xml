<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="offer_letter_form_view" model="ir.ui.view">
        <field name="name">oacis.admission.offer.letter.form</field>
        <field name="model">oacis.admission.offer.letter</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,accepted,rejected,expired"
                           clickable="False"/>
                    <button name="action_send" type="object" string="Send"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_accept" type="object" string="Accept"
                            invisible="state != 'sent'" class="btn-success"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('sent', 'accepted')" class="btn-danger"/>
                    <button name="action_mark_expired" type="object" string="Mark Expired"
                            invisible="state not in ('draft', 'sent')" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="letter_number" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="applicant_id" options="{'no_create_edit': True}"/>
                            <field name="applicant_name" readonly="1"/>
                            <field name="program_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="offer_date"/>
                            <field name="valid_until"/>
                            <field name="response_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Terms &amp; Conditions">
                        <field name="terms" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="offer_letter_list_view" model="ir.ui.view">
        <field name="name">oacis.admission.offer.letter.list</field>
        <field name="model">oacis.admission.offer.letter</field>
        <field name="arch" type="xml">
            <list>
                <field name="letter_number"/>
                <field name="applicant_id"/>
                <field name="program_name"/>
                <field name="offer_date"/>
                <field name="valid_until"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'accepted'"
                       decoration-danger="state in ('rejected', 'expired')"
                       decoration-info="state == 'sent'"/>
            </list>
        </field>
    </record>

    <record id="offer_letter_search_view" model="ir.ui.view">
        <field name="name">oacis.admission.offer.letter.search</field>
        <field name="model">oacis.admission.offer.letter</field>
        <field name="arch" type="xml">
            <search>
                <field name="letter_number"/>
                <field name="applicant_id"/>
                <field name="program_name"/>
                <filter name="sent" string="Sent"
                        domain="[('state', '=', 'sent')]"/>
                <filter name="accepted" string="Accepted"
                        domain="[('state', '=', 'accepted')]"/>
            </search>
        </field>
    </record>

    <record id="action_oacis_admission_offer_letter" model="ir.actions.act_window">
        <field name="name">Offer Letters</field>
        <field name="res_model">oacis.admission.offer.letter</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="offer_letter_search_view"/>
        <field name="help" type="html">
            <p>Manage offer letters sent to merit-listed applicants.
            Track acceptance, rejection, and expiry of offers.</p>
        </field>
    </record>

</odoo>
