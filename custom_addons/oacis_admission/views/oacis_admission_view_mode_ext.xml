<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Expose the new kanban/calendar/pivot/graph/activity views through the
         view switcher on the existing actions. -->

    <record id="action_unicore_admission_applicant" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form,activity</field>
    </record>

    <record id="action_unicore_admission_cycle" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form,calendar</field>
    </record>

    <record id="action_unicore_admission_entrance_test" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar</field>
    </record>

    <record id="action_unicore_admission_offer_letter" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar</field>
    </record>

</odoo>
