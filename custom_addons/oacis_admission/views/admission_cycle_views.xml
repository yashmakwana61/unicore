<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="admission_cycle_seat_list_view" model="ir.ui.view">
    <field name="name">oacis.admission.cycle.seat.list</field>
    <field name="model">oacis.admission.cycle.seat</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="program_id" options="{'no_create_edit': True}"/>
        <field name="total_seats"/>
        <field name="reserved_seats"/>
        <field name="committed_count" readonly="1"/>
        <field name="available_seats" readonly="1"/>
      </list>
    </field>
  </record>
  <record id="admission_cycle_form_view" model="ir.ui.view">
    <field name="name">oacis.admission.cycle.form</field>
    <field name="model">oacis.admission.cycle</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,active,closed" clickable="False"/>
          <button name="action_activate" type="object" string="Activate" invisible="state != 'draft'" class="btn-primary"/>
          <button name="action_close" type="object" string="Close Cycle" invisible="state != 'active'" class="btn-success"/>
          <button name="action_generate_merit_list" type="object" string="Generate Merit List" invisible="state != 'active'" class="btn-primary" confirm="Generate the merit list from current composite scores? Top candidates per program will be merit-listed and the rest waitlisted."/>
          <button name="action_archive" type="object" string="Archive" invisible="state not in ('closed', 'archived')" class="btn-secondary"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_open_website_admissions" type="object" class="oe_stat_button" icon="fa-globe">
              <field string="Active on Website" name="website_cycle_count" widget="statinfo"/>
            </button>
          </div>
          <div class="oe_title">
            <h1>
              <field name="name" placeholder="Cycle Name..."/>
            </h1>
          </div>
          <group>
            <group>
              <field name="code"/>
              <field name="campus_id" options="{'no_create_edit': True}"/>
              <field name="academic_year_id" options="{'no_create_edit': True}"/>
            </group>
            <group>
              <field name="start_date"/>
              <field name="end_date"/>
              <field name="applicant_count" readonly="1"/>
            </group>
          </group>
          <group string="Scoring Weights">
            <group>
              <field name="weight_aggregate" class="oe_inline"/>
              <field name="weight_entrance"/>
              <field name="weight_interview"/>
            </group>
            <group>
              <p>Weights control how the composite score is computed
                            (aggregate % / entrance / interview). They must sum to 100%%.
                            Default: 40 / 40 / 20.</p>
            </group>
          </group>
          <notebook>
            <page name="seats" string="Seat Allocation">
              <field name="seat_ids">
                <list editable="bottom">
                  <field name="program_id" options="{'no_create_edit': True}"/>
                  <field name="total_seats"/>
                  <field name="reserved_seats"/>
                  <field name="committed_count" readonly="1"/>
                  <field name="available_seats" readonly="1"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="admission_cycle_list_view" model="ir.ui.view">
    <field name="name">oacis.admission.cycle.list</field>
    <field name="model">oacis.admission.cycle</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="code"/>
        <field name="campus_id"/>
        <field name="academic_year_id"/>
        <field name="start_date"/>
        <field name="end_date"/>
        <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'draft'" decoration-muted="state in ('closed', 'archived')"/>
        <field name="applicant_count"/>
      </list>
    </field>
  </record>
  <record id="admission_cycle_kanban_view" model="ir.ui.view">
    <field name="name">oacis.admission.cycle.kanban</field>
    <field name="model">oacis.admission.cycle</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_small_cards oa_admission_kanban oa_cycle_kanban">
        <field name="id"/>
        <field name="state" widget="badge"/>
        <field name="name"/>
        <field name="code"/>
        <field name="campus_id"/>
        <field name="academic_year_id"/>
        <field name="start_date"/>
        <field name="end_date"/>
        <field name="applicant_count"/>
        <templates>
          <t t-name="card">
            <div class="oa_cycle_card" t-attf-class="oa_state_{{ record.state.raw_value or 'draft' }}">
              <div class="oa_cycle_card_top">
                <span class="oa_cycle_state_badge" t-attf-class="oa_state_{{ record.state.raw_value or 'draft' }}">
                  <t t-esc="record.state.value"/>
                </span>
                <span class="oa_cycle_code" t-if="record.code.value">
                  <t t-esc="record.code.value"/>
                </span>
              </div>
              <div class="oa_cycle_card_body">
                <div class="oa_cycle_name">
                  <t t-esc="record.name.value"/>
                </div>
                <div class="oa_cycle_meta" t-if="record.campus_id.value">
                  <i class="fa fa-building-o" title="Building"/>
                  <span class="text-truncate">
                    <t t-esc="record.campus_id.value"/>
                  </span>
                </div>
                <div class="oa_cycle_meta" t-if="record.academic_year_id.value">
                  <i class="fa fa-calendar" title="Calendar"/>
                  <span class="text-truncate">
                    <t t-esc="record.academic_year_id.value"/>
                  </span>
                </div>
                <div class="oa_cycle_dates">
                  <span class="oa_cycle_date">
                    <i class="fa fa-sign-in" title="Sign In"/>
                    <t t-if="record.start_date.value">
                      <t t-esc="record.start_date.value"/>
                    </t>
                    <t t-else="">
                      <span class="text-muted">—</span>
                    </t>
                  </span>
                  <span class="oa_cycle_date">
                    <i class="fa fa-sign-out" title="Sign Out"/>
                    <t t-if="record.end_date.value">
                      <t t-esc="record.end_date.value"/>
                    </t>
                    <t t-else="">
                      <span class="text-muted">—</span>
                    </t>
                  </span>
                </div>
              </div>
              <div class="oa_cycle_card_foot">
                <span class="oa_cycle_applicants">
                  <i class="fa fa-users" title="Users"/>
                  <t t-esc="record.applicant_count.value"/> Applicants
                </span>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <record id="admission_cycle_search_view" model="ir.ui.view">
    <field name="name">oacis.admission.cycle.search</field>
    <field name="model">oacis.admission.cycle</field>
    <field name="arch" type="xml">
      <search>
        <searchpanel>
          <field name="campus_id" icon="fa-university" enable_counters="1"/>
          <field name="academic_year_id" icon="fa-calendar" enable_counters="1"/>
        </searchpanel>
        <field name="name"/>
        <field name="code"/>
        <field name="campus_id"/>
        <field name="academic_year_id"/>
        <filter name="active_cycles" string="Active" domain="[('state', '=', 'active')]"/>
        <filter name="draft_cycles" string="Draft" domain="[('state', '=', 'draft')]"/>
      </search>
    </field>
  </record>
  <record id="action_oacis_admission_cycle" model="ir.actions.act_window">
    <field name="name">Admission Cycles</field>
    <field name="res_model">oacis.admission.cycle</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="help" type="html">
      <p>Create and manage admission cycles here. Each cycle represents a
            defined admission period with seat allocations per program. Use the Kanban
            view to organize cycles by state (Draft, Active, Closed, Archived).</p>
    </field>
  </record>
</odoo>
