<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="admission_cycle_seat_list_view" model="ir.ui.view">
    <field name="name">unicore.admission.cycle.seat.list</field>
    <field name="model">unicore.admission.cycle.seat</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="program_id" options="{'no_create_edit': True}"/>
        <field name="total_seats"/>
        <field name="reserved_seats"/>
        <field name="committed_count" readonly="1"/>
        <field name="available_seats" readonly="1"/>
      </list>
    </field>
  </record>
  <record id="admission_cycle_form_view" model="ir.ui.view">
    <field name="name">unicore.admission.cycle.form</field>
    <field name="model">unicore.admission.cycle</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,active,closed" clickable="False"/>
          <button name="action_activate" type="object" string="Activate" invisible="state != 'draft'" class="btn-primary"/>
          <button name="action_close" type="object" string="Close Cycle" invisible="state != 'active'" class="btn-success"/>
          <button name="action_generate_merit_list" type="object" string="Generate Merit List" invisible="state != 'active'" class="btn-primary" confirm="Generate the merit list from current composite scores? Top candidates per program will be merit-listed and the rest waitlisted."/>
          <button name="action_archive" type="object" string="Archive" invisible="state not in ('closed', 'archived')" class="btn-secondary"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" placeholder="Cycle Name..."/>
            </h1>
          </div>
          <group>
            <group>
              <field name="code"/>
              <field name="campus_id" options="{'no_create_edit': True}"/>
              <field name="academic_year_id" options="{'no_create_edit': True}"/>
            </group>
            <group>
              <field name="start_date"/>
              <field name="end_date"/>
              <field name="applicant_count" readonly="1"/>
            </group>
          </group>
          <group string="Scoring Weights">
            <group>
              <field name="weight_aggregate" class="oe_inline"/>
              <field name="weight_entrance"/>
              <field name="weight_interview"/>
            </group>
            <group>
              <p>Weights control how the composite score is computed
                            (aggregate % / entrance / interview). They must sum to 100%%.
                            Default: 40 / 40 / 20.</p>
            </group>
          </group>
          <notebook>
            <page name="seats" string="Seat Allocation">
              <field name="seat_ids">
                <list editable="bottom">
                  <field name="program_id" options="{'no_create_edit': True}"/>
                  <field name="total_seats"/>
                  <field name="reserved_seats"/>
                  <field name="committed_count" readonly="1"/>
                  <field name="available_seats" readonly="1"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="admission_cycle_list_view" model="ir.ui.view">
    <field name="name">unicore.admission.cycle.list</field>
    <field name="model">unicore.admission.cycle</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="code"/>
        <field name="campus_id"/>
        <field name="academic_year_id"/>
        <field name="start_date"/>
        <field name="end_date"/>
        <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'draft'" decoration-muted="state in ('closed', 'archived')"/>
        <field name="applicant_count"/>
      </list>
    </field>
  </record>
  <record id="admission_cycle_kanban_view" model="ir.ui.view">
    <field name="name">unicore.admission.cycle.kanban</field>
    <field name="model">unicore.admission.cycle</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_small_cards">
        <field name="id"/>
        <field name="state"/>
        <field name="name"/>
        <field name="code"/>
        <field name="campus_id"/>
        <field name="academic_year_id"/>
        <field name="start_date"/>
        <field name="end_date"/>
        <field name="applicant_count"/>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_card">
              <div class="oe_kanban_card_header" t-att-class="'state-' + record.state.value">
                <strong>
                  <t t-esc="record.name.value"/>
                </strong>
                <span class="state-badge">
                  <t t-esc="record.state.value"/>
                </span>
              </div>
              <div class="oe_kanban_card_body">
                <div class="oe_kanban_field_line">
                  <span>Code:</span>
                  <t t-esc="record.code.value"/>
                </div>
                <div class="oe_kanban_field_line">
                  <span>Campus:</span>
                  <t t-esc="record.campus_id.value"/>
                </div>
                <div class="oe_kanban_field_line">
                  <span>Academic Year:</span>
                  <t t-esc="record.academic_year_id.value"/>
                </div>
                <div class="oe_kanban_field_line">
                  <span>Start:</span>
                  <t t-esc="record.start_date.value"/>
                </div>
                <div class="oe_kanban_field_line">
                  <span>End:</span>
                  <t t-esc="record.end_date.value"/>
                </div>
                <div class="oe_kanban_field_line">
                  <span>Applicants:</span>
                  <span class="badge badge-info">
                    <t t-esc="record.applicant_count.value"/>
                  </span>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <record id="admission_cycle_search_view" model="ir.ui.view">
    <field name="name">unicore.admission.cycle.search</field>
    <field name="model">unicore.admission.cycle</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="code"/>
        <field name="campus_id"/>
        <field name="academic_year_id"/>
        <filter name="active_cycles" string="Active" domain="[('state', '=', 'active')]"/>
        <filter name="draft_cycles" string="Draft" domain="[('state', '=', 'draft')]"/>
      </search>
    </field>
  </record>
  <record id="action_unicore_admission_cycle" model="ir.actions.act_window">
    <field name="name">Admission Cycles</field>
    <field name="res_model">unicore.admission.cycle</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="search_view_id" ref="admission_cycle_search_view"/>
    <field name="help" type="html">
      <p>Create and manage admission cycles here. Each cycle represents a
            defined admission period with seat allocations per program. Use the Kanban
            view to organize cycles by state (Draft, Active, Closed, Archived).</p>
    </field>
  </record>
</odoo>
