<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="oacis_admission_automation_rule_form_view" model="ir.ui.view">
        <field name="name">oacis.admission.automation.rule.form</field>
        <field name="model">oacis.admission.automation.rule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Rule name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create_edit': True}"/>
                            <field name="trigger_type"/>
                            <field name="trigger_state" invisible="trigger_type != 'on_state_change'"/>
                            <field name="trigger_stage_id" invisible="trigger_type != 'on_stage_change'"/>
                            <field name="date_field" invisible="trigger_type != 'date_based'"/>
                            <field name="date_offset_days" invisible="trigger_type != 'date_based'"/>
                        </group>
                        <group>
                            <field name="channel"/>
                            <field name="mail_template_id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="oacis_admission_automation_rule_list_view" model="ir.ui.view">
        <field name="name">oacis.admission.automation.rule.list</field>
        <field name="model">oacis.admission.automation.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="trigger_type"/>
                <field name="trigger_state"/>
                <field name="trigger_stage_id"/>
                <field name="date_field"/>
                <field name="date_offset_days"/>
                <field name="channel"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="sequence" widget="handle"/>
            </list>
        </field>
    </record>

    <record id="oacis_admission_automation_rule_search_view" model="ir.ui.view">
        <field name="name">oacis.admission.automation.rule.search</field>
        <field name="model">oacis.admission.automation.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="trigger_type"/>
                <filter name="active_rules" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive_rules" string="Inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_oacis_admission_automation_rule" model="ir.actions.act_window">
        <field name="name">Automation Rules</field>
        <field name="res_model">oacis.admission.automation.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Configure deterministic admission automation: fire emails or
            in-app notifications when an applicant changes status/stage, or on
            a date-based schedule. Rules are inactive by default until a
            registrar activates them.</p>
        </field>
    </record>
</odoo>
