<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================
         Admission Cycle Calendar
         ============================================================ -->
    

    <record id="oacis_admission_cycle_calendar_view" model="ir.ui.view">
        <field name="name">oacis.admission.cycle.calendar</field>
        <field name="model">oacis.admission.cycle</field>
        <field name="type">calendar</field>
        <field name="arch" type="xml">
            <calendar date_start="start_date" date_stop="end_date" color="color" string="Admission Cycle Calendar">
                <field name="state"/>
                <field name="campus_id"/>
                <field name="academic_year_id"/>
            </calendar>
        </field>
    </record>

    <!-- ============================================================
         Entrance Test Calendar
         ============================================================ -->
    

    <record id="oacis_entrance_test_calendar_view" model="ir.ui.view">
        <field name="name">oacis.admission.entrance.test.calendar</field>
        <field name="model">oacis.admission.entrance.test</field>
        <field name="type">calendar</field>
        <field name="arch" type="xml">
            <calendar date_start="test_date" color="color" string="Entrance Test Calendar">
                <field name="state"/>
                <field name="cycle_id"/>
                <field name="venue"/>
            </calendar>
        </field>
    </record>

    <!-- ============================================================
         Offer Letter Calendar
         ============================================================ -->
    

    <record id="oacis_offer_letter_calendar_view" model="ir.ui.view">
        <field name="name">oacis.admission.offer.letter.calendar</field>
        <field name="model">oacis.admission.offer.letter</field>
        <field name="type">calendar</field>
        <field name="arch" type="xml">
            <calendar date_start="offer_date" date_stop="valid_until" color="color" string="Offer Letter Calendar">
                <field name="state"/>
                <field name="applicant_id"/>
                <field name="program_name"/>
            </calendar>
        </field>
    </record>

</odoo>
