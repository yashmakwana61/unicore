<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Expose the new kanban/calendar/pivot/graph/activity views through the
         view switcher on the existing actions. -->

    <record id="action_oacis_enrollment_active" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph,activity</field>
    </record>

    <record id="action_oacis_enrollment_all" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
    </record>

    <record id="action_oacis_enrollment_my" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph,activity</field>
    </record>

    <record id="action_oacis_enrollment_waitlist" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
    </record>

</odoo>
