<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="telegram_message_tree" model="ir.ui.view">
        <field name="name">telegram.message.tree</field>
        <field name="model">telegram.message</field>
        <field name="arch" type="xml">
            <list string="Telegram Messages">
                <field name="create_date"/>
                <field name="state"/>
                <field name="telegram_username"/>
                <field name="chat_id"/>
                <field name="message_text"/>
                <field name="partner_id"/>
                <field name="order_id"/>
            </list>
        </field>
    </record>

    <record id="telegram_message_form" model="ir.ui.view">
        <field name="name">telegram.message.form</field>
        <field name="model">telegram.message</field>
        <field name="arch" type="xml">
            <form string="Telegram Message">
                <sheet>
                    <group>
                        <group>
                            <field name="update_id"/>
                            <field name="state"/>
                            <field name="create_date" readonly="1"/>
                            <field name="telegram_username"/>
                            <field name="chat_id"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="order_id"/>
                            <field name="error_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message">
                            <field name="message_text"/>
                        </page>
                        <page string="Raw Update">
                            <field name="raw_update" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="telegram_message_search" model="ir.ui.view">
        <field name="name">telegram.message.search</field>
        <field name="model">telegram.message</field>
        <field name="arch" type="xml">
            <search string="Telegram Messages">
                <field name="message_text"/>
                <field name="telegram_username"/>
                <field name="chat_id"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <filter name="state_order_created" string="Orders Created"
                        domain="[('state', '=', 'order_created')]"/>
                <filter name="state_error" string="Errors"
                        domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
                <filter name="group_partner" string="Customer"
                        context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_telegram_messages" model="ir.actions.act_window">
        <field name="name">Telegram Messages</field>
        <field name="res_model">telegram.message</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_state_order_created': 1}</field>
    </record>

    <menuitem id="menu_telegram_orders"
              name="Telegram Orders"
              parent="sale.sale_order_menu"
              action="action_telegram_messages"
              sequence="100"
              groups="sales_team.group_sale_salesman"/>
</odoo>
