<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_telegram_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.telegram.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_telegram_messages)d" type="action"
                        class="oe_stat_button" icon="fa-paper-plane"
                        context="{'search_default_order_id': 1}"
                        string="Telegram">
                    <field name="telegram_message_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
