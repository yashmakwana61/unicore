<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- VIEWS: oacis.asset.request                                 -->
    <!-- ============================================================ -->

    <!-- ======================== FORM ======================== -->
    <record id="view_oacis_asset_request_form" model="ir.ui.view">
        <field name="name">oacis.asset.request.form</field>
        <field name="model">oacis.asset.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object"
                            string="Submit" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Approve" class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="oacis_base.group_oacis_admin,oacis_base.group_oacis_manager"/>
                    <button name="action_reject" type="object"
                            string="Reject" class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="oacis_base.group_oacis_admin,oacis_base.group_oacis_manager"/>
                    <button name="action_fulfill" type="object"
                            string="Mark Fulfilled" class="oe_highlight"
                            invisible="state != 'approved'"
                            groups="oacis_base.group_oacis_admin,oacis_base.group_oacis_manager,oacis_base.group_oacis_staff"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ('submitted', 'rejected')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,fulfilled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Request Details">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="campus_id"/>
                            <field name="requested_by"/>
                            <field name="faculty_member_id"/>
                            <field name="needed_by_date"/>
                        </group>
                        <group string="Asset Information">
                            <field name="asset_id"/>
                            <field name="asset_description"
                                   invisible="asset_id"/>
                            <field name="asset_type"/>
                            <field name="requested_quantity"/>
                        </group>
                    </group>
                    <group string="Reason / Justification">
                        <field name="reason" widget="text" nolabel="1" rows="3"/>
                    </group>
                    <group string="Approval"
                           invisible="state in ('draft',)">
                        <group>
                            <field name="approver_id"/>
                            <field name="approved_date" readonly="1"/>
                        </group>
                        <group invisible="state == 'rejected'">
                            <field name="fulfilled_date" readonly="1"/>
                        </group>
                        <group invisible="state != 'rejected'">
                            <field name="rejection_reason" widget="text" nolabel="1" rows="2"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chatter" name="chatter">
                            <field name="message_follower_ids"/>
                            <field name="activity_ids"/>
                            <field name="message_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================== LIST ======================== -->
    <record id="view_oacis_asset_request_list" model="ir.ui.view">
        <field name="name">oacis.asset.request.list</field>
        <field name="model">oacis.asset.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="campus_id" optional="show"/>
                <field name="requested_by"/>
                <field name="asset_id" optional="show"/>
                <field name="asset_description" optional="hide"/>
                <field name="asset_type"/>
                <field name="requested_quantity"/>
                <field name="needed_by_date"/>
                <field name="approver_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'rejected'"
                       decoration-warning="state == 'draft'"
                       decoration-info="state == 'submitted'"
                       decoration-success="state in ('approved', 'fulfilled')"/>
            </list>
        </field>
    </record>

    <!-- ======================== SEARCH ======================== -->
    <record id="view_oacis_asset_request_search" model="ir.ui.view">
        <field name="name">oacis.asset.request.search</field>
        <field name="model">oacis.asset.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requested_by"/>
                <field name="asset_id"/>
                <field name="campus_id"/>
                <field name="approver_id"/>
                <separator/>
                <filter string="My Requests" name="my_requests"
                        domain="[('requested_by', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <filter string="Fulfilled" name="fulfilled"
                        domain="[('state', '=', 'fulfilled')]"/>
                <separator/>
                <filter string="Overdue" name="overdue"
                        domain="[('needed_by_date', '&lt;', today()), ('state', 'in', ['submitted', 'approved'])]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Requested By" name="group_requested_by"
                            context="{'group_by': 'requested_by'}"/>
                    <filter string="Campus" name="group_campus"
                            context="{'group_by': 'campus_id'}"/>
                    <filter string="Asset Type" name="group_asset_type"
                            context="{'group_by': 'asset_type'}"/>
                    <filter string="Approver" name="group_approver"
                            context="{'group_by': 'approver_id'}"/>
                    <filter string="Needed By" name="group_needed_by"
                            context="{'group_by': 'needed_by_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ======================== KANBAN ======================== -->
    <record id="view_oacis_asset_request_kanban" model="ir.ui.view">
        <field name="name">oacis.asset.request.kanban</field>
        <field name="model">oacis.asset.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="requested_by"/>
                <field name="asset_id"/>
                <field name="asset_description"/>
                <field name="asset_type"/>
                <field name="needed_by_date"/>
                <field name="state"/>
                <field name="campus_id"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb8">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                        </div>
                        <div class="o_kanban_record_body">
                            <div t-if="record.asset_id.raw_value">
                                <strong>Asset:</strong> <field name="asset_id"/>
                            </div>
                            <div t-if="!record.asset_id.raw_value &amp;&amp; record.asset_description.raw_value">
                                <strong>Asset:</strong> <field name="asset_description"/>
                            </div>
                            <div><strong>Type:</strong> <field name="asset_type"/></div>
                            <div><strong>Qty:</strong> <field name="requested_quantity"/></div>
                            <div><strong>Campus:</strong> <field name="campus_id"/></div>
                            <div><strong>Needed by:</strong> <field name="needed_by_date"/></div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <field name="requested_by" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================== ACTION ======================== -->
    <record id="action_oacis_asset_request" model="ir.actions.act_window">
        <field name="name">Asset Requests</field>
        <field name="res_model">oacis.asset.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_oacis_asset_request_search"/>
        <field name="context">{'search_default_submitted': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No asset requests yet
            </p>
            <p>
                Submit a request for equipment or assets you need.
            </p>
        </field>
    </record>

    <record id="action_oacis_asset_request_draft" model="ir.actions.act_window">
        <field name="name">Draft Requests</field>
        <field name="res_model">oacis.asset.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'draft')]</field>
        <field name="context">{'search_default_draft': 1}</field>
    </record>

    <record id="action_oacis_asset_request_submitted" model="ir.actions.act_window">
        <field name="name">Submitted Requests</field>
        <field name="res_model">oacis.asset.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'submitted')]</field>
        <field name="context">{'search_default_submitted': 1}</field>
    </record>

    <record id="action_oacis_asset_request_approved" model="ir.actions.act_window">
        <field name="name">Approved Requests</field>
        <field name="res_model">oacis.asset.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'approved')]</field>
    </record>

    <record id="action_oacis_asset_request_fulfilled" model="ir.actions.act_window">
        <field name="name">Fulfilled Requests</field>
        <field name="res_model">oacis.asset.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'fulfilled')]</field>
    </record>

    <record id="action_oacis_asset_request_rejected" model="ir.actions.act_window">
        <field name="name">Rejected Requests</field>
        <field name="res_model">oacis.asset.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'rejected')]</field>
    </record>
</odoo>
