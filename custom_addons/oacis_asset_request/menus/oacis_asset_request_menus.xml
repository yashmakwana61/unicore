    <menuitem id="menu_unicore_asset_request_approved"
              name="Approved"
              parent="menu_unicore_asset_request_requests"
              action="action_unicore_asset_request_approved"
              sequence="50"/>

    <menuitem id="menu_unicore_asset_request_fulfilled"
              name="Fulfilled"
              parent="menu_unicore_asset_request_requests"
              action="action_unicore_asset_request_fulfilled"
              sequence="60"/>

    <menuitem id="menu_unicore_asset_request_rejected"
              name="Rejected"
              parent="menu_unicore_asset_request_requests"
