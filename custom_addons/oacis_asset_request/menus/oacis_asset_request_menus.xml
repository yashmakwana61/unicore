<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Menus: Asset Request Module                                  -->
    <!-- ============================================================ -->

    <!-- Top-level menu -->
    <menuitem id="menu_unicore_asset_request_root"
              name="Asset Requests"
              web_icon="unicore_asset_request,static/description/icon.png"
              sequence="45"/>

    <!-- Assets -->
    <menuitem id="menu_unicore_asset_catalog"
              name="Asset Catalog"
              parent="menu_unicore_asset_request_root"
              sequence="10"/>

    <menuitem id="menu_unicore_asset_list"
              name="Assets"
              parent="menu_unicore_asset_catalog"
              action="action_unicore_asset"
              sequence="10"/>

    <!-- Requests -->
    <menuitem id="menu_unicore_asset_request_requests"
              name="Requests"
              parent="menu_unicore_asset_request_root"
              sequence="20"/>

    <menuitem id="menu_unicore_asset_request_all"
              name="All Requests"
              parent="menu_unicore_asset_request_requests"
              action="action_unicore_asset_request"
