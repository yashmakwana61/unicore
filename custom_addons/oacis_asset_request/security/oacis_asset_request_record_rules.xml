<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Record Rules: unicore.asset                                  -->
    <!-- ============================================================ -->

    <!-- Company Isolation -->
    <record id="rule_unicore_asset_company" model="ir.rule">
        <field name="name">Asset: Company Isolation</field>
        <field name="model_id" ref="model_unicore_asset"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Admin Bypass -->
    <record id="rule_unicore_asset_admin" model="ir.rule">
        <field name="name">Asset: Admin Full Access</field>
        <field name="model_id" ref="model_unicore_asset"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('unicore_base.group_unicore_admin'))]"/>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules: unicore.asset.request                          -->
    <!-- ============================================================ -->

    <!-- Company Isolation -->
    <record id="rule_unicore_asset_request_company" model="ir.rule">
        <field name="name">Asset Request: Company Isolation</field>
        <field name="model_id" ref="model_unicore_asset_request"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Faculty/Staff: own requests only -->
    <record id="rule_unicore_asset_request_faculty_own" model="ir.rule">
        <field name="name">Asset Request: Faculty Own Requests</field>
        <field name="model_id" ref="model_unicore_asset_request"/>
        <field name="domain_force">[('requested_by', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('unicore_base.group_unicore_faculty'))]"/>
    </record>

    <!-- Staff: own requests only -->
    <record id="rule_unicore_asset_request_staff_own" model="ir.rule">
        <field name="name">Asset Request: Staff Own Requests</field>
        <field name="model_id" ref="model_unicore_asset_request"/>
        <field name="domain_force">[('requested_by', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('unicore_base.group_unicore_staff'))]"/>
    </record>

    <!-- Admin Bypass -->
    <record id="rule_unicore_asset_request_admin" model="ir.rule">
        <field name="name">Asset Request: Admin Full Access</field>
        <field name="model_id" ref="model_unicore_asset_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('unicore_base.group_unicore_admin'))]"/>
    </record>

    <!-- Manager: company-wide access -->
    <record id="rule_unicore_asset_request_manager" model="ir.rule">
        <field name="name">Asset Request: Manager Company Access</field>
        <field name="model_id" ref="model_unicore_asset_request"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('unicore_base.group_unicore_manager'))]"/>
    </record>
</odoo>
