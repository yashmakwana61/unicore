<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

    <record id="seq_edicai_faculty_member" model="ir.sequence">
        <field name="name">Edicai Faculty Member ID</field>
        <field name="code">edicai.faculty.member</field>
        <field name="prefix">FAC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_edicai_staff_member" model="ir.sequence">
        <field name="name">Edicai Staff Member ID</field>
        <field name="code">edicai.staff.member</field>
        <field name="prefix">STF/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    </data>
</odoo>
