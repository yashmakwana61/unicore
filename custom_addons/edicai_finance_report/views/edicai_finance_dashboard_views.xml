<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <!-- Dashboard action: opens KPI graph first -->
  <record id="action_edicai_finance_dashboard" model="ir.actions.act_window">
    <field name="name">Finance Dashboard</field>
    <field name="res_model">edicai.finance.kpi</field>
    <field name="view_mode">graph,pivot,list</field>
    <field name="domain">[]</field>
    <field name="context">{'search_default_group_by_semester': 1}</field>
  </record>
  <!-- Quick access: Invoice summary -->
  <record id="action_edicai_fee_summary" model="ir.actions.act_window">
    <field name="name">Fee Summary</field>
    <field name="res_model">edicai.fee.invoice</field>
    <field name="view_mode">pivot,graph,list</field>
    <field name="domain">[('invoice_state','not in',['draft','cancelled'])]</field>
  </record>
  <!-- Quick access: Overdue report -->
  <record id="action_edicai_overdue_dashboard" model="ir.actions.act_window">
    <field name="name">Overdue Analysis</field>
    <field name="res_model">edicai.fee.invoice</field>
    <field name="view_mode">list,pivot</field>
    <field name="domain">[('invoice_state','in',['overdue','sent']),
       ('amount_outstanding','&gt;',0)]</field>
  </record>
  <!-- Quick access: Scholarship spend -->
  <record id="action_edicai_scholarship_spend" model="ir.actions.act_window">
    <field name="name">Scholarship Spend</field>
    <field name="res_model">edicai.scholarship.award</field>
    <field name="view_mode">pivot,graph,list</field>
    <field name="domain">[('award_state','=','disbursed')]</field>
    <field name="context">{'search_default_group_by_program': 1}</field>
  </record>
</odoo>
