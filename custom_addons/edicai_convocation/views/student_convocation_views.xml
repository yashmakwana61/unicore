<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_edicai_student_form_convocation_ext" model="ir.ui.view">
        <field name="name">edicai.student.form.convocation.ext</field>
        <field name="model">edicai.student</field>
        <field name="inherit_id" ref="edicai_student.edicai_student_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_convocation_event" type="object" class="oe_stat_button" icon="fa-graduation-cap" invisible="not convocation_event_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Convocation</span>
                    </div>
                </button>
                <button name="action_register_convocation" type="object" class="oe_stat_button" icon="fa-link" invisible="convocation_event_id" groups="edicai_base.group_edicai_admin,edicai_base.group_edicai_manager">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Register</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>