<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- unicore.exam.schedule                                         -->
        <!-- ============================================================ -->
        <record id="rule_unicore_exam_schedule_company" model="ir.rule">
            <field name="name">Exam Schedule: Company Isolation</field>
            <field name="model_id" ref="model_unicore_exam_schedule"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_unicore_exam_schedule_campus_staff" model="ir.rule">
            <field name="name">Exam Schedule: Campus Restriction for Staff</field>
            <field name="model_id" ref="model_unicore_exam_schedule"/>
            <field name="domain_force">['|', ('campus_id', '=', False), ('campus_id', 'in', user.unicore_campus_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_staff'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_unicore_exam_schedule_faculty" model="ir.rule">
            <field name="name">Exam Schedule: Faculty Invigilator Access</field>
            <field name="model_id" ref="model_unicore_exam_schedule"/>
            <field name="domain_force">[('invigilator_ids.partner_id.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_faculty'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_unicore_exam_schedule_student" model="ir.rule">
            <field name="name">Exam Schedule: Student View Published Exams</field>
            <field name="model_id" ref="model_unicore_exam_schedule"/>
            <field name="domain_force">[('exam_state', 'in', ['published', 'hall_tickets_generated', 'seating_generated', 'ongoing', 'completed']), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_student'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_unicore_exam_schedule_admin" model="ir.rule">
            <field name="name">Exam Schedule: Admin Bypass</field>
            <field name="model_id" ref="model_unicore_exam_schedule"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('unicore_base.group_unicore_admin'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

