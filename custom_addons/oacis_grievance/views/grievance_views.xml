<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data>
    <!-- ==================== GRIEVANCE CATEGORY VIEWS ==================== -->
    <record id="view_oacis_grievance_category_tree" model="ir.ui.view">
      <field name="name">oacis.grievance.category.tree</field>
      <field name="model">oacis.grievance.category</field>
      <field name="arch" type="xml">
        <list string="Grievance Categories">
          <field name="name" class="fw-bold"/>
        </list>
      </field>
    </record>

    <record id="view_oacis_grievance_category_form" model="ir.ui.view">
      <field name="name">oacis.grievance.category.form</field>
      <field name="model">oacis.grievance.category</field>
      <field name="arch" type="xml">
        <form string="Grievance Category">
          <sheet>
            <div class="oe_title">
              <label for="name" string="Category Name" class="oe_edit_only"/>
              <h1>
                <field name="name" placeholder="e.g. Academic Assessment Dispute"/>
              </h1>
            </div>
            <group>
              <field name="company_id" invisible="1"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- ==================== GRIEVANCE TEAM VIEWS ==================== -->
    <record id="view_oacis_grievance_team_tree" model="ir.ui.view">
      <field name="name">oacis.grievance.team.tree</field>
      <field name="model">oacis.grievance.team</field>
      <field name="arch" type="xml">
        <list string="Grievance Teams">
          <field name="name" class="fw-bold"/>
          <field name="member_ids" widget="many2many_tags"/>
        </list>
      </field>
    </record>

    <record id="view_oacis_grievance_team_form" model="ir.ui.view">
      <field name="name">oacis.grievance.team.form</field>
      <field name="model">oacis.grievance.team</field>
      <field name="arch" type="xml">
        <form string="Grievance Team">
          <sheet>
            <div class="oe_title">
              <label for="name" string="Team Name" class="oe_edit_only"/>
              <h1>
                <field name="name" placeholder="e.g. Student Welfare Committee"/>
              </h1>
            </div>
            <group>
              <field name="company_id" invisible="1"/>
            </group>
            <notebook>
              <page name="members_tab" string="Committee Members">
                <field name="member_ids">
                  <list string="Members">
                    <field name="name"/>
                    <field name="email"/>
                  </list>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- ==================== GRIEVANCE REQUEST VIEWS ==================== -->
    <record id="view_oacis_grievance_request_tree" model="ir.ui.view">
      <field name="name">oacis.grievance.request.tree</field>
      <field name="model">oacis.grievance.request</field>
      <field name="arch" type="xml">
        <list string="Grievance Requests" default_order="create_date desc">
          <field name="name" class="fw-bold"/>
          <field name="raised_by_id" widget="many2one_avatar"/>
          <field name="category_id" widget="badge"/>
          <field name="assigned_team_id" optional="show"/>
          <field name="create_date" string="Submitted On" optional="show"/>
          <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-warning="state in ('under_review', 'in_progress')" decoration-success="state == 'resolved'" decoration-danger="state == 'rejected'"/>
        </list>
      </field>
    </record>

    <record id="view_oacis_grievance_request_form" model="ir.ui.view">
      <field name="name">oacis.grievance.request.form</field>
      <field name="model">oacis.grievance.request</field>
      <field name="arch" type="xml">
        <form string="Grievance Request">
          <header>
            <button name="action_in_progress" string="Start Progress" type="object" class="btn-primary" invisible="state != 'new'"/>
            <button name="action_resolve" string="Resolve Grievance" type="object" class="btn-success" invisible="state != 'in_progress'"/>
            <button name="action_escalate" string="Escalate" type="object" invisible="state not in ('new', 'in_progress')"/>
            <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state in ('resolved', 'escalated', 'cancelled')"/>
            <field name="state" widget="statusbar" statusbar_visible="new,in_progress,resolved"/>
          </header>
          <sheet>
            <widget name="web_ribbon" title="Resolved" bg_color="text-bg-success" invisible="state != 'resolved'"/>
            <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
            <div class="oe_title">
              <label for="name" string="Grievance Reference" class="oe_edit_only"/>
              <h1>
                <field name="name" placeholder="e.g. GRV-2026-001"/>
              </h1>
            </div>
            <group>
              <group name="left" string="Requester Details">
                <field name="raised_by_id" widget="many2one_avatar" options="{'no_create_edit': True}"/>
                <field name="category_id" options="{'no_create_edit': True}"/>
                <field name="company_id" invisible="1"/>
              </group>
              <group name="right" string="Assignment">
                <field name="assigned_team_id" options="{'no_create_edit': True}"/>
              </group>
            </group>
            <notebook>
              <page string="Statement &amp; Description" name="description_tab">
                <field name="description" placeholder="Detailed description of the grievance..." widget="html"/>
              </page>
              <page string="Resolution Notes" name="resolution_tab" invisible="state in ('submitted', 'under_review')">
                <field name="resolution_notes" placeholder="Committee findings and resolution rationale..." widget="html"/>
              </page>
            </notebook>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>

    <record id="view_oacis_grievance_request_kanban" model="ir.ui.view">
      <field name="name">oacis.grievance.request.kanban</field>
      <field name="model">oacis.grievance.request</field>
      <field name="arch" type="xml">
        <kanban class="o_kanban_mobile" default_group_by="state">
          <field name="id"/>
          <field name="name"/>
          <field name="raised_by_id" widget="many2one_avatar"/>
          <field name="category_id"/>
          <field name="assigned_team_id"/>
          <field name="state" widget="badge"/>
          <progressbar field="state" colors='{"submitted": "info", "under_review": "warning", "in_progress": "warning", "resolved": "success", "rejected": "danger"}'/>
          <templates>
            <t t-name="card" class="flex-column">
              <div class="d-flex justify-content-between align-items-start">
                <field name="name" class="fw-bold fs-6"/>
                <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-warning="state in ('under_review', 'in_progress')" decoration-success="state == 'resolved'" decoration-danger="state == 'rejected'"/>
              </div>
              <div class="mt-2 d-flex align-items-center gap-2">
                <field name="raised_by_id" widget="many2one_avatar"/>
                <span class="text-truncate"><field name="raised_by_id" widget="many2one_avatar"/></span>
              </div>
              <div class="mt-2 d-flex justify-content-between align-items-center small text-muted">
                <span><i class="fa fa-tag me-1" title="Tag"/><field name="category_id"/></span>
                <span><i class="fa fa-users me-1" title="Users"/><field name="assigned_team_id"/></span>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <record id="view_oacis_grievance_request_search" model="ir.ui.view">
      <field name="name">oacis.grievance.request.search</field>
      <field name="model">oacis.grievance.request</field>
      <field name="arch" type="xml">
        <search string="Search Grievance Requests">
          <field name="name" string="Grievance / Requester" filter_domain="['|', ('name', 'ilike', self), ('raised_by_id.name', 'ilike', self)]"/>
          <field name="raised_by_id" widget="many2one_avatar"/>
          <field name="category_id"/>
          <field name="assigned_team_id"/>

          <searchpanel>
            <field name="category_id" icon="fa-tags" enable_counters="1"/>
            <field name="state" icon="fa-filter" select="multi" enable_counters="1"/>
          </searchpanel>

          <filter name="filter_open" string="Active Grievances" domain="[('state', 'in', ('submitted', 'under_review', 'in_progress'))]"/>
          <filter name="filter_submitted" string="Newly Submitted" domain="[('state', '=', 'submitted')]"/>
          <filter name="filter_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
          <filter name="filter_resolved" string="Resolved" domain="[('state', '=', 'resolved')]"/>
          <separator/>

          <group name="groupby">
            <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
            <filter name="group_team" string="Assigned Team" context="{'group_by': 'assigned_team_id'}"/>
            <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            <filter name="group_raised_by" string="Raised By" context="{'group_by': 'raised_by_id'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- ==================== ACTIONS ==================== -->
    <record id="action_oacis_grievance_category" model="ir.actions.act_window">
      <field name="name">Grievance Categories</field>
      <field name="res_model">oacis.grievance.category</field>
      <field name="view_mode">list,form</field>
    </record>

    <record id="action_oacis_grievance_team" model="ir.actions.act_window">
      <field name="name">Grievance Teams</field>
      <field name="res_model">oacis.grievance.team</field>
      <field name="view_mode">list,form</field>
    </record>

    <record id="action_oacis_grievance_request" model="ir.actions.act_window">
      <field name="name">Grievance Requests</field>
      <field name="res_model">oacis.grievance.request</field>
      <field name="view_mode">kanban,list,form</field>
      <field name="context">{'search_default_filter_open': 1}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Log a new grievance request
        </p>
        <p>
          Manage student and faculty complaints, grievance allocations, committee reviews, and documented resolutions.
        </p>
      </field>
    </record>
  </data>
</odoo>
