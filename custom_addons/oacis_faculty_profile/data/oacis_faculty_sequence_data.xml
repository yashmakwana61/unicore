<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_unicore_faculty_member" model="ir.sequence">
        <field name="name">UniCore Faculty Member ID</field>
        <field name="code">unicore.faculty.member</field>
        <field name="prefix">FAC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_unicore_staff_member" model="ir.sequence">
        <field name="name">UniCore Staff Member ID</field>
        <field name="code">unicore.staff.member</field>
        <field name="prefix">STF/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
