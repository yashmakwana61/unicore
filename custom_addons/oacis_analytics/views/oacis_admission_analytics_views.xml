<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ADMISSION FUNNEL REPORT -->

  <record id="view_oacis_admission_funnel_pivot"
          model="ir.ui.view">
    <field name="name">oacis.admission.funnel.report.pivot</field>
    <field name="model">oacis.admission.funnel.report</field>
    <field name="arch" type="xml">
      <pivot string="Admission Funnel Analytics">
        <field name="program_id" type="row"/>
        <field name="academic_year_id" type="col"/>
        <field name="total_applications"
               type="measure"/>
        <field name="shortlisted" type="measure"/>
        <field name="confirmed" type="measure"/>
        <field name="admission_rate" type="measure"/>
      </pivot>
    </field>
  </record>

  <record id="view_oacis_admission_funnel_graph"
          model="ir.ui.view">
    <field name="name">oacis.admission.funnel.report.graph</field>
    <field name="model">oacis.admission.funnel.report</field>
    <field name="arch" type="xml">
      <graph string="Admission Funnel"
             type="bar"
             stacked="0">
        <field name="program_id"/>
        <field name="total_applications"
               type="measure"/>
        <field name="shortlisted" type="measure"/>
        <field name="confirmed" type="measure"/>
      </graph>
    </field>
  </record>

  <record id="view_oacis_admission_funnel_list"
          model="ir.ui.view">
    <field name="name">oacis.admission.funnel.report.list</field>
    <field name="model">oacis.admission.funnel.report</field>
    <field name="arch" type="xml">
      <list>
        <field name="cycle_id"/>
        <field name="academic_year_id"/>
        <field name="program_id"/>
        <field name="total_applications"/>
        <field name="shortlisted"/>
        <field name="offer_sent"/>
        <field name="confirmed"/>
        <field name="rejected"/>
        <field name="shortlist_rate"/>
        <field name="offer_conversion_rate"/>
        <field name="admission_rate"/>
        <field name="avg_entrance_score"/>
        <field name="avg_aggregate_pct"/>
      </list>
    </field>
  </record>

  <record id="action_oacis_admission_funnel_report"
          model="ir.actions.act_window">
    <field name="name">Admission Funnel Analytics</field>
    <field name="res_model">oacis.admission.funnel.report</field>
    <field name="view_mode">graph,pivot,list</field>
  </record>

  <!-- APPLICANT CATEGORY REPORT -->

  <record id="view_oacis_applicant_cat_pivot"
          model="ir.ui.view">
    <field name="name">oacis.applicant.category.report.pivot</field>
    <field name="model">oacis.applicant.category.report</field>
    <field name="arch" type="xml">
      <pivot string="Applicant Category Analytics">
        <field name="category" type="row"/>
        <field name="gender" type="col"/>
        <field name="total_applicants"
               type="measure"/>
        <field name="confirmed" type="measure"/>
      </pivot>
    </field>
  </record>

  <record id="view_oacis_applicant_cat_graph"
          model="ir.ui.view">
    <field name="name">oacis.applicant.category.report.graph</field>
    <field name="model">oacis.applicant.category.report</field>
    <field name="arch" type="xml">
      <graph string="Applicant Category Distribution"
             type="pie">
        <field name="category"/>
        <field name="total_applicants"
               type="measure"/>
      </graph>
    </field>
  </record>

  <record id="view_oacis_applicant_cat_list"
          model="ir.ui.view">
    <field name="name">oacis.applicant.category.report.list</field>
    <field name="model">oacis.applicant.category.report</field>
    <field name="arch" type="xml">
      <list>
        <field name="academic_year_id"/>
        <field name="category"/>
        <field name="gender"/>
        <field name="total_applicants"/>
        <field name="confirmed"/>
        <field name="avg_score"/>
      </list>
    </field>
  </record>

  <record id="action_oacis_applicant_cat_report"
          model="ir.actions.act_window">
    <field name="name">Applicant Category Analytics</field>
    <field name="res_model">oacis.applicant.category.report</field>
    <field name="view_mode">graph,pivot,list</field>
  </record>

</odoo>
