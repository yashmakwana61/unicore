<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Register the Admission Dashboard Client Action -->
  <record id="action_oacis_admission_dashboard" model="ir.actions.client">
    <field name="name">Admission Dashboard</field>
    <field name="tag">oacis_admission_dashboard</field>
    <field name="target">main</field>
  </record>

  <!-- Add the Dashboard to the menu -->
  <menuitem
    id="menu_oacis_analytics_admission_dashboard"
    name="Admission Dashboard"
    parent="oacis_analytics.menu_oacis_analytics_admission"
    action="action_oacis_admission_dashboard"
    sequence="5"
    groups="oacis_base.group_oacis_manager"/>

</odoo>
