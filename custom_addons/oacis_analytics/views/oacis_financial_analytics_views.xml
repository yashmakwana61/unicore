<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- FEE COLLECTION REPORT -->

  <record id="view_unicore_fee_coll_report_pivot"
          model="ir.ui.view">
    <field name="name">unicore.fee.collection.report.pivot</field>
    <field name="model">unicore.fee.collection.report</field>
    <field name="arch" type="xml">
      <pivot string="Fee Collection Analytics">
        <field name="semester_id" type="row"/>
        <field name="invoice_state" type="col"/>
        <field name="invoice_count" type="measure"/>
        <field name="total_billed" type="measure"/>
        <field name="total_collected" type="measure"/>
        <field name="total_outstanding" type="measure"/>
        <field name="collection_rate" type="measure"/>
      </pivot>
    </field>
  </record>

  <record id="view_unicore_fee_coll_report_graph"
          model="ir.ui.view">
    <field name="name">unicore.fee.collection.report.graph</field>
    <field name="model">unicore.fee.collection.report</field>
    <field name="arch" type="xml">
      <graph string="Fee Collection Trend"
             type="bar"
             stacked="1">
        <field name="semester_id"/>
        <field name="total_collected" type="measure"/>
        <field name="total_outstanding"
               type="measure"/>
      </graph>
    </field>
  </record>

  <record id="view_unicore_fee_coll_report_list"
          model="ir.ui.view">
    <field name="name">unicore.fee.collection.report.list</field>
    <field name="model">unicore.fee.collection.report</field>
    <field name="arch" type="xml">
      <list>
        <field name="semester_id"/>
        <field name="invoice_state"/>
        <field name="invoice_count"/>
        <field name="total_billed"/>
        <field name="total_collected"/>
        <field name="total_outstanding"/>
        <field name="collection_rate"/>
      </list>
    </field>
  </record>

  <record id="action_unicore_fee_coll_report"
          model="ir.actions.act_window">
    <field name="name">Fee Collection Analytics</field>
    <field name="res_model">unicore.fee.collection.report</field>
    <field name="view_mode">graph,pivot,list</field>
  </record>

  <!-- PAYMENT METHOD REPORT -->

  <record id="view_unicore_payment_method_pivot"
          model="ir.ui.view">
    <field name="name">unicore.payment.method.report.pivot</field>
    <field name="model">unicore.payment.method.report</field>
    <field name="arch" type="xml">
      <pivot string="Payment Method Analytics">
        <field name="payment_method" type="row"/>
        <field name="payment_month" type="col"/>
        <field name="total_amount" type="measure"/>
        <field name="payment_count" type="measure"/>
      </pivot>
    </field>
  </record>

  <record id="view_unicore_payment_method_graph"
          model="ir.ui.view">
    <field name="name">unicore.payment.method.report.graph</field>
    <field name="model">unicore.payment.method.report</field>
    <field name="arch" type="xml">
      <graph string="Payment Method Distribution"
             type="pie">
        <field name="payment_method"/>
        <field name="total_amount" type="measure"/>
      </graph>
    </field>
  </record>

  <record id="view_unicore_payment_method_list"
          model="ir.ui.view">
    <field name="name">unicore.payment.method.report.list</field>
    <field name="model">unicore.payment.method.report</field>
    <field name="arch" type="xml">
      <list>
        <field name="payment_month"/>
        <field name="payment_method"/>
        <field name="payment_count"/>
        <field name="total_amount"/>
      </list>
    </field>
  </record>

  <record id="action_unicore_payment_method_report"
          model="ir.actions.act_window">
    <field name="name">Payment Method Analytics</field>
    <field name="res_model">unicore.payment.method.report</field>
    <field name="view_mode">graph,pivot,list</field>
  </record>

</odoo>
