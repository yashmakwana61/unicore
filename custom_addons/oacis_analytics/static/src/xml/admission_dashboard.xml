<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="oacis_analytics.AdmissionDashboard" owl="1">
        <div class="o_admission_dashboard">
            <!-- Loading State -->
            <t t-if="state.loading">
                <div class="o_dashboard_loading">
                    <div class="spinner">Loading dashboard...</div>
                </div>
            </t>

            <!-- Error State -->
            <t t-if="state.error and not state.loading">
                <div class="alert alert-danger">
                    <t t-esc="state.error"/>
                </div>
            </t>

            <!-- Dashboard Content -->
            <t t-if="state.data and not state.loading">
                <!-- Filters Section -->
                <div class="o_dashboard_filters card">
                    <div class="card-header">
                        <h5>Filters</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-2">
                                <label>Date From</label>
                                <input type="date" class="form-control"
                                    t-att-value="state.filters.date_from or ''"
                                    t-on-change.bind="onFilterChange" data-field="date_from"/>
                            </div>
                            <div class="col-md-2">
                                <label>Date To</label>
                                <input type="date" class="form-control"
                                    t-att-value="state.filters.date_to or ''"
                                    t-on-change.bind="onFilterChange" data-field="date_to"/>
                            </div>
                            <div class="col-md-2">
                                <label>Campus</label>
                                <select class="form-control"
                                    t-on-change.bind="onFilterChange" data-field="campus_id">
                                    <option value="">All Campuses</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label>Program</label>
                                <select class="form-control"
                                    t-on-change.bind="onFilterChange" data-field="program_id">
                                    <option value="">All Programs</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label>Status</label>
                                <select class="form-control"
                                    t-on-change.bind="onFilterChange" data-field="state">
                                    <option value="">All States</option>
                                    <option value="inquiry">Inquiry</option>
                                    <option value="applied">Applied</option>
                                    <option value="documents_pending">Documents Pending</option>
                                    <option value="under_review">Under Review</option>
                                    <option value="shortlisted">Shortlisted</option>
                                    <option value="entrance_scheduled">Entrance Scheduled</option>
                                    <option value="merit_listed">Merit Listed</option>
                                    <option value="offer_sent">Offer Sent</option>
                                    <option value="fee_pending">Fee Pending</option>
                                    <option value="confirmed">Confirmed</option>
                                    <option value="rejected">Rejected</option>
                                    <option value="withdrawn">Withdrawn</option>
                                    <option value="waitlisted">Waitlisted</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- KPI Cards Section -->
                <div class="o_dashboard_kpis">
                    <div class="row mt-3">
                        <div class="col-md-2">
                            <div class="kpi-card">
                                <div class="kpi-label">Total Applicants</div>
                                <div class="kpi-value">
                                    <t t-esc="state.data.total_applicants"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="kpi-card">
                                <div class="kpi-label">Confirmed</div>
                                <div class="kpi-value">
                                    <t t-esc="state.data.confirmed"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="kpi-card">
                                <div class="kpi-label">Admission Rate %</div>
                                <div class="kpi-value">
                                    <t t-esc="state.data.admission_rate"/>%
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="kpi-card">
                                <div class="kpi-label">Pending Decisions</div>
                                <div class="kpi-value">
                                    <t t-esc="state.data.pending_decisions"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="kpi-card">
                                <div class="kpi-label">Rejected</div>
                                <div class="kpi-value">
                                    <t t-esc="state.data.rejected"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="kpi-card">
                                <div class="kpi-label">Withdrawn</div>
                                <div class="kpi-value">
                                    <t t-esc="state.data.withdrawn"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-2">
                            <div class="kpi-card">
                                <div class="kpi-label">Shortlist Rate %</div>
                                <div class="kpi-value">
                                    <t t-esc="state.data.shortlist_rate"/>%
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="kpi-card">
                                <div class="kpi-label">Offer Conv. %</div>
                                <div class="kpi-value">
                                    <t t-esc="state.data.offer_conversion_rate"/>%
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="kpi-card">
                                <div class="kpi-label">Avg Composite Score</div>
                                <div class="kpi-value">
                                    <t t-esc="state.data.avg_composite_score"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="kpi-card">
                                <div class="kpi-label">Avg Entrance Score</div>
                                <div class="kpi-value">
                                    <t t-esc="state.data.avg_entrance_score"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="kpi-card">
                                <div class="kpi-label">Avg Aggregate %</div>
                                <div class="kpi-value">
                                    <t t-esc="state.data.avg_aggregate_pct"/>%
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="kpi-card">
                                <div class="kpi-label">Waitlisted</div>
                                <div class="kpi-value">
                                    <t t-esc="state.data.waitlisted"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Charts Section -->
                <div class="o_dashboard_charts">
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <canvas id="funnelChart" style="max-height: 300px;"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <canvas id="applicationsOverTimeChart" style="max-height: 300px;"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <canvas id="byProgramChart" style="max-height: 300px;"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <canvas id="byCampusChart" style="max-height: 300px;"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <canvas id="byGenderChart" style="max-height: 300px;"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Breakdown Tables Section -->
                <div class="o_dashboard_tables">
                    <div class="row mt-4">
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-header">
                                    <h6>By Program</h6>
                                </div>
                                <div class="card-body">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Program</th>
                                                <th>Count</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="state.data.by_program" t-as="item" t-key="item.program_id">
                                                <td><t t-esc="item.program_name"/></td>
                                                <td><t t-esc="item.count"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-header">
                                    <h6>By Campus</h6>
                                </div>
                                <div class="card-body">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Campus</th>
                                                <th>Count</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="state.data.by_campus" t-as="item" t-key="item.campus_id">
                                                <td><t t-esc="item.campus_name"/></td>
                                                <td><t t-esc="item.count"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-header">
                                    <h6>By Nationality</h6>
                                </div>
                                <div class="card-body">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Nationality</th>
                                                <th>Count</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="state.data.by_nationality" t-as="item" t-key="item.nationality_id">
                                                <td><t t-esc="item.nationality_name"/></td>
                                                <td><t t-esc="item.count"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
