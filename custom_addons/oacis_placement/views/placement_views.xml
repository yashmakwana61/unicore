<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data>
    <!-- ==================== PLACEMENT COMPANY VIEWS ==================== -->
    <record id="view_oacis_placement_company_tree" model="ir.ui.view">
      <field name="name">oacis.placement.company.tree</field>
      <field name="model">oacis.placement.company</field>
      <field name="arch" type="xml">
        <list string="Recruiting Companies">
          <field name="name" class="fw-bold"/>
          <field name="industry"/>
          <field name="description" optional="show"/>
        </list>
      </field>
    </record>

    <record id="view_oacis_placement_company_form" model="ir.ui.view">
      <field name="name">oacis.placement.company.form</field>
      <field name="model">oacis.placement.company</field>
      <field name="arch" type="xml">
        <form string="Recruiting Company">
          <sheet>
            <div class="oe_title">
              <label for="name" string="Company Name" class="oe_edit_only"/>
              <h1>
                <field name="name" placeholder="e.g. Google, Microsoft..."/>
              </h1>
            </div>
            <group>
              <group>
                <field name="industry" placeholder="e.g. Information Technology"/>
                <field name="company_id" invisible="1"/>
              </group>
            </group>
            <group string="Company Profile &amp; Overview">
              <field name="description" placeholder="Company profile, recruiting guidelines, domain focus..." nolabel="1"/>
            </group>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>

    <record id="view_oacis_placement_company_search" model="ir.ui.view">
      <field name="name">oacis.placement.company.search</field>
      <field name="model">oacis.placement.company</field>
      <field name="arch" type="xml">
        <search string="Search Companies">
          <field name="name"/>
          <field name="industry"/>
          <group name="groupby">
            <filter name="group_industry" string="Industry" context="{'group_by': 'industry'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- ==================== PLACEMENT DRIVE VIEWS ==================== -->
    <record id="view_oacis_placement_drive_tree" model="ir.ui.view">
      <field name="name">oacis.placement.drive.tree</field>
      <field name="model">oacis.placement.drive</field>
      <field name="arch" type="xml">
        <list string="Placement Drives" default_order="date desc">
          <field name="name" class="fw-bold"/>
          <field name="company_id"/>
          <field name="date"/>
          <field name="eligible_program_ids" widget="many2many_tags"/>
          <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-primary="state == 'completed'" decoration-danger="state == 'cancelled'"/>
        </list>
      </field>
    </record>

    <record id="view_oacis_placement_drive_form" model="ir.ui.view">
      <field name="name">oacis.placement.drive.form</field>
      <field name="model">oacis.placement.drive</field>
      <field name="arch" type="xml">
        <form string="Placement Drive">
          <header>
            <button name="action_activate" string="Open Drive" type="object" class="btn-primary" invisible="state != 'draft'"/>
            <button name="action_complete" string="Complete Drive" type="object" class="btn-success" invisible="state != 'active'"/>
            <button name="action_cancel" string="Cancel Drive" type="object" class="btn-secondary" invisible="state in ('completed', 'cancelled')"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,active,completed"/>
          </header>
          <sheet>
            <widget name="web_ribbon" title="Active" bg_color="text-bg-success" invisible="state != 'active'"/>
            <widget name="web_ribbon" title="Completed" bg_color="text-bg-info" invisible="state != 'completed'"/>
            <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
            <div class="oe_title">
              <label for="name" string="Drive Name" class="oe_edit_only"/>
              <h1>
                <field name="name" readonly="1"/>
              </h1>
            </div>
            <group>
              <group name="left" string="Company &amp; Schedule">
                <field name="company_id" options="{'no_create_edit': True}"/>
                <field name="date"/>
                <field name="institution_id" invisible="1"/>
              </group>
              <group name="right" string="Eligibility">
                <field name="eligible_program_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
              </group>
            </group>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>

    <record id="view_oacis_placement_drive_kanban" model="ir.ui.view">
      <field name="name">oacis.placement.drive.kanban</field>
      <field name="model">oacis.placement.drive</field>
      <field name="arch" type="xml">
        <kanban class="o_kanban_mobile" default_group_by="state">
          <field name="id"/>
          <field name="name"/>
          <field name="company_id"/>
          <field name="date"/>
          <field name="eligible_program_ids"/>
          <field name="state" widget="badge"/>
          <progressbar field="state" colors='{"draft": "info", "active": "success", "completed": "primary", "cancelled": "danger"}'/>
          <templates>
            <t t-name="card" class="flex-column">
              <div class="d-flex justify-content-between align-items-start">
                <field name="name" class="fw-bold fs-6"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-primary="state == 'completed'" decoration-danger="state == 'cancelled'"/>
              </div>
              <div class="mt-2 small text-muted">
                <i class="fa fa-building-o me-1" title="Building"/><field name="company_id"/>
              </div>
              <div class="mt-2 d-flex justify-content-between align-items-center small text-muted">
                <span><i class="fa fa-calendar me-1" title="Calendar"/><field name="date"/></span>
                <field name="eligible_program_ids" widget="many2many_tags"/>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <record id="view_oacis_placement_drive_search" model="ir.ui.view">
      <field name="name">oacis.placement.drive.search</field>
      <field name="model">oacis.placement.drive</field>
      <field name="arch" type="xml">
        <search string="Search Placement Drives">
          <field name="name" string="Drive / Company" filter_domain="['|', ('name', 'ilike', self), ('company_id.name', 'ilike', self)]"/>
          <field name="company_id"/>
          <field name="eligible_program_ids"/>

          <searchpanel>
            <field name="company_id" icon="fa-building-o" enable_counters="1"/>
            <field name="state" icon="fa-filter" select="multi" enable_counters="1"/>
          </searchpanel>

          <filter name="filter_active" string="Active Drives" domain="[('state', '=', 'active')]"/>
          <filter name="filter_draft" string="Upcoming (Draft)" domain="[('state', '=', 'draft')]"/>
          <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
          <separator/>

          <group name="groupby">
            <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            <filter name="group_date" string="Drive Date" context="{'group_by': 'date:month'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- ==================== PLACEMENT APPLICATION VIEWS ==================== -->
    <record id="view_oacis_placement_application_tree" model="ir.ui.view">
      <field name="name">oacis.placement.application.tree</field>
      <field name="model">oacis.placement.application</field>
      <field name="arch" type="xml">
        <list string="Student Applications" default_order="create_date desc">
          <field name="name" class="fw-bold"/>
          <field name="student_id" widget="many2one_avatar"/>
          <field name="drive_id"/>
          <field name="status" widget="badge" decoration-info="status == 'applied'" decoration-warning="status == 'shortlisted'" decoration-success="status == 'offered'" decoration-danger="status == 'rejected'"/>
        </list>
      </field>
    </record>

    <record id="view_oacis_placement_application_form" model="ir.ui.view">
      <field name="name">oacis.placement.application.form</field>
      <field name="model">oacis.placement.application</field>
      <field name="arch" type="xml">
        <form string="Placement Application">
          <header>
            <button name="action_shortlist" string="Shortlist" type="object" class="btn-primary" invisible="status != 'applied'"/>
            <button name="action_offer" string="Extend Offer" type="object" class="btn-success" invisible="status != 'shortlisted'"/>
            <button name="action_reject" string="Reject" type="object" class="btn-secondary" invisible="status in ('offered', 'rejected')"/>
            <field name="status" widget="statusbar" statusbar_visible="applied,shortlisted,offered"/>
          </header>
          <sheet>
            <widget name="web_ribbon" title="Job Offered" bg_color="text-bg-success" invisible="status != 'offered'"/>
            <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="status != 'rejected'"/>
            <div class="oe_title">
              <label for="name" string="Application" class="oe_edit_only"/>
              <h1>
                <field name="name" readonly="1"/>
              </h1>
            </div>
            <group>
              <group name="left" string="Candidate Details">
                <field name="student_id" widget="many2one_avatar" options="{'no_create_edit': True}"/>
                <field name="company_id" invisible="1"/>
              </group>
              <group name="right" string="Placement Drive">
                <field name="drive_id" options="{'no_create_edit': True}"/>
              </group>
            </group>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>

    <record id="view_oacis_placement_application_kanban" model="ir.ui.view">
      <field name="name">oacis.placement.application.kanban</field>
      <field name="model">oacis.placement.application</field>
      <field name="arch" type="xml">
        <kanban class="o_kanban_mobile" default_group_by="status">
          <field name="id"/>
          <field name="name"/>
          <field name="student_id" widget="many2one_avatar"/>
          <field name="drive_id"/>
          <field name="status" widget="badge"/>
          <progressbar field="status" colors='{"applied": "info", "shortlisted": "warning", "offered": "success", "rejected": "danger"}'/>
          <templates>
            <t t-name="card" class="flex-column">
              <div class="d-flex justify-content-between align-items-start">
                <field name="name" class="fw-bold fs-6"/>
                <field name="status" widget="badge" decoration-info="status == 'applied'" decoration-warning="status == 'shortlisted'" decoration-success="status == 'offered'" decoration-danger="status == 'rejected'"/>
              </div>
              <div class="mt-2 d-flex align-items-center gap-2">
                <field name="student_id" widget="many2one_avatar"/>
                <span class="text-truncate"><field name="student_id" widget="many2one_avatar"/></span>
              </div>
              <div class="mt-2 small text-muted">
                <i class="fa fa-briefcase me-1" title="Briefcase"/><field name="drive_id"/>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <record id="view_oacis_placement_application_search" model="ir.ui.view">
      <field name="name">oacis.placement.application.search</field>
      <field name="model">oacis.placement.application</field>
      <field name="arch" type="xml">
        <search string="Search Student Applications">
          <field name="name" string="Candidate / Drive" filter_domain="['|', ('student_id.name', 'ilike', self), ('drive_id.name', 'ilike', self)]"/>
          <field name="student_id" widget="many2one_avatar"/>
          <field name="drive_id"/>

          <searchpanel>
            <field name="drive_id" icon="fa-briefcase" enable_counters="1"/>
            <field name="status" icon="fa-filter" select="multi" enable_counters="1"/>
          </searchpanel>

          <filter name="filter_applied" string="Applied" domain="[('status', '=', 'applied')]"/>
          <filter name="filter_shortlisted" string="Shortlisted" domain="[('status', '=', 'shortlisted')]"/>
          <filter name="filter_offered" string="Offered" domain="[('status', '=', 'offered')]"/>
          <separator/>

          <group name="groupby">
            <filter name="group_drive" string="Placement Drive" context="{'group_by': 'drive_id'}"/>
            <filter name="group_student" string="Student" context="{'group_by': 'student_id'}"/>
            <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- ==================== ACTIONS ==================== -->
    <record id="action_oacis_placement_company" model="ir.actions.act_window">
      <field name="name">Recruiting Companies</field>
      <field name="res_model">oacis.placement.company</field>
      <field name="view_mode">list,form</field>
    </record>

    <record id="action_oacis_placement_drive" model="ir.actions.act_window">
      <field name="name">Placement Drives</field>
      <field name="res_model">oacis.placement.drive</field>
      <field name="view_mode">kanban,list,form</field>
      <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <record id="action_oacis_placement_application" model="ir.actions.act_window">
      <field name="name">Applications</field>
      <field name="res_model">oacis.placement.application</field>
      <field name="view_mode">kanban,list,form</field>
    </record>
  </data>
</odoo>
