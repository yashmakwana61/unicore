<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_oacis_placement_drive_student" model="ir.rule">
            <field name="name">Placement Drive: Student Active Only</field>
            <field name="model_id" ref="model_oacis_placement_drive"/>
            <field name="domain_force">[('state', 'in', ['active', 'completed'])]</field>
            <field name="groups" eval="[(4, ref('oacis_base.group_oacis_student'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
        <record id="rule_oacis_placement_application_student" model="ir.rule">
            <field name="name">Placement Application: Student Own</field>
            <field name="model_id" ref="model_oacis_placement_application"/>
            <field name="domain_force">[('student_id.partner_id.user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('oacis_base.group_oacis_student'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
