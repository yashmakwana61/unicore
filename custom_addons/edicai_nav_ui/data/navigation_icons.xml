<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- App-menu icon assignments (premium 3D icon set, 256px PNG).
             NOT noupdate: re-asserted on every edicai_nav_ui upgrade so core
             module upgrades cannot revert them. -->
