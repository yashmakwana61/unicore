        </record>
        <!-- Home root (icon ships in edicai_home) -->
        <record id="edicai_home.menu_edicai_home_app" model="ir.ui.menu">
            <field name="web_icon">edicai_home,static/src/icons/ic_home.png</field>
        </record>
        <!-- Settings row in the sidebar (Administration) -->
        <record id="base.menu_administration" model="ir.ui.menu">
            <field name="web_icon">edicai_nav_ui,static/src/icons/ic_administration.png</field>
        </record>
        <!-- noupdate="1" menus (workspaces, Home root): plain <record> writes
             are skipped by the data loader for those xmlids, so force-apply
             via ORM on every upgrade. -->
        <function model="ir.ui.menu" name="edicai_apply_workspace_icons"/>
    </data>
</odoo>
