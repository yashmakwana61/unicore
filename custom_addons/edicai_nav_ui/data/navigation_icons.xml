<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- App-menu icon assignments (minimal transparent line icons).
             NOT noupdate: re-asserted on every edicai_nav_ui upgrade so core
             module upgrades cannot revert them (Website/Apps are core menus). -->
        <record id="website.menu_website_configuration" model="ir.ui.menu">
            <field name="web_icon">edicai_nav_ui,static/src/icons/ic_website.svg</field>
        </record>
        <record id="base.menu_management" model="ir.ui.menu">
            <field name="web_icon">edicai_nav_ui,static/src/icons/ic_apps.svg</field>
        </record>
    </data>
</odoo>
