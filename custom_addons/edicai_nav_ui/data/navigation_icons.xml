            <field name="web_icon">edicai_nav_ui,static/src/icons/ic_teaching.png</field>
        </record>
        <record id="edicai_navigation.menu_workspace_50" model="ir.ui.menu">
            <field name="web_icon">edicai_nav_ui,static/src/icons/ic_exams.png</field>
        </record>
