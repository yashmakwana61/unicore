<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data noupdate="1">
    <!-- Company isolation for leave requests -->
    <record id="rule_unicore_student_leave_request_company" model="ir.rule">
      <field name="name">Leave Request: Company Isolation</field>
      <field name="model_id" ref="model_unicore_student_leave_request"/>
      <field name="domain_force">['|', ('company_id', '=', False),
                 ('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>
    <!-- Registrar and admin can see all -->
    <record id="rule_unicore_student_leave_request_all_admin" model="ir.rule">
      <field name="name">Leave Request: Admin/Registrar Full Access</field>
      <field name="model_id" ref="model_unicore_student_leave_request"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[                 (4, ref('unicore_base.group_unicore_admin')),                 (4, ref('unicore_base.group_unicore_registrar')),             ]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>
    <!-- Students can see own leave requests (read-only) -->
    <record id="rule_unicore_student_leave_request_student" model="ir.rule">
      <field name="name">Leave Request: Student Own Requests</field>
      <field name="model_id" ref="model_unicore_student_leave_request"/>
      <field name="domain_force">[('student_id.partner_id.user_ids', 'in',
                  [user.id])]</field>
      <field name="groups" eval="[                 (4, ref('unicore_base.group_unicore_student')),             ]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="False"/>
    </record>
    <!-- Guardians can see ward leave requests (read-only) -->
    <record id="rule_unicore_student_leave_request_guardian" model="ir.rule">
      <field name="name">Leave Request: Guardian Ward Requests</field>
      <field name="model_id" ref="model_unicore_student_leave_request"/>
      <field name="domain_force">[('guardian_id.partner_id.user_ids', 'in',
                  [user.id])]</field>
      <field name="groups" eval="[                 (4, ref('base.group_portal')),             ]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="False"/>
    </record>
    <!-- Faculty can see leave requests -->
    <record id="rule_unicore_student_leave_request_faculty" model="ir.rule">
      <field name="name">Leave Request: Faculty Read Access</field>
      <field name="model_id" ref="model_unicore_student_leave_request"/>
      <field name="domain_force">[('student_id.company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[                 (4, ref('unicore_base.group_unicore_faculty')),                 (4, ref('unicore_base.group_unicore_staff')),                 (4, ref('unicore_base.group_unicore_manager')),             ]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>
  </data>
</odoo>
