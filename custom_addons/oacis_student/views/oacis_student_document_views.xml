<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- DOCUMENT FORM VIEW -->
    <record id="unicore_student_document_form_view" model="ir.ui.view">
        <field name="name">unicore.student.document.form</field>
        <field name="model">unicore.student.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_type"/>
                            <field name="student_id" options="{'no_create_edit': True}"/>
                            <field name="campus_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="issuing_authority"/>
                            <field name="reference_number"/>
                        </group>
                    </group>
                    <group string="File">
                        <field name="file" filename="file_name" widget="binary"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <group string="Verification">
                        <group>
                            <field name="is_verified"/>
                            <field name="verified_by" invisible="is_verified == False"/>
                            <field name="verified_on" invisible="is_verified == False"/>
                        </group>
                        <group>
                            <field name="verification_notes"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="notes" string="Notes">
                            <field name="remarks"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- DOCUMENT TREE VIEW -->
    <record id="unicore_student_document_tree_view" model="ir.ui.view">
        <field name="name">unicore.student.document.tree</field>
        <field name="model">unicore.student.document</field>
        <field name="arch" type="xml">
            <list limit="40">
                <field name="name"/>
                <field name="document_type"/>
                <field name="student_id"/>
                <field name="file_name"/>
                <field name="is_verified"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
            </list>
        </field>
    </record>

    <!-- DOCUMENT SEARCH VIEW -->
    <record id="unicore_student_document_search_view" model="ir.ui.view">
        <field name="name">unicore.student.document.search</field>
        <field name="model">unicore.student.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="document_type"/>
                <field name="student_id"/>
                <filter name="filter_verified" string="Verified" domain="[('is_verified', '=', True)]"/>
                <filter name="filter_unverified" string="Unverified" domain="[('is_verified', '=', False)]"/>
                <group name="groupby">
                    <filter name="group_type" string="Type" context="{'group_by': 'document_type'}"/>
                    <filter name="group_student" string="Student" context="{'group_by': 'student_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- DOCUMENT ACTIONS -->
    <record id="action_unicore_student_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">unicore.student.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="unicore_student_document_search_view"/>
    </record>
</odoo>
