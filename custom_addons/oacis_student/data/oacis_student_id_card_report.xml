<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_id_card" model="report.paperformat">
        <field name="name">Oacis ID Card</field>
        <field name="default">False</field>
        <field name="format">custom</field>
        <field name="page_height">54</field>
        <field name="page_width">86</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line">False</field>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_student_id_card" model="ir.actions.report">
        <field name="name">Student ID Card</field>
        <field name="model">oacis.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">oacis_student.student_id_card_template</field>
        <field name="report_file">oacis_student.student_id_card_template</field>
        <field name="print_report_name">'Student-ID-Card-%s' % object.student_id_number</field>
        <field name="binding_model_id" ref="oacis_student.model_oacis_student"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="oacis_student.paperformat_id_card"/>
    </record>
</odoo>
