<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data noupdate="1">
    <record id="rule_oacis_library_book_company" model="ir.rule">
      <field name="name">Library Book: Company Isolation</field>
      <field name="model_id" ref="oacis_library.model_oacis_library_book"/>
      <field name="domain_force">['|',('company_id','=',False),
             ('company_id','in',company_ids)]</field>
      <field name="groups" eval="[(4,ref('base.group_user'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_oacis_library_member_company" model="ir.rule">
      <field name="name">Library Member: Company Isolation</field>
      <field name="model_id" ref="oacis_library.model_oacis_library_member"/>
      <field name="domain_force">['|',('company_id','=',False),
             ('company_id','in',company_ids)]</field>
      <field name="groups" eval="[(4,ref('base.group_user'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_oacis_library_issue_company" model="ir.rule">
      <field name="name">Library Issue: Company Isolation</field>
      <field name="model_id" ref="oacis_library.model_oacis_library_issue"/>
      <field name="domain_force">['|',('company_id','=',False),
             ('company_id','in',company_ids)]</field>
      <field name="groups" eval="[(4,ref('base.group_user'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_oacis_library_issue_student" model="ir.rule">
      <field name="name">Library Issue: Student Own Records</field>
      <field name="model_id" ref="oacis_library.model_oacis_library_issue"/>
      <field name="domain_force">[('student_id.partner_id.user_ids',
          'in', [user.id])]</field>
      <field name="groups" eval="[(4,ref('oacis_base.group_oacis_student'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_oacis_library_reservation_company" model="ir.rule">
      <field name="name">Library Reservation: Company Isolation</field>
      <field name="model_id" ref="oacis_library.model_oacis_library_reservation"/>
