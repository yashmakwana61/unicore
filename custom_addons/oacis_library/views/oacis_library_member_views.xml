<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_oacis_library_member_form" model="ir.ui.view">
    <field name="name">oacis.library.member.form</field>
    <field name="model">oacis.library.member</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_suspend" string="Suspend" type="object" invisible="member_state != 'active'" groups="oacis_base.group_oacis_admin"/>
          <button name="action_reactivate" string="Reactivate" type="object" invisible="member_state == 'active'" class="btn-primary"/>
          <field name="member_state" widget="statusbar" statusbar_visible="active,suspended"/>
        </header>
        <sheet>
          <widget name="web_ribbon" title="SUSPENDED" invisible="member_state != 'suspended'" bg_color="text-bg-danger"/>
          <widget name="web_ribbon" title="EXPIRED" invisible="not is_expired" bg_color="text-bg-warning"/>
          <div class="oe_button_box" name="button_box">
            <button type="object" name="action_view_issues" class="oe_stat_button" icon="fa-book">
              <field name="current_issue_count" widget="statinfo" string="Books Issued"/>
            </button>
            <button type="object" name="action_view_issues" class="oe_stat_button" icon="fa-history">
              <field name="total_issued_ever" widget="statinfo" string="Total Borrowed"/>
            </button>
          </div>
          <group>
            <group string="Member Identity">
              <field name="member_id" readonly="1"/>
              <field name="company_id"/>
              <field name="member_type"/>
              <field name="student_id" invisible="member_type != 'student'"/>
              <field name="faculty_member_id" invisible="member_type != 'faculty'"/>
              <field name="display_name" readonly="1"/>
            </group>
            <group string="Privileges">
              <field name="max_books_allowed"/>
              <field name="loan_period_days"/>
              <field name="fine_waiver"/>
              <field name="registration_date" readonly="1"/>
              <field name="valid_until"/>
              <field name="outstanding_fines" readonly="1"/>
            </group>
          </group>
          <group string="Suspension Reason" invisible="member_state != 'suspended'">
            <field name="suspension_reason" nolabel="1"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="view_oacis_library_member_list" model="ir.ui.view">
    <field name="name">oacis.library.member.list</field>
    <field name="model">oacis.library.member</field>
    <field name="arch" type="xml">
      <list decoration-danger="member_state == 'suspended'" decoration-warning="outstanding_fines &gt; 0" decoration-muted="member_state in               ('expired','blacklisted')">
        <field name="member_id"/>
        <field name="display_name"/>
        <field name="member_type"/>
        <field name="current_issue_count"/>
        <field name="outstanding_fines"/>
        <field name="valid_until"/>
        <field name="member_state"/>
      </list>
    </field>
  </record>
  <record id="view_oacis_library_member_search" model="ir.ui.view">
    <field name="name">oacis.library.member.search</field>
    <field name="model">oacis.library.member</field>
    <field name="arch" type="xml">
      <search>
        <field name="member_id"/>
        <field name="display_name"/>
        <field name="student_id"/>
        <field name="faculty_member_id"/>
        <filter name="active" string="Active" domain="[('member_state','=','active')]"/>
        <filter name="has_books" string="Has Borrowed Books" domain="[('current_issue_count','&gt;',0)]"/>
        <filter name="has_fines" string="Has Outstanding Fines" domain="[('outstanding_fines','&gt;',0)]"/>
        <group name="group_by">
          <filter name="group_by_type" string="Member Type" context="{'group_by':'member_type'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="action_oacis_library_member" model="ir.actions.act_window">
    <field name="name">Library Members</field>
    <field name="res_model">oacis.library.member</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_active': 1}</field>
  </record>
</odoo>
