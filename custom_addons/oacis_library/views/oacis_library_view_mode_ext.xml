<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Expose the new kanban/calendar/pivot/graph/activity views through the
         view switcher on the existing actions. -->

    <record id="action_oacis_library_book" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form,pivot,graph,activity</field>
    </record>

    <record id="action_oacis_library_book_available" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,pivot,graph,activity</field>
    </record>

    <record id="action_oacis_library_issue" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
    </record>

    <record id="action_oacis_library_member" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
    </record>

    <record id="action_oacis_library_overdue" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
    </record>

    <record id="action_oacis_library_reservation" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,calendar</field>
    </record>

</odoo>
